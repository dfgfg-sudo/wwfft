      "type": "3",
      "data": {
        "name": "扫描工作流空间",
        "language": "python",
        "code": "import json\ndef main(space_action, config):\n    items = [\n        {\"id\": \"wf_001\", \"name\": \"工作流1\", \"category\": \"数据处理\", \"version\": \"v1\"},\n        {\"id\": \"wf_002\", \"name\": \"工作流2\", \"category\": \"AI生成\", \"version\": \"v2\"}\n    ]\n    return {\"items\": items, \"action\": space_action, \"config\": config}",
        "output_params": [
          {
            "name": "items",
            "type": "array"
          },
          {
            "name": "action",
            "type": "string"
          },
          {
            "name": "config",
            "type": "object"
          }
        ]
      }
    },
    {
      "id": "llm_node_classify",
      "type": "4",
      "data": {
        "name": "AI 智能分类与命名",
        "model": "doubao-pro-32k",
        "system_prompt": "你是工作流管理专家，根据功能给出标准分类与规范命名",
        "user_prompt": "待处理项：{{code_node_scan.items}}\\n操作：{{code_node_scan.action}}\\n输出 JSON：[{\"id\":\"...\",\"new_name\":\"...\",\"category\":\"...\"}]",
        "output_params": [
          {
            "name": "processed",
            "type": "array"
          }
        ]
      }
    },
    {
      "id": "code_node_apply",
      "type": "3",
      "data": {
        "name": "应用变更",
        "language": "python",
        "code": "import json\ndef main(processed, action):\n    applied = []\n    for item in processed:\n        applied.append({\n            \"id\": item.get(\"id\"),\n            \"action\": action,\n            \"new_name\": item.get(\"new_name\"),\n            \"category\": item.get(\"category\"),\n            \"status\": \"success\"\n        })\n    return {\"applied\": applied}",
        "output_params": [
          {
            "name": "applied",
            "type": "array"
          }
        ]
      }
    },
