      "id": "code_node_search",
      "type": "3",
      "data": {
        "name": "抖音搜索",
        "language": "python",
        "code": "import json\ndef main(keyword, count):\n    results = []\n    for i in range(int(count or 10)):\n        results.append({\n            \"index\": i + 1,\n            \"title\": f\"{keyword}相关视频{i + 1}\",\n            \"video_url\": f\"https://v.douyin.com/i{1000000 + i}/\",\n            \"author\": \"视频作者\",\n            \"likes\": 1000 + i * 500\n        })\n    return {\"keyword\": keyword, \"videos\": results}",
        "output_params": [
          {
            "name": "keyword",
            "type": "string"
          },
          {
            "name": "videos",
            "type": "array"
          }
        ]
      }
    },
    {
      "id": "end_node",
      "type": "2",
      "data": {
        "name": "结束",
        "output_params": [
          {
            "name": "video_list",
            "type": "array",
            "value": "{{code_node_search.videos}}"
          }
        ]
      }
    }
