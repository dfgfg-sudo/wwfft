        "code": "def main(knowledge):\n    result = {\n        \"documentId\": \"doc_\" + str(hash(knowledge))[:8],\n        \"fileName\": \"knowledge_doc.txt\",\n        \"fileUrl\": \"/knowledge/documents/\" + str(hash(knowledge))[:8] + \".txt\"\n    }\n    return result",
