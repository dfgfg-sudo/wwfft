        {"name": "error_message", "type": "string", "required": true, "description": "错误信息"}
      ],
      "output_params": [
        {"name": "fixed_code", "type": "string", "description": "修复后的代码"},
        {"name": "fix_summary", "type": "string", "description": "修复摘要"}
      ]
    },
    {
      "name": "fix_workflow_error",
      "description": "修复工作流配置错误",
      "input_params": [
        {"name": "workflow_json", "type": "string", "required": true, "description": "工作流JSON"},
        {"name": "error_type", "type": "string", "required": true, "description": "错误类型"}
      ],
      "output_params": [
        {"name": "fixed_json", "type": "string", "description": "修复后的JSON"},
        {"name": "validation_result", "type": "string", "description": "验证结果"}
