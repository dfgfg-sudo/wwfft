{
  "name": "Coze终极修复器",
  "description": "一体化解决插件开发和工作流错误的终极解决方案",
  "version": "1.0.0",
  "create_time": "2025-08-14 00:03:00",
  "update_time": "2026-07-27 12:00:00",
  "resource_id": "7538098881461125147",
  "original_name": "CozeUltimateFixer",
  "type": "plugin",
  "plugin_type": "云插件",
