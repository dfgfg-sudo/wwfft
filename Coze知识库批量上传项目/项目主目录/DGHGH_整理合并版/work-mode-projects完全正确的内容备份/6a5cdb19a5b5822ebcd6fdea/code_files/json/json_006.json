{
  "schema_version": "v1",
  "name": "全场景智能自动化超级中枢",
  "description": "端到端自动化插件生成系统+量子级优化算法",
  "version": "3.0.0",
  "openapi": "3.1.0",
  "info": {
    "title": "NeuroFactory Fusion API",
    "description": "超融合多模态AI训练系统 + Coze全场景智能自动化集成",
    "version": "8.0.0",
    "contact": {
      "name": "NeuroFactory Team",
      "email": "support@neurofactory.ai"
    }
  },
  "servers": [
    {
      "url": "https://api.neurofactory.ai/v1",
      "description": "生产服务器"
    },
    {
      "url": "https://staging.api.neurofactory.ai/v1",
      "description": "测试服务器"
    }
  ],
  "paths": {
    "/api/v1/ai-training": {
      "post": {
        "summary": "执行AI训练",
        "description": "启动多模态AI模型训练流程",
        "operationId": "executeAITraining",
        "parameters": [
          {
            "name": "data_path",
            "in": "query",
            "description": "数据路径",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "model_type",
            "in": "query",
            "description": "模型类型",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["gpt", "llama", "bert", "custom"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "训练启动成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "workflow_id": {
                      "type": "string"
                    },
                    "training_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/parameter-fixing": {
      "post": {
        "summary": "参数修复",
        "description": "自动修复API参数问题",
        "operationId": "fixParameters",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "parameters": {
                    "type": "object",
                    "description": "原始参数"
                  },
                  "api_spec": {
                    "type": "object",
                    "description": "API规范"
                  },
                  "fix_strategy": {
                    "type": "string",
                    "enum": ["auto", "conservative", "aggressive"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "参数修复成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "fixed_parameters": {
                      "type": "object"
                    },
                    "fixes_applied": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/openapi/generate": {
      "post": {
        "summary": "生成OpenAPI规范",
        "description": "根据端点信息生成OpenAPI规范",
        "operationId": "generateOpenAPI",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "endpoints": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "info": {
                    "type": "object"
                  },
                  "version": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "规范生成成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "spec": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "WorkflowType": {
        "type": "string",
        "enum": ["ai_training", "data_processing", "model_evaluation", "model_deployment", "system_monitoring", "parameter_fixing", "openapi_generation"]
      },
      "TrainingStatus": {
        "type": "string",
        "enum": ["pending", "running", "completed", "failed", "cancelled"]
      },
      "ParameterFixResult": {
        "type": "object",
        "properties": {
          "fixed": {
            "type": "boolean"
          },
          "value": {},
          "type": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "tags": [
    {
      "name": "AI Training",
      "description": "AI模型训练相关操作"
    },
    {
      "name": "Parameter Fixing",
      "description": "参数修复和验证"
    },
    {
      "name": "OpenAPI",
      "description": "OpenAPI规范管理"
    },
    {
      "name": "Workflow",
      "description": "工作流执行和管理"
    }
  ],
  "externalDocs": {
    "description": "完整文档",
    "url": "https://docs.neurofactory.ai"
  }
}