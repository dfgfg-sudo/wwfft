        "responses": {
          "201": {
            "description": "成功创建工作流",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Workflow" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/400Error" }
        },
        "security": [{ "BearerAuth": [] }]
      }
    },
