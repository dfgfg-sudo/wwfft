{
  "name": "思维脑图生成大师",
  "description": "给定链接地址或任何文本，比如课件、录音稿、文本、文章，直接总结成思维导图；生成的思维导图可以编辑",
  "version": "1.0.0",
  "create_time": "2024-12-29 01:05:00",
  "update_time": "2026-07-27 12:00:00",
  "nodes": [
    {
      "id": "start_node",
      "type": "1",
      "data": {
        "name": "开始",
        "input_params": [
          {
            "name": "content",
            "type": "string",
            "required": true,
            "description": "文本内容或URL链接"
          },
          {
            "name": "style",
            "type": "string",
            "required": false,
            "description": "思维导图风格：经典/树形/鱼骨/组织架构"
          }
        ]
      }
    },
    {
      "id": "code_node_detect",
      "type": "3",
      "data": {
        "name": "检测输入类型",
        "language": "python",
        "code": "def main(content):\n    if content.startswith('http://') or content.startswith('https://'):\n        input_type = 'url'\n        text = '从URL获取的内容...'\n    else:\n        input_type = 'text'\n        text = content\n    return {\"input_type\": input_type, \"text\": text[:5000]}",
        "output_params": [
          {"name": "input_type", "type": "string"},
          {"name": "text", "type": "string"}
        ]
      }
    },
    {
      "id": "llm_node_analyze",
      "type": "4",
      "data": {
        "name": "AI 提取关键结构",
        "model": "doubao-pro-32k",
        "system_prompt": "你是思维导图专家，从文本中提取层级结构",
        "user_prompt": "文本内容：{{code_node_detect.text}}\\n\\n请分析文本，提取关键主题和层级结构，输出JSON格式的思维导图数据：\\n{\"topic\":\"主题\",\"branches\":[{\"name\":\"分支1\",\"sub\":[\"子项1\",\"子项2\"]},{\"name\":\"分支2\",\"sub\":[\"子项3\"]}]}",
        "output_params": [{"name": "mindmap_structure", "type": "object"}]
      }
    },
    {
      "id": "llm_node_generate",
      "type": "4",
      "data": {
        "name": "AI 生成可编辑思维导图",
        "model": "doubao-pro-32k",
        "system_prompt": "你是思维导图渲染专家，生成可编辑的思维导图代码",
        "user_prompt": "结构：{{llm_node_analyze.mindmap_structure}}\\n风格：{{style || '经典'}}\\n\\n请生成可编辑的思维导图格式（支持 Markdown、Mermaid、JSON 等格式）",
        "output_params": [
          {"name": "mindmap_code", "type": "string"},
          {"name": "format", "type": "string"}
        ]
      }
    },
    {
      "id": "end_node",
      "type": "2",
      "data": {
        "name": "结束",
        "output_params": [
          {
            "name": "mindmap_structure",
            "type": "object",
            "value": "{{llm_node_analyze.mindmap_structure}}"
          },
          {
            "name": "mindmap_code",
            "type": "string",
            "value": "{{llm_node_generate.mindmap_code}}"
          },
          {
            "name": "format",
            "type": "string",
            "value": "{{llm_node_generate.format}}"
          }
        ]
      }
    }
  ],
  "edges": [
    {"sourceNodeID": "start_node", "targetNodeID": "code_node_detect"},
    {"sourceNodeID": "code_node_detect", "targetNodeID": "llm_node_analyze"},
    {"sourceNodeID": "llm_node_analyze", "targetNodeID": "llm_node_generate"},
    {"sourceNodeID": "llm_node_generate", "targetNodeID": "end_node"}
  ]
}