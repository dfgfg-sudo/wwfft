  "name_en": "Coze Super Plugin - All Nodes & Auto Fix",
  "version": "20.0.0",
  "description": "整合三个源文件全部功能的超级插件，支持30个模块、450+工具、全节点封装、自动诊断和修复常见问题（橘黄色叹号、参数错误、运行错误等）。完全免费使用，安全合规。",
  "description_en": "Complete integration of all source files with 30 modules, 450+ tools, full node encapsulation, auto-diagnosis and fix capabilities.",
  "author": "Universal Automation Team",
  "license": "MIT",
  "icon": "https://cdn-icons-png.flaticon.com/512/2103/2103633.png",
  "categories": [
    "business-logic",
    "database",
    "knowledge",
    "media",
    "component",
    "session",
    "security",
    "devops",
    "fix"
  ],
  "permissions": [
    "coze:workflow:read",
    "coze:workflow:write",
    "coze:knowledge:read",
    "coze:knowledge:write",
    "coze:bot:read",
    "coze:bot:write",
    "coze:plugin:read",
    "coze:plugin:write",
    "coze:agent:read",
    "coze:agent:write"
  ],
  "security": {
    "local_only": true,
    "zero_token_cost": true,
    "free_to_use": true,
    "no_sensitive_data": true,
    "no_external_services": true,
    "no_port_exposure": true
  },
  "auto_fix": {
