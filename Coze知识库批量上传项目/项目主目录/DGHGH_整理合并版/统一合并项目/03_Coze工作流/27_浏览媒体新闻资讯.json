        "name": "获取新闻",
        "language": "python",
        "code": "def main(category):\n    news = [\n        {\"title\": \"头条新闻1\", \"category\": category or \"综合\", \"summary\": \"新闻摘要...\", \"source\": \"新闻来源\"},\n        {\"title\": \"头条新闻2\", \"category\": category or \"综合\", \"summary\": \"新闻摘要...\", \"source\": \"新闻来源\"},\n        {\"title\": \"头条新闻3\", \"category\": category or \"综合\", \"summary\": \"新闻摘要...\", \"source\": \"新闻来源\"}\n    ]\n    return {\"category\": category or \"综合\", \"news_list\": news}",
        "output_params": [
          {"name": "category", "type": "string"},
          {"name": "news_list", "type": "array"}
        ]
      }
    },
    {
      "id": "end_node",
      "type": "2",
