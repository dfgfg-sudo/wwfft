{
  "project_name": "AutoMultiModal AI Training System",
  "project_version": "1.0.0",
  "author": "AMM-ATS Team",
  "data_dir": "./data",
  "train_split": "train",
  "val_split": "val",
  "test_split": "test",
  "image_size": 224,
  "batch_size": 32,
  "num_workers": 4,
  "max_text_length": 128,
  "text_model_name": "bert-base-uncased",
  "image_model_name": "resnet50",
  "hidden_size": 768,
  "num_classes": 10,
  "dropout_rate": 0.1,
  "pretrained": true,
  "freeze_text_encoder": false,
  "freeze_image_encoder": false,
  "learning_rate": 0.0001,
  "epochs": 100,
  "warmup_epochs": 5,
  "weight_decay": 0.0001,
  "gradient_accumulation_steps": 1,
  "max_grad_norm": 1.0,
  "optimizer_type": "adamw",
  "scheduler_type": "cosine",
  "checkpoint_dir": "./checkpoints",
  "output_dir": "./outputs",
  "log_dir": "./logs",
  "tensorboard_dir": "./runs",
  "experiment_name": "exp_001",
  "seed": 42,
  "device": "auto",
  "use_amp": true,
  "early_stopping_patience": 10,
  "save_best_only": true,
  "eval_strategy": "epoch",
  "logging_steps": 10,
  "save_steps": 100
}