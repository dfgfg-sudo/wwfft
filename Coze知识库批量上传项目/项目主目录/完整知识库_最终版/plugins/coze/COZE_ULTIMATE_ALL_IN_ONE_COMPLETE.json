              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "action": {"type": "string", "enum": ["workflow", "plugin", "json_fix", "code_fix", "ai_training", "neural_decision", "multimedia", "industry_analysis", "data_processing", "error_fix", "general", "deepseek", "smart_agent", "content_creation", "monetization", "devops", "openclaw", "security_compliance", "luoyang_heritage", "feishu", "universal"], "default": "universal"},
