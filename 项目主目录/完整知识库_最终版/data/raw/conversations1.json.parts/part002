ut_dirs:\n            if not os.path.isdir(input_dir):\n                print(f\"警告: 目录不存在: {input_dir}\")\n                continue\n            search_pattern = os.path.join(input_dir, \"**\", file_pattern)\n            files_in_dir = glob.glob(search_pattern, recursive=True)\n            all_files.extend(files_in_dir)\n        \n        if not all_files:\n            print(f\"在指定目录中未找到匹配 {file_pattern} 的文件\")\n            return False\n        \n        print(f\"找到 {len(all_files)} 个文件进行合并\")\n        \n        temp_pattern = \"temp_merge_list.txt\"\n        with open(temp_pattern, 'w', encoding='utf-8') as f:\n            for file_path in all_files:\n                f.write(file_path + '\\n')\n        \n        success = self.merge_files(temp_pattern, output_path, options)\n        \n        if os.path.exists(temp_pattern):\n            os.remove(temp_pattern)\n        \n        return success\n    \n    def batch_process(self, config_file):\n        \"\"\"批量处理配置文件\"\"\"\n        try:\n            with open(config_file, 'r', encoding='utf-8') as f:\n                config_content = f.read()\n            \n            config_lines = config_content.split('\\n')\n            for line in config_lines:\n                line = line.strip()\n                if not line or line.startswith('#'):\n                    continue\n                \n                parts = line.split('|')\n                if len(parts) >= 2:\n                    operation = parts[0].strip()\n                    params = parts[1].strip()\n                    \n                    if operation == 'process_file':\n                        file_parts = params.split('->')\n                        if len(file_parts) == 2:\n                            input_file = file_parts[0].strip()\n                            output_file = file_parts[1].strip()\n                            options = self._parse_options(parts[2] if len(parts) > 2 else \"\")\n                            self.process_single_file(input_file, output_file, options)\n                    \n                    elif operation == 'process_dir':\n                        dir_parts = params.split('->')\n                        if len(dir_parts) == 2:\n                            input_dir = dir_parts[0].strip()\n                            output_dir = dir_parts[1].strip()\n                            pattern = parts[2].strip() if len(parts) > 2 else \"*.txt\"\n                            options = self._parse_options(parts[3] if len(parts) > 3 else \"\")\n                            self.process_directory(input_dir, output_dir, pattern, options)\n                    \n                    elif operation == 'merge_files':\n                        merge_parts = params.split('->')\n                        if len(merge_parts) == 2:\n                            pattern = merge_parts[0].strip()\n                            output_file = merge_parts[1].strip()\n                            options = self._parse_options(parts[2] if len(parts) > 2 else \"\")\n                            self.merge_files(pattern, output_file, options)\n            \n            return True\n        except Exception as e:\n            print(f\"批量处理配置文件时出错: {e}\")\n            return False\n    \n    def _parse_options(self, options_str):\n        \"\"\"解析选项字符串\"\"\"\n        options = {}\n        if not options_str:\n            return options\n        \n        option_pairs = options_str.split(',')\n        for pair in option_pairs:\n            if '=' in pair:\n                key, value = pair.split('=', 1)\n                key = key.strip()\n                value = value.strip()\n                \n                if value.lower() in ('true', 'yes', '1'):\n                    options[key] = True\n                elif value.lower() in ('false', 'no', '0'):\n                    options[key] = False\n                else:\n                    options[key] = value\n        \n        return options\n    \n    def print_stats(self):\n        \"\"\"打印处理统计信息\"\"\"\n        print(\"\\n\" + \"=\"*60)\n        print(\"📊 处理统计信息:\")\n        print(\"=\"*60)\n        print(f\"📁 处理的文件数量: {self.stats['files_processed']}\")\n        print(f\"🔄 合并的文件数量: {self.stats['files_merged']}\")\n        print(f\"📝 处理的总行数: {self.stats['total_lines']}\")\n        print(f\"❌ 移除的空行数: {self.stats['empty_lines_removed']}\")\n        print(f\"♻️  移除的重复行数: {self.stats['duplicate_lines_removed']}\")\n        print(\"=\"*60)\n\ndef create_parser():\n    \"\"\"创建命令行参数解析器\"\"\"\n    parser = argparse.ArgumentParser(\n        description='文本内容整理与合并工具 - TextContentManager Pro',\n        formatter_class=argparse.RawDescriptionHelpFormatter,\n        epilog=\"\"\"\n使用示例:\n  python text_processor.py process -i input.txt -o output.txt --dedup --line-numbers\n  python text_processor.py tree -i /path/to/directory -o /path/to/output --pattern \"*.txt\"\n  python text_processor.py merge -i \"*.txt\" -o merged.txt --no-header\n  python text_processor.py batch -i config.txt\n        \"\"\"\n    )\n    \n    parser.add_argument('mode', choices=['process', 'merge', 'tree', 'batch'], \n                       help='操作模式: process(处理文件), merge(合并文件), tree(处理目录树), batch(批量处理)')\n    \n    parser.add_argument('-i', '--input', required=True, \n                       help='输入文件/目录/模式/配置文件')\n    \n    parser.add_argument('-o', '--output', \n                       help='输出文件/目录路径')\n    \n    parser.add_argument('-p', '--pattern', default='*.txt',\n                       help='文件匹配模式 (默认: *.txt)')\n    \n    parser.add_argument('--no-normalize', action='store_true',\n                       help='不统一换行符')\n    \n    parser.add_argument('--no-spaces', action='store_true',\n                       help='不去除多余空格')\n    \n    parser.add_argument('--no-empty', action='store_true',\n                       help='不去除空行')\n    \n    parser.add_argument('--dedup', action='store_true',\n                       help='去除重复行')\n    \n    parser.add_argument('--sort', action='store_true',\n                       help='按字母顺序排序行')\n    \n    parser.add_argument('--reverse', action='store_true',\n                       help='倒序排序 (需与--sort一起使用)')\n    \n    parser.add_argument('--line-numbers', action='store_true',\n                       help='添加行号')\n    \n    parser.add_argument('--trim', action='store_true',\n                       help='去除每行首尾空白')\n    \n    parser.add_argument('--no-header', action='store_true',\n                       help='不添加文件头 (合并模式)')\n    \n    parser.add_argument('--no-separators', action='store_true',\n                       help='不添加文件分隔符 (合并模式)')\n    \n    parser.add_argument('--verbose', action='store_true',\n                       help='详细输出模式')\n    \n    return parser\n\ndef get_options_from_user(merge_mode=False):\n    \"\"\"从用户获取处理选项\"\"\"\n    print(\"\\n请选择处理选项 (输入y/n):\")\n    options = {\n        'normalize_line_breaks': input(\"统一换行符 (y/n, 默认y): \").strip().lower() != 'n',\n        'remove_extra_spaces': input(\"去除多余空格 (y/n, 默认y): \").strip().lower() != 'n',\n        'remove_empty_lines': input(\"去除空行 (y/n, 默认y): \").strip().lower() != 'n',\n        'remove_duplicate_lines': input(\"去除重复行 (y/n, 默认n): \").strip().lower() == 'y',\n        'sort_lines': input(\"按字母顺序排序行 (y/n, 默认n): \").strip().lower() == 'y',\n        'sort_reverse': False,\n        'add_line_numbers': input(\"添加行号 (y/n, 默认n): \").strip().lower() == 'y',\n        'trim_lines': input(\"去除每行首尾空白 (y/n, 默认n): \").strip().lower() == 'y'\n    }\n    \n    if merge_mode:\n        options['add_header'] = input(\"添加文件头信息 (y/n, 默认y): \").strip().lower() != 'n'\n        options['add_separators'] = input(\"添加文件分隔符 (y/n, 默认y): \").strip().lower() != 'n'\n    \n    if options['sort_lines']:\n        reverse_choice = input(\"倒序排序? (y/n, 默认n): \").strip().lower()\n        options['sort_reverse'] = reverse_choice == 'y'\n    \n    return options\n\ndef main():\n    \"\"\"主函数 - 支持命令行参数和交互式使用\"\"\"\n    parser = create_parser()\n    \n    if len(sys.argv) > 1:\n        args = parser.parse_args()\n        processor = TextProcessor()\n        \n        options = {\n            'normalize_line_breaks': not args.no_normalize,\n            'remove_extra_spaces': not args.no_spaces,\n            'remove_empty_lines': not args.no_empty,\n            'remove_duplicate_lines': args.dedup,\n            'sort_lines': args.sort,\n            'sort_reverse': args.reverse,\n            'add_line_numbers': args.line_numbers,\n            'trim_lines': args.trim,\n            'add_header': not args.no_header,\n            'add_separators': not args.no_separators\n        }\n        \n        try:\n            if args.mode == 'process':\n                if not os.path.exists(args.input):\n                    print(f\"错误: 文件不存在: {args.input}\")\n                    return\n                processor.process_single_file(args.input, args.output, options)\n                \n            elif args.mode == 'merge':\n                processor.merge_files(args.input, args.output, options)\n                \n            elif args.mode == 'tree':\n                if not os.path.isdir(args.input):\n                    print(f\"错误: 目录不存在: {args.input}\")\n                    return\n                processor.process_directory(args.input, args.output, args.pattern, options)\n                \n            elif args.mode == 'batch':\n                if not os.path.exists(args.input):\n                    print(f\"错误: 配置文件不存在: {args.input}\")\n                    return\n                processor.batch_process(args.input)\n            \n            processor.print_stats()\n            \n        except Exception as e:\n            print(f\"处理过程中出错: {e}\")\n            if args.verbose:\n                import traceback\n                traceback.print_exc()\n    \n    else:\n        processor = TextProcessor()\n        \n        print(\"=\"*60)\n        print(\"📝 文本内容整理与合并工具 - TextContentManager Pro\")\n        print(\"=\"*60)\n        \n        while True:\n            print(\"\\n请选择操作模式:\")\n            print(\"1. 处理单个文件\")\n            print(\"2. 处理整个目录\")\n            print(\"3. 合并多个文件\")\n            print(\"4. 合并多个目录\")\n            print(\"5. 批量处理\")\n            print(\"6. 退出\")\n            \n            choice = input(\"请输入选择 (1-6): \").strip()\n            \n            if choice == '1':\n                input_file = input(\"请输入要处理的文件路径: \").strip()\n                if not os.path.exists(input_file):\n                    print(\"文件不存在!\")\n                    continue\n                \n                output_file = input(\"请输入输出文件路径 (留空则自动生成): \").strip()\n                if not output_file:\n                    output_file = None\n                \n                options = get_options_from_user()\n                processor.process_single_file(input_file, output_file, options)\n                processor.print_stats()\n                \n            elif choice == '2':\n                input_dir = input(\"请输入要处理的目录路径: \").strip()\n                if not os.path.isdir(input_dir):\n                    print(\"目录不存在!\")\n                    continue\n                \n                output_dir = input(\"请输入输出目录路径 (留空则自动生成): \").strip()\n                if not output_dir:\n                    output_dir = None\n                \n                file_pattern = input(\"请输入文件匹配模式 (默认: *.txt): \").strip()\n                if not file_pattern:\n                    file_pattern = \"*.txt\"\n                \n                options = get_options_from_user()\n                processor.process_directory(input_dir, output_dir, file_pattern, options)\n                processor.print_stats()\n                \n            elif choice == '3':\n                file_pattern = input(\"请输入文件匹配模式 (例如: *.txt): \").strip()\n                output_file = input(\"请输入合并后的输出文件路径: \").strip()\n                \n                options = get_options_from_user(merge_mode=True)\n                processor.merge_files(file_pattern, output_file, options)\n                processor.print_stats()\n                \n            elif choice == '4':\n                input_dirs = input(\"请输入要合并的目录路径 (多个目录用逗号分隔): \").strip()\n                dir_list = [d.strip() for d in input_dirs.split(',')]\n                \n                valid_dirs = []\n                for d in dir_list:\n                    if os.path.isdir(d):\n                        valid_dirs.append(d)\n                    else:\n                        print(f\"警告: 目录不存在: {d}\")\n                \n                if not valid_dirs:\n                    print(\"没有有效的目录!\")\n                    continue\n                \n                output_file = input(\"请输入合并后的输出文件路径: \").strip()\n                file_pattern = input(\"请输入文件匹配模式 (默认: *.txt): \").strip()\n                if not file_pattern:\n                    file_pattern = \"*.txt\"\n                \n                options = get_options_from_user(merge_mode=True)\n                processor.merge_directories(valid_dirs, output_file, file_pattern, options)\n                processor.print_stats()\n                \n            elif choice == '5':\n                config_file = input(\"请输入配置文件路径: \").strip()\n                if not os.path.exists(config_file):\n                    print(\"配置文件不存在!\")\n                    continue\n                \n                processor.batch_process(config_file)\n                processor.print_stats()\n                \n            elif choice == '6':\n                print(\"感谢使用 TextContentManager Pro!\")\n                break\n            \n            else:\n                print(\"无效选择，请重新输入!\")\n\nif __name__ == \"__main__\":\n    main()\n```\n\n系统架构图 (Mermaid)\n\n```mermaid\ngraph TD\n    A[TextContentManager Pro] --> B[核心处理器]\n    A --> C[文件操作器]\n    A --> D[内容处理器]\n    A --> E[批量处理器]\n    \n    B --> F[TextProcessor类]\n    F --> G[初始化系统]\n    F --> H[处理统计]\n    \n    C --> I[文件读取]\n    C --> J[文件写入]\n    C --> K[目录遍历]\n 