nput): Promise<WorkflowOutput> {\n    const startTime = Date.now();\n    const executionId = this.generateExecutionId();\n    \n    try {\n      const workflow = this.workflowRegistry.get(workflowId);\n      if (!workflow) {\n        throw new Error(`工作流不存在: ${workflowId}`);\n      }\n      \n      // 检查缓存\n      const cacheKey = this.generateCacheKey(workflowId, input);\n      const cachedResult = await this.cacheManager.get(cacheKey);\n      if (cachedResult) {\n        return cachedResult;\n      }\n      \n      // 执行工作流\n      const context: ExecutionContext = {\n        executionId,\n        workflowId,\n        input,\n        startTime,\n        variables: new Map()\n      };\n      \n      const result = await this.executeNode(workflow.startNode, context);\n      \n      // 缓存结果\n      await this.cacheManager.set(cacheKey, result, workflow.cacheTtl);\n      \n      // 记录执行历史\n      this.recordExecution({\n        executionId,\n        workflowId,\n        input,\n        output: result,\n        duration: Date.now() - startTime,\n        status: 'success'\n      });\n      \n      return result;\n      \n    } catch (error) {\n      // 记录失败执行\n      this.recordExecution({\n        executionId,\n        workflowId,\n        input,\n        error: error.message,\n        duration: Date.now() - startTime,\n        status: 'failed'\n      });\n      \n      throw error;\n    }\n  }\n  \n  /**\n   * 执行单个节点\n   */\n  private async executeNode(node: WorkflowNode, context: ExecutionContext): Promise<any> {\n    switch (node.type) {\n      case 'start':\n        return await this.executeStartNode(node, context);\n      case 'llm':\n        return await this.executeLLMNode(node, context);\n      case 'code':\n        return await this.executeCodeNode(node, context);\n      case 'condition':\n        return await this.executeConditionNode(node, context);\n      case 'end':\n        return await this.executeEndNode(node, context);\n      default:\n        throw new Err