tion\": {\n        \"产品\": \"Aionix 全栈 AI 员工编排系统\",\n        \"功能\": \"智能体工厂、技能市场、私有知识库、200+ SaaS 连接、监控面板\",\n        \"技术栈\": \"Python/FastAPI + React + LangChain + Qdrant\",\n        \"模式\": \"开源核心 + 企业订阅\"\n    },\n    \"ai_agent_innovations\": [\n        \"多人格辩论智能体\",\n        \"自我进化 Agent (在线 RLHF)\",\n        \"数字孪生城市运营 Agent\",\n        \"虚拟主播自动带货 Agent\",\n        \"AI 原生游戏 NPC\"\n    ],\n}\n\n# ──────────────────────────────────────────────\n# 工作流修复引擎\n# ──────────────────────────────────────────────\nclass WorkflowFixer:\n    @staticmethod\n    def extract_id_from_url(url: str) -> Optional[str]:\n        match = re.search(r\"/workflow/([\\w-]+)\", url)\n        return match.group(1) if match else None\n\n    @staticmethod\n    def diagnose(workflow: dict) -> List[str]:\n        issues = []\n        if not isinstance(workflow, dict):\n            return [\"WORKFLOW_INVALID_JSON\"]\n        nodes = workflow.get(\"nodes\", [])\n        edges = workflow.get(\"edges\", [])\n        if not any(n.get(\"type\") == \"trigger\" for n in nodes):\n            issues.append(\"WORKFLOW_MISSING_TRIGGER\")\n        node_ids = {n.get(\"id\") for n in nodes if n.get(\"id\")}\n        for i, node in enumerate(nodes):\n            if not node.get(\"id\"):\n                issues.append(f\"WORKFLOW_MISSING_NODE_ID at index {i}\")\n            if node.get(\"type\") not in (None, \"trigger\", \"llm\", \"code\", \"http\", \"condition\", \"loop\", \"output\", \"knowledge\", \"variable\"):\n                issues.append(f\"WORKFLOW_NODE_TYPE_UNKNOWN: {node.get('id','?')}\")\n        for e in edges:\n            if e.get(\"source\") not in node_ids or e.get(\"target\") not in node_ids:\n                issues.append(\"WORKFLOW_INVALID_CONNECTION\")\n        for node in nodes:\n            if node.get(\"type\") == \"loop\":\n                max_iter = node.get(\"config\", {}).get(\"max_iterations\", 0)\n                if not (1 <= max_iter <= 100):\n                    issues.append(\"WORKFLOW_LOOP_BOUNDS_ERROR\")\n        return issues\n\n    @staticmethod\n    def safe_fix(workflow: dict) -> dict:\n        import copy\n        wf = copy.deepcopy(workflow)\n        nodes = wf.setdefault(\"nodes\", [])\n        edges = wf.setdefault(\"edges\", [])\n        # 补充节点 id\n        for i, node in enumerate(nodes):\n            if \"id\" not in node:\n                node[\"id\"] = f\"auto_node_{i}\"\n        # 清理节点名称\n        for node in nodes:\n            if \"name\" in node:\n                node[\"name\"] = re.sub(r'[^a-zA-Z0-9_-]', '_', node[\"name\"])\n        # 限制循环次数\n        for node in nodes:\n            if node.get(\"type\") == \"loop\":\n                cfg = node.setdefault(\"config\", {})\n                old = cfg.get(\"max_iterations\", 10)\n                cfg[\"max_iterations\"] = max(1, min(old, 100))\n                if cfg[\"max_iterations\"] != old:\n                    pass\n        # 移除无效连接\n        ids = {n.get(\"id\") for n in nodes}\n        wf[\"edges\"] = [e for e in edges if e.get(\"source\") in ids and e.get(\"target\") in ids]\n        # 无触发器则补一个\n        if not any(n.get(\"type\") == \"trigger\" for n in nodes):\n            nodes.insert(0, {\"id\": \"trigger_auto\", \"type\": \"trigger\", \"name\": \"Auto Trigger\", \"config\": {}})\n        return wf\n\n    @staticmethod\n    def generate_report(original: dict, fixed: dict, issues: list, log: list) -> dict:\n        return {\n            \"timestamp\": datetime.now(timezone.utc).isoformat(),\n            \"issues_found\": issues,\n            \"fixes_applied\": log,\n            \"original_nodes\": len(original.get(\"nodes\", [])),\n            \"fixed_nodes\": len(fixed.get(\"nodes\", [])),\n            \"fixed_workflow\": fixed if issues or log else None\n        }\n\n# ────────────────────────────\n# 轻量工具函数\n# ────────────────────────────\ndef error(msg): return json.dumps({\"error\": msg}, ensure_ascii=False)\ndef success(data): return json.dumps(data, ensure_ascii=False, indent=2)\n\ndef bot_restore(config: dict) -> dict:\n    if \"mode\" not in config or config[\"mode\"] not in (\"workflow\", \"single_agent\"):\n        config[\"mode\"] = \"workflow\"\n    if \"prompt\" not in config:\n        config[\"prompt\"] = \"You are a helpful assistant.\"\n    return config\n\ndef knowledge_segment(text: str, chunk_size: int = 500) -> list:\n    return [text[i:i+chunk_size] for i in range(0, len(text), chunk_size)]\n\ndef card_completion(card: dict) -> dict:\n    defaults = {\"title\": \"未命名\", \"description\": \"暂无描述\", \"image\": \"\", \"action_url\": \"\"}\n    return {**defaults, **card}\n\ndef text_stats(text: str) -> dict:\n    return {\"chars\": len(text), \"words\": len(text.split()), \"lines\": len(text.splitlines())}\n\ndef date_diff(d1_str: str, d2_str: str) -> int:\n    from datetime import datetime\n    d1 = datetime.strptime(d1_str, \"%Y-%m-%d\")\n    d2 = datetime.strptime(d2_str, \"%Y-%m-%d\")\n    return (d2 - d1).days\n\ndef safe_eval(expr: str) -> Any:\n    return eval(expr, {\"__builtins__\": None}, {})\n\ndef logic_eval(expr: str) -> bool:\n    return bool(safe_eval(expr))\n\n# ────────────────────────────\n# 模式处理函数 (每个返回JSON字符串)\n# ────────────────────────────\ndef auto_fix_workflow(user_input: str) -> str:\n    try:\n        wf = json.loads(user_input)\n    except:\n        return error(\"无效 JSON\")\n    fixer = WorkflowFixer()\n    issues = fixer.diagnose(wf)\n    fixed = fixer.safe_fix(wf)\n    log = []\n    report = fixer.generate_report(wf, fixed, issues, log)\n    return success(report)\n\ndef diagnose_workflow(user_input: str) -> str:\n    try:\n        wf = json.loads(user_input)\n    except:\n        return error(\"无效 JSON\")\n    return success({\"issues\": WorkflowFixer.diagnose(wf)})\n\ndef extract_id(user_input: str) -> str:\n    wid = WorkflowFixer.extract_id_from_url(user_input)\n    return success({\"workflow_id\": wid}) if wid else error(\"未找到ID\")\n\ndef bot_restore_mode(user_input: str) -> str:\n    try:\n        cfg = json.loads(user_input)\n    except:\n        return error(\"无效 JSON\")\n    return success(bot_restore(cfg))\n\ndef knowledge_segment_mode(user_input: str, param1: str = \"500\") -> str:\n    try:\n        size = int(param1)\n    except:\n        size = 500\n    return success({\"chunks\": knowledge_segment(user_input, size)})\n\ndef card_completion_mode(user_input: str) -> str:\n    try:\n        card = json.loads(user_input)\n    except:\n        return error(\"无效 JSON\")\n    return success(card_completion(card))\n\ndef text_stats_mode(user_input: str) -> str:\n    return success(text_stats(user_input))\n\ndef date_diff_mode(user_input: str, param1: str) -> str:\n    if not user_input or not param1:\n        return error(\"需要两个日期\")\n    try:\n        days = date_diff(user_input, param1)\n        return success({\"days\": days})\n    except:\n        return error(\"日期格式错误，应为 YYYY-MM-DD\")\n\ndef array_eval_mode(user_input: str) -> str:\n    try:\n        val = safe_eval(user_input)\n        return success({\"result\": val})\n    except Exception as e:\n        return error(str(e))\n\ndef logic_eval_mode(user_input: str) -> str:\n    try:\n        res = logic_eval(user_input)\n        return success({\"result\": res})\n    except Exception as e:\n        return error(str(e))\n\ndef coze_safe_prompt(user_input: str) -> str:\n    return success({\"safe_prompt\": \"你是一个安全的自动化助手，必须遵守输入过滤、循环限制、无eval...\"})\n\ndef agent_migration_guide(user_input: str) -> str:\n    return success({\"guide\": \"1.导出原配置 2.Coze新建工作流 3.迁移Prompt 4.工具替换为插件...\"})\n\ndef douyin_extraction(user_input: str) -> str:\n    return success({\"guide\": \"文案提取：小程序或playwright抓取；批量下载：作者主页+aria2；注意版权\"})\n\ndef ollama_batch_douyin(user_input: str) -> str:\n    lines = [l.strip() for l in user_input.split(\"\\n\") if l.strip()]\n    if not lines:\n        return error(\"请提供每行一条文案\")\n    script = f\"prompts = {json.dumps(lines)}\\nfor p in prompts:\\n   # 调用ollama\\n\"\n    