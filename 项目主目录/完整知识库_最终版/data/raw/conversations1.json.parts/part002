de\": \"function fixParams(input) {\\n  const fixes = [];\\n  const output = {...input};\\n  \\n  // 1. 自动修剪+清理特殊字符\\n  if (output.user_demand) {\\n    const orig = output.user_demand;\\n    output.user_demand = output.user_demand\\n      .trim()\\n      .replace(/[<>{}]/g, '')\\n      .substring(0, 3000);\\n    \\n    if (orig !== output.user_demand) {\\n      fixes.push({field: 'user_demand', action: 'sanitized'});\\n    }\\n  } else {\\n    output.user_demand = \\\"请描述您需要的插件功能\\\";\\n    fixes.push({field: 'user_demand', action: 'set_default_value'});\\n  }\\n  \\n  // 2. 节点存在性验证\\n  const validNodes = ['end', 'plugin_gen', 'executor', 'node_scanner', 'repair_engine'];\\n  if (output.trigger_node_id && output.trigger_node_id !== 'end' && \\n      !validNodes.includes(output.trigger_node_id)) {\\n    fixes.push({field: 'trigger_node_id', action: 'set_to_end'});\\n    output.trigger_node_id = 'end';\\n  } else if (!output.trigger_node_id) {\\n    output.trigger_node_id = 'end';\\n    fixes.push({field: 'trigger_node_id', action: 'set_default_end'});\\n  }\\n  \\n  // 3. 枚举值修正\\n  const validRepairLevels = ['basic', 'advanced', 'full'];\\n  if (output.auto_repair_level && !validRepairLevels.includes(output.auto_repair_level)) {\\n    // 同义词映射\\n    const synonymMap = {\\n      '基础': 'basic', '简易': 'basic', '简单': 'basic',\\n      '高级': 'advanced', '进阶': 'advanced', '增强': 'advanced',\\n      '完全': 'full', '完整': 'full', '全面': 'full'\\n    };\\n    \\n    if (synonymMap[output.auto_repair_level]) {\\n      output.auto_repair_level = synonymMap[output.auto_repair_level];\\n      fixes.push({field: 'auto_repair_level', action: 'synonym_mapped'});\\n    } else {\\n      output.auto_repair_level = 'full';\\n      fixes.push({field: 'auto_repair_level', action: 'set_to_full'});\\n    }\\n  } else if (!output.auto_repair_level) {\\n    output.auto_repair_level = 'full';\\n    fixes.push({field: 'auto_repair_level', action: 'set_default_full'});\\n  }\\n  \\n  // 4. 生成workflow_id\\n  if (!output.workflow_id || !/^[a-zA-Z0-9_-]{1,100}$/.test(output.workflow_id)) {\\n    const timestamp = Date.now().toString(36);\\n    const randomStr = Math.random().toString(36).substring(2, 8);\\n    output.workflow_id = `auto_${timestamp}_${randomStr}`;\\n    fixes.push({field: 'workflow_id', action: 'auto_generated'});\\n  }\\n  \\n  // 5. 输出格式验证\\n  const validFormats = ['json', 'html', 'yaml'];\\n  if (output.output_format && !validFormats.includes(output.output_format)) {\\n    output.output_format = 'json';\\n    fixes.push({field: 'output_format', action: 'set_to_json'});\\n  } else if (!output.output_format) {\\n    output.output_format = 'json';\\n    fixes.push({field: 'output_format', action: 'set_default_json'});\\n  }\\n  \\n  // 6. 超时时间验证\\n  if (output.timeout_ms) {\\n    if (output.timeout_ms < 1000) {\\n      fixes.push({field: 'timeout_ms', action: 'clamp_min_1000'});\\n      output.timeout_ms = 1000;\\n    } else if (output.timeout_ms > 300000) {\\n      fixes.push({field: 'timeout_ms', action: 'clamp_max_300000'});\\n      output.timeout_ms = 300000;\\n    }\\n  } else {\\n    output.timeout_ms = 60000;\\n    fixes.push({field: 'timeout_ms', action: 'set_default_60000'});\\n  }\\n  \\n  return { fixed_input: output, fixes };\\n}\",\n            \"input_schema\": {\n              \"$ref\": \"#/components/schemas/OmniAutoRequest\"\n            },\n            \"output_schema\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"fixed_input\": {\n                  \"$ref\": \"#/components/schemas/OmniAutoRequest\"\n                },\n                \"fixes\": {\n                  \"type\": \"array\",\n                  \"items\": {\n                    \"type\": \"object\",\n                    \"properties\": {\n                      \"field\": {\n                        \"type\": \"string\"\n                      },\n                      \"action\": {\n                        \"type\": \"string\"\n                      },\n                      \"original_value\": {\n                        \"type\": [\"string\", \"number\", \"boolean\", \"null\"]\n                      },\n                      \"new_value\": {\n                        \"type\": [\"string\", \"number\", \"boolean\", \"null\"]\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        {\n          \"id\": \"node_health_scanner\",\n          \"type\": \"code\",\n          \"name\": \"全节点健康扫描仪\",\n          \"description\": \"自动检测工作流中所有节点的配置、逻辑和依赖错误\",\n          \"config\": {\n            \"runtime\": \"nodejs18.x\",\n            \"timeout\": 45000,\n            \"code\": \"function scanNodes(workflow) {\\n  const report = {\\n    total: workflow.nodes.length,\\n    errors: [],\\n    warnings: []\\n  };\\n  \\n  // 1. 检测节点配置错误\\n  workflow.nodes.forEach(node => {\\n    const errors = [];\\n    const warnings = [];\\n    \\n    // ID和类型检查\\n    if (!node.id) {\\n      errors.push({ type: 'config', detail: '节点ID缺失', severity: 'high' });\\n    }\\n    \\n    if (!node.type) {\\n      errors.push({ type: 'config', detail: '节点类型缺失', severity: 'high' });\\n    }\\n    \\n    // 插件节点检测\\n    if (node.type === 'plugin') {\\n      if (!node.config?.plugin_id) {\\n        errors.push({ type: 'config', detail: 'plugin_id缺失', severity: 'high' });\\n      }\\n      if (node.config.params && typeof node.config.params !== 'object') {\\n        errors.push({ type: 'config', detail: 'params必须为object', severity: 'medium' });\\n      }\\n      if (!node.config?.version) {\\n        warnings.push({ type: 'config', detail: '建议指定插件版本', severity: 'low' });\\n      }\\n    }\\n    \\n    // LLM节点检测\\n    if (node.type === 'llm') {\\n      if (!node.config?.model) {\\n        errors.push({ type: 'config', detail: '模型未指定', severity: 'high' });\\n      } else if (node.config.model !== 'coze-ultra') {\\n        warnings.push({ type: 'config', detail: '建议使用coze-ultra模型获得最佳性能', severity: 'low' });\\n      }\\n      \\n      if (!node.config?.prompt) {\\n        errors.push({ type: 'config', detail: '提示词未设置', severity: 'high' });\\n      }\\n    }\\n    \\n    // 代码节点检测\\n    if (node.type === 'code' && node.config?.code) {\\n      // 语法和逻辑错误检测\\n      const code = node.config.code;\\n      if (code.includes('undefined') || code.includes('null.')) {\\n        errors.push({ type: 'logic', detail: '代码存在未定义引用', severity: 'high' });\\n      }\\n      \\n      if (code.includes('eval(') || code.includes('Function(')) {\\n        warnings.push({ type: 'security', detail: '代码中包含可能不安全的动态执行', severity: 'medium' });\\n      }\\n      \\n      if (code.length > 10000) {\\n        warnings.push({ type: 'performance', detail: '代码过长可能影响性能', severity: 'low' });\\n      }\\n    }\\n    \\n    // 输入输出schema检查\\n    if (node.config?.input_schema && typeof node.config.input_schema !== 'object') {\\n      errors.push({ type: 'config', detail: 'input_schema格式错误', severity: 'medium' });\\n    }\\n    \\n    if (node.config?.output_schema && typeof node.config.output_schema !== 'object') {\\n      errors.push({ type: 'config', detail: 'output_schema格式错误', severity: 'medium' });\\n    }\\n    \\n    if (errors.length > 0 || warnings.length > 0) {\\n      report.errors.push({\\n        node_id: node.id || 'unknown',\\n        node_type: node.type,\\n        errors: errors,\\n        warnings: warnings\\n      });\\n    }\\n  });\\n  \\n  // 2. 检测连接错误\\n  workflow.connections.forEach(conn => {\\n    const sourceExists = workflow.nodes.some(n => n.id === conn.source);\\n    const targetExists = workflow.nodes.some(n => n.id === conn.target);\\n    \\n    if (!sourceExists || !targetExists) {\\n      report.errors.push({\\n        node_id: 'connection',\\n        node_type: 'connection',\\n        errors: [{\\n          type: 'dependency',\\n          detail: `连接错误: ${!sourceExists ? '源节点' : '目标节点'}${!sourceExists ? conn.source : conn.target}不存在`,\\n          severity: 'high'\\n        }],\\n        warnings: []\\n      });\\n    }\\n    \\n    // 检查连接条件\\n    if (conn.condition && typeof conn.condition !== 'string') {\\n      report.errors.push({\\n        node_id: 'connection',\\n        node_type: 'connection',\\n        errors: [{\\n          type: 'config',\\n          detail: '连接条件必须是字符串',\\n          severity: 'medium'\\n        }],\\n        warnings: []\\n      });\\n    }\\n  });\\n  \\n  // 3. 检查全局配置\\n  if (!workflow.name) {\\n    report.errors.push({\\n      node_id: 'global',\\n      node_type: 'config',\\n      errors: [{\\n        type: 'config',\\n        detail: '工作流名称缺失',\\n        severity: 'medium'\\n      }],\\n      warnings: []\\n    });\\n  }\\n  \\n  report.error_count = report.errors.reduce((count, errorNode) => count + errorNode.errors.length, 0);\\n  report.warning_count = report.errors.reduce((count, errorNode) => count + errorNode.warnings.length, 0);\\n  \\n  return report;\\n}\",\n            \"input_schema\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"workflow\": {\n                  \"type\": \"object\",\n                  \"description\": \"工作流定义对象\"\n                }\n              }\n            },\n            \"output_schema\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"total\": {\n                  \"type\": \"integer\",\n                  \"description\": \"总节点数\"\n                },\n                \"error_count\": {\n                  \"type\": \"integer\",\n                  \"description\": \"错误数量\"\n                },\n                \"warning_count\": {\n                  \"type\": \"integer\",\n                  \"description\": \"警告数量\"\n                },\n                \"errors\": {\n                  \"type\": \"array\",\n                  \"items\": {\n                    \"type\": \"object\",\n                    \"properties\": {\n                      \"node_id\": {\n                        \"type\": \"string\"\n                      },\n                      \"node_type\": {\n                        \"type\": \"string\"\n                      },\n                      \"errors\": {\n                        \"type\": \"array\",\n                        \"items\": {\n                          \"type\": \"object\",\n                          \"properties\": {\n                            \"type\": {\n                              \"type\": \"string\"\n                            },\n                            \"detail\": {\n                              \"type\": \"string\"\n                            },\n                            \"severity\": {\n                              \"type\": \"string\",\n                              \"enum\": [\"high\", \"medium\", \"low\"]\n                            }\n                          }\n                        }\n                      },\n                      \"warnings\": {\n                        \"type\": \"array\",\n                        \"items\": {\n                          \"type\": \"object\",\n                          \"properties\": {\n                            \"type\": {\n                              \"type\": \"string\"\n                            },\n                            \"detail\": {\n                              \"type\": \"string\"\n                            },\n                            \"severity\": {\n                              \"type\": \"string\",\n                              \"enum\": [\"high\", \"medium\", \"low\"]\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        {\n          \"id\": \"node_repair_engine\",\n          \"type\": \"code\",\n          \"name\": \"节点修复引擎\",\n          \"description\": \"自动修复检测到的节点错误，支持多种修复策略\",\n          \"config\": {\n            \"runtime\": \"nodejs18.x\",\n            \"timeout\": 60000,\n            \"code\": \"function repairNodes(scanReport, autoRepairLevel, originalWorkflow) {\\n  const repairs = [];\\n  const repairedWorkflow = JSON.parse(JSON.stringify(originalWorkflow));\\n  \\n  scanReport.errors.forEach(errorNode => {\\n    const nodeRepairs = [];\\n    \\n    // 查找当前节点在工作流中的位置\\n    const nodeIndex = repairedWorkflow.nodes.findIndex(n => n.id === errorNode.node_id);\\n    if (nodeIndex === -1 && errorNode.node_id !== 'global' && errorNode.node_id !== 'connection') {\\n      nodeRepairs.push({ \\n        error_type: 'node_not_found', \\n        repair_action: 'skip_repair',\\n        status: 'failed',\\n        detail: `节点${errorNode.node_id}不存在`\\n      });\\n      return;\\n    }\\n    \\n    errorNode.errors.forEach(error => {\\n      let action = '';\\n      let status = 'success';\\n      let detail = '';\\n      \\n      try {\\n        switch (error.type) {\\n          case 'config':\\n            if (error.detail.includes('ID/类型缺失')) {\\n              if (errorNode.node_id === 'global') {\\n                // 修复全局配置\\n                if (!repairedWorkflow.name) {\\n                  repairedWorkflow.name = `AutoWorkflow_${Date.now().toString(36)}`;\\n                  action = '自动生成工作流名称';\\n                }\\n              } else if (nodeIndex !== -1) {\\n                // 修复节点配置\\n                if (!repairedWorkflow.nodes[nodeIndex].id) {\\n                  repairedWorkflow.nodes[nodeIndex].id = `node_${Date.now().toString(36)}_${nodeIndex}`;\\n                  action = '自动生成节点ID';\\n                }\\n                if (!repairedWorkflow.nodes[nodeIndex].type) {\\n                  repairedWorkflow.nodes[nodeIndex].type = 'code';\\n                  action = action ? action + ', 设置默认类型' : '设置默认节点类型';\\n                }\\n              }\\n            } else if (error.detail.includes('plugin_id缺失')) {\\n              repairedWorkflow.nodes[nodeIndex].config.plugin_id = `default_plugin_${Date.now().toString(36)}`;\\n              action = '设置默认插件ID';\\n            } else if (error.detail.includes('params必须为object')) {\\n              repairedWorkflow.nodes[nodeIndex].config.params = {};\\n              action = '初始化params为空对象';\\n            } else if (error.detail.includes('模型未指定')) {\\n              repairedWorkflow.nodes[nodeIndex].config.model = 'coze-ultra';\\n              action = '设置默认模型coze-ultra';\\n            } else if (error.detail.includes('提示词未设置')) {\\n              repairedWorkflow.nodes[nodeIndex].config.prompt = '请处理输入数据';\\n              action = '设置默认提示词';\\n            }\\n            break;\\n            \\n          case 'logic':\\n            if (autoRepairLevel === 'full' || autoRepairLevel === 'advanced') {\\n              if (error.detail.includes('未定义引用')) {\\n                const originalCode = repairedWorkflow.nodes[nodeIndex].config.code;\\n                repairedWorkflow.nodes[nodeIndex].config.code = originalCode\\n                  .replace(/undefined/g, 'null')\\n                  .replace(/null\\\\./g, 'null && null.');\\n                action = '修复代码中的未定义引用';\\n              }\\n            } else {\\n              action = '基础级别不支持逻辑修复';\\n              status = 'failed';\\n              detail = '需要高级或完全修复级别';\\n            }\\n            break;\\n            \\n          case 'dependency':\\n            if (error.detail.includes('连接错误')) {\\n              // 自动创建缺失的节点\\n              const missingNodeId = error.detail.includes('源节点') ? \\n                error.detail.match(/源节点(\\\\S+)不存在/)[1] : \\n                error.detail.match(/目标节点(\\\\S+)不存在/)[1];\\n              \\n              repairedWorkflow.nodes.push({\\n                id: missingNodeId,\\n                type: 'code',\\n                name: `自动修复节点_${missingNodeId}`,\\n                config: {\\n                  runtime: 'nodejs18.x',\\n                  code: '// 自动生成的节点\\\\nfunction processInput(input) {\\\\n  return input;\\\\n}'\\n                }\\n              });\\n              action = `自动创建缺失节点: ${missingNodeId}`;\\n            }\\n            break;\\n            \\n          default:\\n            action = `未知错误类型: ${error.type}`;\\n            status = 'failed';\\n        }\\n      } catch (e) {\\n        action = `修复失败: ${e.message}`;\\n        status = 'failed';\\n        detail = e.stack;\\n      }\\n      \\n      nodeRepairs.push({ \\n        error_type: error.type, \\n        repair_action: action,\\n        status: status,\\n        detail: detail,\\n        severity: error.severity\\n      });\\n    });\\n    \\n    repairs.push({\\n      node_id: errorNode.node_id,\\n      node_type: errorNode.node_type,\\n      repairs: nodeRepairs,\\n      status: nodeRepairs.every(r => r.status === 'success') ? 'success' : \\n             nodeRepairs.some(r => r.status === 'success') ? 'partial_success' : 'failed'\\n    });\\n  });\\n  \\n  // 处理警告（根据修复级别决定是否处理）\\n  if (autoRepairLevel === 'full') {\\n    scanReport.errors.forEach(errorNode => {\\n      errorNode.warnings.forEach(warning => {\\n        // 全修复级别下处理部分警告\\n        if (warning.detail.includes('建议指定插件版本')) {\\n          const nodeIndex = repairedWorkflow.nodes.findIndex(n => n.id === errorNode.node_id);\\n          if (nodeIndex !== -1 && repairedWorkflow.nodes[nodeIndex].type === 'plugin') {\\n            repairedWorkflow.nodes[nodeIndex].config.version = '1.0.0';\\n            repairs.find(r => r.node_id === errorNode.node_id)?.repairs.push({\\n              error_type: 'warning',\\n              repair_action: '设置默认插件版本1.0.0',\\n              status: 'success',\\n              severity: 'low'\\n            });\\n          }\\n        }\\n      });\\n    });\\n  }\\n  \\n  const successfulRepairs = repairs.filter(r => r.status === 'success').length +\\n                           repairs.filter(r => r.status === 'partial_success').length * 0.5;\\n  \\n  return {\\n    repaired_count: repairs.filter(r => r.status !== 'failed').length,\\n    total_errors: scanReport.error_count,\\n    success_rate: `${((successfulRepairs / scanReport.error_count) * 100).toFixed(1)}%`,\\n    repair_details: repairs,\\n    repaired_workflow: repairedWorkflow,\\n    preventive_measures: [\\n      '定期运行节点健康扫描',\\n      '使用参数免疫系统预处理输入',\\n      '启用自动修复功能'\\n    ]\\n  };\\n}\",\n            \"input_schema\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"scan_report\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"total\": {\"type\": \"integer\"},\n                    \"error_count\": {\"type\": \"integer\"},\n                    \"warning_count\": {\"type\": \"integer\"},\n                    \"errors\": {\"type\": \"array\"}\n                  }\n                },\n                \"auto_repair_level\": {\"type\": \"string\"},\n                \"original_workflow\": {\"type\": \"object\"}\n              }\n            },\n            \"output_schema\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"repaired_count\": {\"type\": \"integer\"},\n                \"total_errors\": {\"type\": \"integer\"},\n                \"success_rate\": {\"type\": \"string\"},\n                \"repair_details\": {\n                  \"type\": \"array\",\n                  \"items\": {\n                    \"type\": \"object\",\n                    \"properties\": {\n                      \"node_id\": {\"type\": \"string\"},\n                      \"node_type\": {\"type\": \"string\"},\n                      \"repairs\": {\"type\": \"array\"},\n                      \"status\": {\"type\": \"string\"}\n                    }\n                  }\n                },\n                \"repaired_workflow\": {\"type\": \"object\"},\n                \"preventive_measures\": {\"type\": \"array\"}\n              }\n            }\n          }\n        },\n        {\n          \"id\": \"quantum_plugin_generator\",\n          \"type\": \"code\",\n          \"name\": \"量子插件生成器\",\n          \"description\": \"基于自然语言需求生成完整Coze插件配置\",\n          \"config\": {\n            \"runtime\": \"nodejs18.x\",\n            \"timeout\": 90000,\n            \"code\": \"async function generatePlugin(demand, autoRepairLevel, workflowContext) {\\n  try {\\n    // 使用Coze官方模型解析需求\\n    const analysis = await coze.llms.run({\\n      model: 'coze-ultra',\\n      prompt: `请分析以下插件需求并生成完整的插件配置：\\\\n\\\\n需求：${demand}\\\\n\\\\n请提供：\\\\n1. 插件名称和功能描述\\\\n2. 输入输出参数定义\\\\n3. 必要的业务逻辑\\\\n4. Coze插件配置格式`,\\n      temperature: 0.3,\\n      max_tokens: 2000\\n    });\\n    \\n    // 解析模型响应，提取插件配置\\n    const responseText = analysis.choices[0].message.content;\\n    \\n    // 生成插件ID和名称\\n    const pluginId = `plugin_${Date.now().toString(36)}`;\\n    const pluginName = `AutoPlugin_${demand.substring(0, 20).replace(/[^a-zA-Z0-9]/g, '_')}`;\\n    \\n    // 提取参数定义（从模型响应中解析或使用默认值）\\n    let inputParams = {};\\n    let outputParams = {};\\n    \\n    // 尝试从AI响应中提取参数定义\\n    const inputMatch = responseText.match(/输入参数[：:]([\\\\s\\\\S]*?)(输出参数|$)/i);\\n    const outputMatch = responseText.match(/输出参数[：:]([\\\\s\\\\S]*?)$/i);\\n    \\n    if (inputMatch) {\\n      // 简化的参数解析逻辑\\n      inputParams = {\\n        input: {\\n          type: 'string',\\n          description: '用户输入参数'\\n        }\\n      };\\n    }\\n    \\n    if (outputMatch) {\\n      outputParams = {\\n        result: {\\n          type: 'object',\\n          description: '处理结果'\\n        }\\n      };\\n    }\\n    \\n    // 构建完整的插件配置\\n    const pluginConfig = {\\n      name: pluginName,\\n      id: pluginId,\\n      description: `自动生成的插件：${demand.substring(0, 50)}`,\\n      input_parameters: inputParams,\\n      output_parameters: outputParams,\\n      endpoints: {\\n        execute: {\\n          path: '/execute',\\n          method: 'POST'