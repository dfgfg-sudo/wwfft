nt,\\n      success_rate: repairSummary.success_rate,\\n      repair_details: repairSummary.repair_details\\n    },\\n    next_action: {\\n      input_box: {\\n        placeholder: '输入新需求继续自动化...',\\n        trigger_type: 'instant_exec',\\n        suggestions: [\\n          '尝试不同的功能需求',\\n          '调整修复级别为basic以提高速度',\\n          '查看生成的插件文档'\\n        ]\\n      }\\n    },\\n    metadata: {\\n      param_fixes: paramFixes,\\n      timestamp: new Date().toISOString(),\\n      version: '10.0.0'\\n    }\\n  };\\n  \\n  // 添加执行结果详情\\n  if (executionResult.result) {\\n    response.execution_result.details = executionResult.result;\\n  }\\n  \\n  // 添加修复后的工作流配置（如果存在）\\n  if (repairSummary.repaired_workflow) {\\n    response.node_repair_summary.repaired_workflow = repairSummary.repaired_workflow;\\n  }\\n  \\n  // 添加预防措施\\n  if (repairSummary.preventive_measures) {\\n    response.node_repair_summary.preventive_measures = repairSummary.preventive_measures;\\n  }\\n  \\n  // 处理降级模式\\n  if (pluginData.fallback_mode) {\\n    response.plugin_generated.fallback_mode = true;\\n    response.plugin_generated.error_message = pluginData.error_message;\\n    response.execution_result.warning = '插件生成使用降级模式';\\n  }\\n  \\n  return response;\\n}\",\n            \"input_schema\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"plugin_data\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"name\": {\"type\": \"string\"},\n                    \"id\": {\"type\": \"string\"},\n                    \"import_command\": {\"type\": \"string\"},\n                    \"usage_example\": {\"type\": \"string\"},\n                    \"coze_registered\": {\"type\": \"boolean\"},\n                    \"registration_id\": {\"type\": \"string\"},\n                    \"fallback_mode\": {\"type\": \"boolean\"},\n                    \"error_message\": {\"type\": \"string\"}\n                  }\n                },\n                \"execution_result\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"status\": {\"type\": \"string\"},\n                    \"result\": {\"type\": \"object\"},\n                    \"trigger_node_id\": {\"type\": \"string\"},\n                    \"execution_time_ms\": {\"type\": \"number\"},\n                    \"attempt_count\": {\"type\": \"number\"}\n                  }\n                },\n                \"repair_summary\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"repaired_count\": {\"type\": \"integer\"},\n                    \"success_rate\": {\"type\": \"string\"},\n                    \"repair_details\": {\"type\": \"array\"},\n                    \"repaired_workflow\": {\"type\": \"object\"},\n                    \"preventive_measures\": {\"type\": \"array\"}\n                  }\n                },\n                \"fixed_input\": {\"$ref\": \"#/components/schemas/OmniAutoRequest\"},\n                \"param_fixes\": {\"type\": \"array\"}\n              }\n            },\n            \"output_schema\": {\n              \"$ref\": \"#/components/schemas/OmniSuccessResponse/data\"\n            }\n          }\n        }\n      ],\n      \"connections\": [\n        {\n          \"source\": \"start\",\n          \"target\": \"param_immunity_system\",\n          \"description\": \"开始参数免疫处理\"\n        },\n        {\n          \"source\": \"param_immunity_system\",\n          \"target\": \"node_health_scanner\",\n          \"condition\": \"{{param_immunity_system.output.fixes.length > 0}}\",\n          \"input_mapping\": {\n            \"workflow\": \"{{coze.workflows.getCurrent()}}\"\n          },\n          \"description\": \"参数有修复时进行节点健康扫描\"\n        },\n        {\n          \"source\": \"node_health_scanner\",\n          \"target\": \"node_repair_engine\",\n          \"condition\": \"{{node_health_scanner.output.error_count > 0}}\",\n          \"input_mapping\": {\n            \"scan_report\": \"{{node_health_scanner.output}}\",\n            \"auto_repair_level\": \"{{param_immunity_system.output.fixed_input.auto_repair_level}}\",\n            \"original_workflow\": \"{{coze.workflows.getCurrent()}}\"\n          },\n          \"description\": \"发现错误时进行节点修复\"\n        },\n        {\n          \"source\": \"param_immunity_system\",\n          \"target\": \"quantum_plugin_generator\",\n          \"input_mapping\": {\n            \"user_demand\": \"{{param_immunity_system.output.fixed_input.user_demand}}\",\n            \"auto_repair_level\": \"{{param_immunity_system.output.fixed_input.auto_repair_level}}\",\n            \"workflow_context\": {\n              \"workflow_id\": \"{{param_immunity_system.output.fixed_input.workflow_id}}\",\n              \"trigger_node\": \"{{param_immunity_system.output.fixed_input.trigger_node_id}}\"\n            }\n          },\n          \"description\": \"参数处理完成后生成插件\"\n        },\n        {\n          \"source\": \"quantum_plugin_generator\",\n          \"target\": \"quantum_executor\",\n          \"input_mapping\": {\n            \"plugin_config\": \"{{quantum_plugin_generator.output}}\",\n            \"fixed_input\": \"{{param_immunity_system.output.fixed_input}}\",\n            \"repair_summary\": \"{{node_repair_engine.output || {repaired_count: 0, success_rate: '100%'}}}\"\n          },\n          \"description\": \"插件生成完成后执行工作流\"\n        },\n        {\n          \"source\": \"quantum_executor\",\n          \"target\": \"result_integrator\",\n          \"input_mapping\": {\n            \"plugin_data\": \"{{quantum_plugin_generator.output}}\",\n            \"execution_result\": \"{{quantum_executor.output}}\",\n            \"repair_summary\": \"{{node_repair_engine.output || {repaired_count: 0, success_rate: '100%', repair_details: []}}}\",\n            \"fixed_input\": \"{{param_immunity_system.output.fixed_input}}\",\n            \"param_fixe