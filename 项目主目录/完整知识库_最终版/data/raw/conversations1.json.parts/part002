    \"chinese_description_3\": \"字段描述：工作流总处理时间（单位：秒），保留1位小数精度\",\n        \"example_values\": [8.7, 45.2, 15.4],\n        \"chinese_description_4\": \"示例值，对应中文：【8.7秒（快速代码修复）】【45.2秒（视频转码）】【15.4秒（思维导图生成）】\"\n      },\n      {\n        \"field_name\": \"used_modules\",\n        \"chinese_description\": \"字段名，中文“使用模块”，记录工作流处理过程中调用的所有功能模块\",\n        \"field_type\": \"Array\",\n        \"chinese_description_2\": \"字段类型，中文“数组”，数组元素为模块名称字符串\",\n        \"description\": \"List of modules used in processing (string elements)\",\n        \"chinese_description_3\": \"字段描述：处理过程中使用的模块列表（数组元素为模块名称字符串）\",\n        \"example_values\": [[\"CodeRecognitionEngine\", \"CodeRepairEngine\"], [\"URLParsingEngine\", \"VideoProcessingEngine\"]],\n        \"chinese_description_4\": \"示例值，对应中文：[\\\"代码识别引擎\\\", \\\"代码修复引擎\\\"]（代码修复场景）】【[\\\"URL解析引擎\\\", \\\"视频处理引擎\\\"]（视频处理场景）】\"\n      },\n      {\n        \"field_name\": \"error_message\",\n        \"chinese_description\": \"字段名，中文“错误信息”，记录工作流处理失败时的具体原因\",\n        \"field_type\": \"String/Null\",\n        \"chinese_description_2\": \"字段类型，中文“字符串/空值”（失败时为错误描述字符串，成功时为null）\",\n        \"description\": \"Error information for failure: null = success, string = error details\",\n        \"chinese_description_3\": \"字段描述：处理失败时的错误信息，处理成功时为null，处理失败时为具体的错误详情字符串\",\n        \"example_values\": [null, \"Processing timeout (exceeded 30 seconds)\", \"Unsupported attachment format\"],\n        \"chinese_description_4\": \"示例值，对应中文：【null（处理成功）】【“处理超时（已超过30秒）”（超时错误）】【“不支持的附件格式”（格式错误）】\"\n      }\n    ],\n    \"sample_outputs\": {\n      \"success_sample_1\": {\n        \"chinese_description\": \"成功示例1，对应“代码修复”场景的输出结果\",\n        \"success\": true,\n        \"result\": \"def merge_models(model1, model2):\\n    if model1.dim != model2.dim:\\n        raise ValueError('Model dimensions mismatch: {} vs {}'.format(model1.dim, model2.dim))\\n    return merge_core(model1, model2)\",\n        \"chinese_description_2\": \"处理结果，中文“修复后的Python代码：增加了模型维度校验逻辑，避免维度不匹配错误”\",\n        \"processing_time\": 8.7,\n        \"chinese_description_3\": \"处理时间，8.7秒\",\n        \"used_modules\": [\"CodeRecognitionEngine\", \"CodeRepairEngine\"],\n        \"chinese_description_4\": \"使用模块，对应中文：【代码识别引擎】【代码修复引擎】\",\n        \"error_message\": null,\n        \"chinese_description_5\": \"错误信息，null（处理成功）\"\n      },\n      \"success_sample_2\": {\n        \"chinese_description\": \"成功示例2，对应“抖音视频转小红书图文”场景的输出结果\",\n        \"success\": true,\n        \"result\": \"https://example.com/download/xiaohongshu_abc123.jpg\",\n        \"chinese_description_2\": \"处理结果，中文“小红书图文下载链接（https://example.com/download/xiaohongshu_abc123.jpg），有效期24小时”\",\n        \"processing_time\": 45.2,\n        \"chinese_description_3\": \"处理时间，45.2秒\",\n        \"used_modules\": [\"URLParsingEngine\", \"VideoProcessingEngine\", \"XiaohongshuGenerator\"],\n        \"chinese_description_4\": \"使用模块，对应中文：【URL解析引擎】【视频处理引擎】【小红书生成引擎】\",\n        \"error_message\": null,\n        \"chinese_description_5\": \"错误信息，null（处理成功）\"\n      },\n      \"failure_sample\": {\n        \"chinese_description\": \"失败示例，对应“视频处理超时”场景的输出结果\",\n        \"success\": false,\n        \"chinese_description_2\": \"处理状态，false（处理失败）\",\n        \"result\": \"\",\n        \"chinese_description_3\": \"处理结果，空字符串（无有效结果）\",\n        \"processing_time\": 30.1,\n        \"chinese_description_4\": \"处理时间，30.1秒（超过默认30秒超时限制）\",\n        \"used_modules\": [\"VideoProcessingEngine\"],\n        \"chinese_description_5\": \"使用模块，对应中文：【视频处理引擎】（仅启动该模块即超时）\",\n        \"error_message\": \"Processing timeout (exceeded 30 seconds). Please increase timeout_limit (max 300s) and retry.\",\n        \"chinese_description_6\": \"错误信息，中文“处理超时（已超过30秒），请增大timeout_limit参数（最大300秒）后重试”\"\n      }\n    }\n  },\n  \"exception_handling\": {\n    \"chinese_description\": \"异常处理模块，定义工作流在遇到错误时的应对机制，确保稳定运行\",\n    \"mechanisms\": [\n      {\n        \"mechanism_id\": \"EXCEPTION_VALID_001\",\n        \"chinese_description\": \"异常处理机制唯一ID，标识“输入验证”机制\",\n        \"mechanism_name\": \"Input Validation\",\n        \"chinese_description_2\": \"机制名称，中文“输入验证机制”\",\n        \"description\": \"Pre-validate input variables to block invalid data (empty content, unsupported attachment format) and return user-friendly prompts.\",\n        \"chinese_description_3\": \"机制描述：提前验证输入变量的有效性，拦截无效数据（如空内容、不支持的附件格式），并返回用户易懂的错误提示\",\n        \"common_errors\": [\n          {\n            \"error_scenario\": \"content is empty\",\n            \"chinese_description\": \"常见错误场景1，中文“content字段为空”\",\n            \"error_prompt\": \"The 'content' field cannot be empty. Please provide code/text/URL/video link.\",\n            \"chinese_description_2\": \"错误提示，中文“content字段不能为空，请提供代码、文本、URL或视频链接”\"\n          },\n          {\n            \"error_scenario\": \"advanced_config is invalid JSON\",\n            \"chinese_description\": \"常见错误场景2，中文“advanced_config格式不是标准JSON”\",\n            \"error_prompt\": \"Invalid 'advanced_config' format. Please provide a standard JSON object (e.g., {\\\"style\\\": \\\"professional\\\"}).\",\n            \"chinese_description_2\": \"错误提示，中文“advanced_config格式无效，请提供标准JSON对象（例如{\\\"style\\\": \\\"professional\\\"}）”\"\n          }\n        ]\n      },\n      {\n        \"mechanism_id\": \"EXCEPTION_CAPTURE_001\",\n        \"chinese_description\": \"异常处理机制唯一ID，标识“运行时错误捕获”机制\",\n        \"mechanism_name\": \"Runtime Error Capture\",\n        \"chinese_description_2\": \"机制名称，中文“运行时错误捕获机制”\",\n        \"description\": \"Capture exceptions during module processing (code syntax errors, URL inaccessibility, file corruption) and record detailed logs (error type, step, input).\",\n        \"chinese_description_3\": \"机制描述：捕获模块处理过程中的异常（如代码语法错误、URL无法访问、文件损坏），并记录包含错误类型、发生步骤、输入信息的详细日志\",\n        \"logged_fields\": [\"timestamp\", \"error_type\", \"processing_step\", \"input_content (desensitized)\"],\n        \"chinese_description_4\": \"日志记录字段，对应中文：【timestamp（时间戳）】【error_type（错误类型）】【processing_step（发生步骤）】【input_content (desensitized)（脱敏后的输入内容）】\",\n        \"common_errors\": [\n          {\n            \"error_scenario\": \"URL is inaccessible\",\n            \"chinese_description\": \"常见错误场景1，中文“URL无法访问”\",\n            \"error_prompt\": \"URL {content} is inaccessible. Please check validity or try again later.\",\n            \"chinese_description_2\": \"错误提示，中文“URL {content}无法访问，请检查URL有效性或稍后重试”（{content}会替换为用户输入的具体URL）\"\n          },\n          {\n            \"error_scenario\": \"Attachment is corrupted\",\n            \"chinese_description\": \"常见错误场景2，中文“附件文件损坏”\",\n            \"error_prompt\": \"Uploaded file is corrupted. Please re-upload the original file.\",\n            \"chinese_description_2\": \"错误提示，中文“上传的文件已损坏，请重新上传原始文件”\"\n          }\n        ]\n      },\n      {\n        \"mechanism_id\": \"EXCEPTION_FALLBACK_001\",\n        \"chinese_description\": \"异常处理机制唯一ID，标识“降级 fallback 机制”\",\n        \"mechanism_name\": \"Fallback Mechanism\",\n        \"chinese_description_2\": \"机制名称，中文“降级 fallback 机制”（即主方案失败时的备用方案）\",\n        \"description\": \"Switch to alternative modules/methods if main processing fails. Example: high-precision code repair fails → use basic repair; 1080p video processing fails → try 720p.\",\n        \"chinese_description_3\": \"机制描述：当主要处理方式失败时，自动切换到备用模块或方法；例如：深度代码修复失败→使用基础修复；1080p视频处理失败→尝试720p分辨率\",\n        \"fallback_rules\": [\n          \"CodeRepair (deep) fails → CodeRepair (advanced)\",\n          \"Video resolution (4K) fails → 1080p\",\n          \"URL parsing fails → return raw content analysis\"\n        ],\n        \"chinese_description_4\": \"降级规则，对应中文：【代码修复（深度）失败→代码修复（进阶）】【视频分辨率（4K）失败→1080p】【URL解析失败→返回原始内容分析结果】\"\n      }\n    ]\n  },\n  \"performance_optimization\": {\n    \"chinese_description\": \"性能优化模块，定义提升工作流运行效率、降低资源消耗的策略\",\n    \"strategies\": [\n      {\n        \"strategy_id\": \"OPT_CACHE_001\",\n        \"chinese_description\": \"优化策略唯一ID，标识“智能缓存”策略\",\n        \"strategy_name\": \"Intelligent Cache\",\n        \"chinese_description_2\": \"策略名称，中文“智能缓存策略”\",\n        \"description\": \"Cache results of repeated requests (24h expiry) to avoid redundant processing. Cache key = MD5(content + instruction + output_format).\",\n        \"chinese_description_3\": \"策略描述：对重复请求的结果进行缓存（有效期24小时），避免重复处理相同内容；缓存键由content+instruction+output_format的MD5值构成（确保缓存唯一性）\",\n        \"optimization_effect\": \"Repeated request response time reduced by 80%.\",\n        \"chinese_description_4\": \"优化效果，中文“重复请求的响应时间降低80%”（例如第二次请求相同内容时，直接返回缓存，无需重新处理）\"\n      },\n      {\n        \"strategy_id\": \"OPT_PARALLEL_001\",\n        \"chinese_description\": \"优化策略唯一ID，标识“并行处理”策略\",\n        \"strategy_name\": \"Parallel Processing\",\n        \"chinese_description_2\": \"策略名称，中文“并行处理策略”\",\n        \"description\": \"Use multi-threading for parallelizable tasks: batch image processing, multi-file code analysis, simultaneous video transcoding + watermarking.\",\n        \"chinese_description_3\": \"策略描述：对可并行处理的任务使用多线程技术，例如：批量图片处理、多文件代码分析、视频转码与水印添加同时进行\",\n        \"optimization_effect\": \"Multi-task processing time reduced by 40-60%.\",\n        \"chinese_description_4\": \"优化效果，中文“多任务处理时间降低40%-60%”（例如同时处理10张图片，并行处理比串行处理快近一倍）\"\n      },\n      {\n        \"strategy_id\": \"OPT_RESOURCE_001\",\n        \"chinese_description\": \"优化策略唯一ID，标识“动态资源分配”策略\",\n        \"strategy_name\": \"Dynamic Resource Allocation\",\n        \"chinese_description_2\": \"策略名称，中文“动态资源分配策略”\",\n        \"description\": \"Allocate memory/CPU based on content size: large videos (200MB) → 4GB memory; small code snippets → 512MB memory. Release resources immediately after module completion.\",\n        \"chinese_description_3\": \"策略描述：根据处理内容的大小动态分配内存和CPU资源，例如：200MB的大视频→分配4GB内存；10行的小代码片段→分配512MB内存；模块处理完成后立即释放资源，避免浪费\",\n        \"optimization_effect\": \"Memory usage reduced by 30%; no resource leaks.\",\n        \"chinese_description_4\": \"优化效果，中文“内存使用率降低30%，无资源泄漏”（避免小任务占用大内存，或处理完成后资源不释放的问题）\"\n      },\n      {\n        \"strategy_id\": \"OPT_TIMEOUT_001\",\n        \"chinese_description\": \"优化策略唯一ID，标识“超时控制”策略\",\n        \"strategy_name\": \"Timeout Control\",\n        \"chinese_description_2\": \"策略名称，中文“超时控制策略”\",\n        \"description\": \"Set default timeout (30s) and user-adjustable limit (5-300s). Terminate overtime tasks to free resources.\",\n        \"chinese_description_3\": \"策略描述：设置默认超时时间（30秒）和用户可调整的超时范围（5-300秒）；对超过超时时间的任务进行终止，释放占用的资源\",\n        \"optimization_effect\": \"Resource occupation by abnormal tasks reduced by 90%.\",\n        \"chinese_description_4\": \"优化效果，中文“异常任务的资源占用降低90%”（避免因模块卡死导致的资源长期占用）\"\n      }\n    ]\n  },\n  \"scalability_design\": {\n    \"chinese_description\": \"扩展性设计模块，定义工作流新增功能、对接外部系统的实现方式，确保可灵活扩展\",\n    \"design_features\": [\n      {\n        \"feature_id\": \"SCALE_PLUGIN_001\",\n        \"chinese_description\": \"设计特性唯一ID，用于标识“插件架构”这一扩展性设计特性\",\n        \"feature_name\": \"Plugin Architecture\",\n        \"chinese_description_2\": \"特性名称，中文“插件架构”，指通过标准化接口实现新功能模块的快速集成，如同“给工作流插上新插件”即可扩展能力\",\n        \"description\": \"Standard module interface (input/output/error handling) for easy extension. New modules (e.g., PDFtoPPT, AIPainting) integrate via interface implementation.\",\n        \"chinese_description_3\": \"特性描述：定义包含“输入参数、输出格式、错误处理”的标准模块接口，新模块（如PDF转PPT、AI绘画模块）只需实现该接口，就能接入工作流，无需修改工作流核心代码，极大降低扩展成本\",\n        \"integration_steps\": [\n          \"1. Implement standard interface (process(), get_config_whitelist(), handle_error()).\",\n          \"2. Add module to configuration file (map content type → new module).\",\n          \"3. Register module in UniversalWorkflowProcessor.\",\n          \"4. Add subfields to 'advanced_config' (if needed).\"\n        ],\n        \"chinese_description_4\": \"集成步骤，对应中文：【1. 实现标准接口（process()处理函数：执行模块核心逻辑；get_config_whitelist()配置白名单函数：返回模块支持的高级配置字段；handle_error()错误处理函数：定义模块异常时的应对逻辑）；2. 在配置文件中添加模块映射：将特定内容类型与新模块关联（如“PDF文件”对应“PDF转PPT模块”）；3. 在通用工作流处理器（UniversalWorkflowProcessor）中注册新模块，让工作流能识别并调用；4. 若新模块需精细化配置（如PPT的幻灯片布局），在advanced_config的supported_subfields中添加对应子字段】\",\n        \"example_extension\": \"PDFtoPPT module: content type (PDF) → map to PDFtoPPT; advanced_config subfields (slide_layout, font_style).\",\n        \"chinese_description_5\": \"扩展示例，对应中文：“PDF转PPT模块：将内容类型（PDF文件）映射到PDF转PPT模块；在advanced_config中添加子字段（slide_layout：幻灯片布局，可选“简约”“商务”等；font_style：字体样式，可选“微软雅黑”“宋体”等），支持用户自定义PPT生成效果”\"\n      },\n      {\n        \"feature_id\": \"SCALE_CONFIG_001\",\n        \"chinese_description\": \"设计特性唯一ID，用于标识“配置驱动”这一扩展性设计特性\",\n        \"feature_name\": \"Configuration-Driven\",\n        \"chinese_description_2\": \"特性名称，中文“配置驱动”，指通过修改配置文件而非代码来调整工作流规则，如同“改设置就能变功能”\",\n        \"description\": \"Store module rules, default parameters, and format lists in JSON/YAML config files (no code changes for updates).\",\n        \"chinese_description_3\": \"特性描述：将“模块匹配规则、默认参数、格式白名单”等可调整项存储在JSON或YAML配置文件中，后续更新规则（如新增支持的文件格式）时，只需修改配置文件，无需修改工作流代码，提升维护效率\",\n        \"config_files\": [\n          \"module_mapping.json: content_type → module list\",\n          \"default_params.json: default timeout/cache/format\",\n          \"format_whitelist.json: supported output/attachment formats\"\n        ],\n        \"chinese_description_4\": \"配置文件说明，对应中文：【1. module_mapping.json：存储“内容类型→模块列表”的映射关系（如“代码”对应“代码修复模块、代码分析模块”）；2. default_params.json：存储默认参数（如默认超时时间30秒、默认启用缓存、默认输出格式为纯文本）；3. format_whitelist.json：存储支持的输出格式和附件格式白名单（如输出格式包含“markdown”“excel”，附件格式包含“.mp4”“.pdf”）】\"\n      },\n      {\n        \"feature_id\": \"SCALE_API_001\",\n        \"chinese_description\": \"设计特性唯一ID，用于标识“标准API接口”这一扩展性设计特性\",\n        \"feature_name\": \"Standard API Interface\",\n        \"chinese_description_2\": \"特性名称，中文“标准API接口”，指提供统一的接口供外部系统调用工作流，实现“跨系统协作”\",\n        \"description\": \"RESTful API for external integration: /workflow/start (initiate task), /workflow/query (get result), /workflow/cancel (terminate task).\",\n        \"chinese_description_3\": \"特性描述：提供符合RESTful风格的API接口，支持外部系统（如企业OA、自媒体管理平台）集成工作流能力，核心接口包括“启动工作流任务（/workflow/start）、查询任务结果（/workflow/query）、终止任务（/workflow/cancel）”\",\n        \"api_spec\": {\n          \"method\": \"POST\",\n          \"chinese_description\": \"请求方法，中文“POST请求”，用于向接口提交数据（如工作流的输入参数），适合传输复杂信息\",\n          \"endpoint\": \"/workflow/start\",\n          \"chinese_description_2\": \"接口地址，中文“/workflow/start”，即启动工作流任务的具体接口路径，外部系统通过该路径发起任务\",\n          \"request_body\": \"All start node variables\",\n          \"chinese_description_3\": \"请求体，中文“起始节点的所有变量”，即外部系统需在请求体中传入content（核心内容）、instruction（处理指令）等起始节点要求的所有输入信息\",\n          \"response_body\": \"Unified JSON result (same as output_result_format)\",\n          \"chinese_description_4\": \"响应体，中文“统一JSON格式结果（与output_result_format定义一致）”，即接口返回的结果结构和工作流自身输出的结果格式完全相同，包含success（处理状态）、result（处理结果）等字段，确保外部系统能统一解析\"\n        }\n      }\n    ]\n  },\n  \"end_node\": {\n    \"node_id\": \"END_001\",\n    \"chinese_description\": \"结束节点唯一ID，用于标识工作流的最终收尾节点，与起始节点形成流程闭环\",\n    \"node_name\": \"Workflow_Completion_Node\",\n    \"chinese_description_2\": \"节点名称，中文“工作流完成节点”，是工作流的最后一步，负责“输出结果、清理资源、记录日志”\",\n    \"description\": \"Output final result, clean up temporary resources, and record logs.\",\n    \"chinese_description_3\": \"节点描述：输出工作流的最终处理结果，清理过程中产生的临时资源（如上传的附件临时文件），并记录工作流运行日志（供后续排查问题和优化）\",\n    \"resource_cleanup\": [\n      \"Delete temporary attachment files (auto-clean 24h after completion).\",\n      \"Release module memory/CPU resources.\",\n      \"Close database/cache library connections.\"\n    ],\n    \"chinese_description_4\": \"资源清理规则，对应中文：【1. 删除附件的临时文件：工作流完成后，自动保留24小时（方便用户补下载），24小时后系统自动删除，避免占用存储空间且保护用户隐私；2. 释放模块资源：释放处理过程中各功能模块（如视频处理、代码修复模块）占用的内存和CPU资源，避免资源泄漏；3. 关闭连接：关闭工作流使用的数据库连接和缓存库连接，释放网络资源】\",\n    \"log_recording\": {\n      \"log_fields\": [\"workflow_id\", \"success_status\", \"processing_time\", \"used_modules\", \"input_desensitized\", \"error_message\"],\n      \"chinese_description\": \"日志记录字段，对应中文：【workflow_id（工作流ID，标识是哪个工作流的日志）；success_status（处理状态，成功/失败）；processing_time（处理时间，单位秒）；used_modules（使用的模块列表，如“视频处理模块”）；input_desensitized（脱敏后的输入信息，如隐藏附件文件名中的敏感字符，保护用户数据）；error_message（错误信息，失败时记录具体原因，成功时为null）】\",\n      \"log_storage\": \"Workflow log database (retention period: 30 days)\",\n      \"chinese_description_2\": \"日志存储方式，中文“工作流日志数据库（保留期30天）”：日志统一存储在专用数据库中，保留30天，超过期限自动清理，平衡“问题追溯”和“存储占用”\",\n      \"log_purpose\": \"Problem location, workflow optimization, usage analysis\",\n      \"chinese_description_3\": \"日志用途，对应中文：【问题定位：如用户反馈处理失败时，通过日志查询具体错误步骤和原因；工作流优化：分析哪些模块耗时较长，针对性优化性能；使用分析：统计哪些功能模块使用频率高，后续重点迭代】\"\n    },\n    \"final_output\": \"Unified JSON result (compliant with output_result_format)\",\n    \"chinese_description_5\": \"最终输出，中文“统一JSON格式结果（符合output_result_format定义）”：即工作流向用户或外部系统返回的最终结果，结构完全遵循“输出结果格式”模块的定义，确保结果清晰、可解析\"\n  }\n出现“Expected comma or closing brace”错误通常是因为JSON格式不正确    {\n  \"workflow_name\": \"AllInOne_Content_Processing_and_Workflow_Optimization_Master\",\n  \"workflow_description\": \"A multi-functional unified processing workflow that can intelligently identify various types of user input content (code, text, URL, video links, etc.) and automatically call the most suitable processing modules. It integrates dozens of functions such as code repair, model merging, Douyin video processing, content generation, format conversion, workflow analysis and optimization. When users need to process any form of content or workflow, they only need to provide the content and simple instructions. This workflow will automatically analyze the content type, select the optimal processing method, and return results in a unified format. It is suitable for developers, content creators, social media operators and other scenarios that require efficient processing of multiple types of content.\",\n  \"start_node\": {\n    \"node_name\": \"Workflow_Initiation_Node\",\n    \"node_description\": \"The starting node of the workflow, responsible for collecting core input information to support the entire process from content recognition, module calling, result generation to end output, ensuring the coherence of information from the start to the end node.\",\n    \"input_variables\": [\n      {\n        \"variable_name\": \"content\",\n        \"variable_type\": \"String\",\n        \"required\": \"Yes\",\n        \"variable_description\": \"The core processing object of the entire workflow. It will later enter the 'Intelligent Content Type Recognition Node' (to identify types such as code, text, URL, video link) and provide a basis for calling modules such as code repair and video processing. The workflow cannot start without this variable.\",\n        \"format_constraints\": \"Non-empty string, supports any character content (including code syntax, URL links, text descriptions, etc.)\"\n      },\n      {\n        \"variable_name\": \"instruction\",\n        \"variable_type\": \"String\",\n        \"required\": \"No\",\n        \"variable_description\": \"Assists the 'Processing Strategy Selection Node' to determine the direction: if provided (e.g., 'Fix MergeKit errors'), it directly matches the corresponding functional module; if not provided, the system will automatically infer the optimal processing method based on the content recognition result (e.g., call the Douyin video processing module if a Douyin link is identified).\",\n        \"format_constraints\": \"Supports text descriptions of processing requirements, no strict length limit (recommended within 500 characters for clarity)\"\n      },\n      {\n        \"variable_name\": \"output_format\",\n        \"variable_type\": \"String\",\n        \"required\": \"No\",\n        \"variable_description\": \"Determines the output form of the 'Result Formatting Node': it needs to correspond to the output result format (the 'result' field in JSON), supporting 'text/markdown/json/xiaohongshu_graphic/mind_map' etc. The default output format is 'text' if not provided.\",\n        \"format_constraints\": \"Supports preset enumeration values: ['text', 'markdown', 'json', 'xiaohongshu_graphic', 'mind_map', 'html', 'excel', 'ppt'], case-insensitive\"\n      },\n      {\n        \"variable_name\": \"advanced_config\",\n        \"variable_type\": \"Object\",\n        \"required\": \"No\",\n        \"variable_description\": \"Provides configuration for the 'Module Refined Processing Node'. For example, when processing 'mind map generation', parameters such as {\\\"style\\\":\\\"professional\\\",\\\"length\\\":\\\"long\\\"} are passed through this variable; if not provided, the default configuration of each module is used, which does not affect basic function operation.\",\n        \"format_constraints\": \"Standard JSON object structure, keys are strings, values support nested multi-type (String/Number/Boolean/Object). Subfields must match the 'configuration field whitelist' of the target processing module; unmatched fields are ignored without errors.\",\n        \"supported_subfields\": {\n          \"mind_map_module\": [\n            {\n              \"subfield_name\": \"style\",\n              \"subfield_type\": \"String\",\n              \"value_range\": [\"professional\", \"minimalist\", \"colorful\", \"technical\"],\n              \"default_value\": \"professional\"\n            },\n            {\n              \"subfield_name\": \"length\",\n              \"subfield_type\": \"String\",\n              \"value_range\": [\"short\", \"medium\", \"long\"],\n              \"default_value\": \"medium\"\n            },\n            {\n              \"subfield_name\": \"node_color\",\n              \"subfield_type\": \"String\",\n              \"value_range\": \"16-bit hex color values (e.g., \\\"#2E86AB\\\") or standard color names (e.g., \\\"blue\\\")\",\n              \"default_value\": \"#2E86AB\"\n            }\n          ],\n          \"code_repair_module\": [\n            {\n              \"subfield_name\": \"fix_level\",\n              \"subfield_type\": \"String\",\n              \"value_range\": [\"basic\", \"advanced\", \"deep\"],\n              \"default_value\": \"advanced\"\n            },\n            {\n              \"subfield_name\": \"keep_comments\",\n              \"subfield_type\": \"Boolean\",\n              \"value_range\": [true, false],\n              \"default_value\": true\n            },\n            {\n              \"subfield_name\": \"target_version\",\n              \"subfield_type\": \"String\",\n              \"value_range\": \"Language version strings (e.g., \\\"Python 3.9\\\", \\\"Java 17\\\")\",\n              \"default_value\": \"Latest stable version\"\n            }\n          ],\n          \"video_processing_module\": [\n            {\n              \"subfield_name\": \"resolution\",\n              \"subfield_type\": \"String\",\n              \"value_range\": [\"720p\", \"1080p\", \"2K\", \"4K\"],\n              \"default_value\": \"1080p\"\n            },\n            {\n              \"subfield_name\": \"format\",\n              \"subfield_type\": \"String\",\n              \"value_range\": [\"mp4\", \"mov\", \"avi\", \"webm\"],\n              \"default_value\": \"mp4\"\n            },\n            {\n              \"subfield_name\": \"watermark\",\n              \"subfield_type\": \"Object\",\n              \"nested_subfields\": [\n                {\n                  \"subfield_name\": \"enable\",\n                  \"subfield_type\": \"Boolean\",\n                  \"default_value\": false\n                },\n                {\n                  \"subfield_name\": \"text\",\n                  \"subfield_type\": \"String\",\n                  \"default_value\": \"\"\n                },\n                {\n                  \"subfield_name\": \"position\",\n                  \"subfield_type\": \"String\",\n                  \"value_range\": [\"top_left\", \"top_right\", \"bottom_left\", \"bottom_right\"],\n                  \"default_value\": \"bottom_right\"\n                }\n              ]\n            }\n          ]\n        }\n      },\n      {\n        \"variable_name\": \"content_source\",\n        \"variable_type\": \"String\",\n        \"required\": \"No\",\n        \"variable_description\": \"Supplements the source of the content (e.g., \\\"local_file_upload\\\", \\\"copy_paste\\\", \\\"url_link\\\") to assist the 'Intelligent Content Type Recognition Node' in improving recognition accuracy. The system automatically detects the source if not provided.\",\n        \"format_constraints\": \"Supports preset enumeration values, case-insensitive. Automatically corrects non-enumeration values to the closest matching source.\",\n        \"value_options\": [\n          {\n            \"option_value\": \"local_file_upload\",\n            \"description\": \"Content comes from local file upload (e.g., user copies file content and pastes it into the content field)\",\n            \"adapted_content_types\": [\"code\", \"long_text\", \"structured_data (e.g., CSV content)\"]\n          },\n          {\n            \"option_value\": \"copy_paste\",\n            \"description\": \"Content comes from manual copy-paste (not file upload)\",\n            \"adapted_content_types\": [\"short_text\", \"code_snippets\", \"URL_links\"]\n          },\n          {\n            \"option_value\": \"url_link\",\n            \"description\": \"Content is an accessible URL (e.g., Douyin video URL, web page URL, file download URL)\",\n            \"adapted_content_types\": [\"Various URLs (HTTP/HTTPS protocol)\"]\n          },\n          {\n            \"option_value\": \"api_request\",\n            \"description\": \"Content comes from external API requests (e.g., content passed in by other systems via API)\",\n            \"adapted_content_types\": [\"JSON text returned by interfaces\", \"structured_data\"]\n          },\n          {\n            \"option_value\": \"file_attachment\",\n            \"description\": \"Content needs to be combined with the uploaded file in the 'attachment' field (e.g., content describes instructions, and the file is in attachment)\",\n            \"adapted_content_types\": [\"Instruction text matched with attachment (e.g., \\\"Convert the format of this file\\\")\"]\n          }\n        ],\n        \"auto_detection_rules\": [\n          \"If content starts with 'http://' or 'https://', automatically mark as 'url_link'\",\n          \"If the 'attachment' field has an uploaded file, automatically mark as 'file_attachment'\",\n          \"If content length > 1000 characters and contains code syntax (e.g., 'def'/'class'), automatically mark as 'local_file_upload'\",\n          \"Mark as 'copy_paste' by default for other cases\"\n        ]\n      },\n      {\n        \"variable_name\": \"timeout_limit\",\n        \"variable_type\": \"Number\",\n        \"required\": \"No\",\n        \"variable_description\": \"Controls the timeout time of the entire workflow (unit: seconds), corresponding to the 'Performance Optimization - Timeout Control' mechanism of the workflow. The default value is 30 seconds; for processing large files (e.g., long videos), a larger value (e.g., 120) can be set manually.\",\n        \"format_constraints\": \"Positive number, supports integers or decimals with 1 decimal place precision. Values outside the range are automatically adjusted to the nearest valid value.\",\n        \"value_constraints\": {\n          \"minimum_value\": 5,\n          \"maximum_value\": 300,\n          \"default_value\": 30,\n          \"precision\": \"1 decimal place (e.g., 15.5 seconds, 12.34 seconds → rounded to 12.3 seconds)\",\n          \"error_handling\": \"Negative numbers or 0 trigger input validation errors, prompting 'Timeout time must be greater than 0 seconds'; non-numeric types use the default value of 30 seconds\"\n        }\n      },\n      {\n        \"variable_name\": \"enable_cache\",\n        \"variable_type\": \"Boolean\",\n        \"required\": \"No\",\n        \"variable_description\": \"Controls whether to enable the 'Intelligent Cache' function (corresponding to the 'Performance Optimization - Intelligent Cache' of the workflow). 'true' means enabled (return cached results directly for repeated requests), 'false' means disabled. The default value is true.\",\n        \"format_constraints\": \"Strict boolean type, only supports lowercase 'true' or 'false'; non-boolean types (e.g., 'True', '1', 'enable') automatically use the default value 'true'.\",\n        \"value_meanings\": [\n          {\n            \"value\": true,\n            \"core_meaning\": \"Enable intelligent cache: 1. The system generates a 'cache key' (composed of the MD5 value of content + instruction + output_format); 2. If the 'cache key' exists in the cache library and has not expired, return the cached result directly and skip subsequent processing modules; 3. If it does not exist or has expired, store the result in the cache library after normal processing.\",\n            \"applicable_scenarios\": \"Repeated requests (e.g., generating mind maps on the same topic multiple times), time-consuming fixed content processing (e.g., video parsing of the same URL)\",\n            \"cache_validity_period\": \"24 hours by default (adjustable via system configuration, not open to users for modification)\"\n          },\n          {\n            \"value\": false,\n            \"core_meaning\": \"Disable intelligent cache: 1. Do not generate a 'cache key' or query the cache library; 2. Trigger the complete processing flow (from content recognition to result generation) for each request; 3. Do not store the result in the cache library after processing.\",\n            \"applicable_scenarios\": \"Content requiring high real-time performance (e.g., real-time updated web page parsing), dynamic content (e.g., video data that changes over time)\",\n            \"cache_validity_period\": \"None (no caching)\"\n          }\n        ]\n      },\n      {\n        \"variable_name\": \"attachment\",\n        \"variable_type\": \"File\",\n        \"required\": \"No\",\n        \"variable_description\": \"Used to upload files that need auxiliary processing (e.g., code attachments, reference documents, original video files), and used in conjunction with the 'content' field (example: fill 'Process format conversion of this file' in 'content', and upload the target file in 'attachment'). Supports common formats (.txt/.pdf/.mp4/.zip, etc.).\",\n        \"format_constraints\": \"Only supports the listed file formats; unsupported formats trigger input validation errors. Single file upload only; multiple files need to be compressed into .zip before uploading.\",\n        \"supported_file_formats\": [\n          {\n            \"file_category\": \"Text files\",\n            \"specific_formats\": [\".txt\", \".md\", \".docx\", \".pdf\", \".csv\", \".json\", \".xml\", \".yml\"],\n            \"max_single_file_size\": \"50MB\",\n            \"adapted_processing_modules\": [\"Text analysis\", \"Format conversion\", \"Content extraction module\"]\n          },\n          {\n            \"file_category\": \"Code files\",\n            \"specific_formats\": [\".py\", \".java\", \".js\", \".cpp\", \".go\", \".php\", \".html\", \".css\", \".sql\"],\n            \"max_single_file_size\": \"20MB\",\n            \"adapted_processing_modules\": [\"Code repair\", \"Code analysis\", \"Model merging module\"]\n          },\n          {\n            \"file_category\": \"Media files\",\n            \"specific_formats\": [\".mp4\", \".mov\", \".avi\", \".webm (video)\", \".jpg\", \".png\", \".gif\", \".svg (image)\", \".mp3\", \".wav (audio)\"],\n            \"max_single_file_size\": \"200MB (video/audio), 50MB (image)\",\n            \"adapted_processing_modules\": [\"Video processing (editing/format conversion)\", \"Image generation/optimization\", \"Audio to text module\"]\n          },\n          {\n            \"file_category\": \"Compressed files\",\n            \"specific_formats\": [\".zip\", \".rar\", \".7z\"],\n            \"max_single_file_size\": \"100MB\",\n            \"adapted_processing_modules\": [\"Compressed package decompression\", \"Batch file processing module\"]\n          },\n          {\n            \"file_category\": \"Other supported formats\",\n            \"specific_formats\": [\".xlsx\", \".pptx\", \".jsonl\"],\n            \"max_single_file_size\": \"50MB\",\n            \"adapted_processing_modules\": [\"Data statistics\", \"PPT content extraction\", \"Batch JSON processing module\"]\n          }\n        ],\n        \"size_constraints\": \"Maximum size of a single file: 200MB (video/audio). Files exceeding the limit prompt 'File too large, please compress and upload (maximum support 200MB)'\",\n        \"naming_constraints\": \"File names cannot contain special characters (/ \\\\ : * ? \\\" < > |); special characters are automatically replaced with '_' (e.g., 'my file?.txt' → 'my file_.txt')\"\n      }\n    ]\n  },\n  \"core_processing_logic\": {\n    \"function_name\": \"main_workflow\",\n    \"function_description\": \"Master processing function of the All-in-One Content Processing and Workflow Optimization Master\",\n    \"processing_steps\": [\n      {\n        \"step_number\": 1,\n        \"step_name\": \"Initialize Processor\",\n        \"step_description\": \"Create an instance of the UniversalWorkflowProcessor to load all functional modules and default configurations\"\n      },\n      {\n        \"step_number\": 2,\n        \"step_name\": \"Input Data Validation\",\n        \"step_description\": \"Verify the validity of input variables (non-empty check of content, format validity of advanced_config, positive number check of timeout_limit, format/size check of attachment), and return clear error prompts for invalid inputs\"\n      },\n      {\n        \"step_number\": 3,\n        \"step_name\": \"Cache Check (if enable_cache is true)\",\n        \"step_description\": \"Generate a cache key based on content + instruction + output_format, query the cache library. If a valid cache exists, return the cached result directly and skip subsequent steps; if not, proceed to content recognition\"\n      },\n      {\n        \"step_number\": 4,\n        \"step_name\": \"Intelligent Content Type Recognition\",\n        \"step_description\": \"Combine content_source and content itself to identify content types (code/text/URL/video link/file attachment), and narrow down the range of applicable processing modules\"\n      },\n      {\n        \"step_number\": 5,\n        \"step_name\": \"Processing Strategy Selection\",\n        \"step_description\": \"Match the optimal processing module based on the recognized content type and instruction (if provided). For example, 'code' type + 'fix error' instruction → call code repair module; 'URL' type + no instruction → call URL parsing module\"\n      },\n      {\n        \"step_number\": 6,\n        \"step_name\": \"Module Refined Processing\",\n        \"step_description\": \"Pass advanced_config to the selected module for refined processing (e.g., set mind map style via advanced_config, set code repair level), and start the module processing task\"\n      },\n      {\n        \"step_number\": 7,\n        \"step_name\": \"Process Monitoring (Timeout Control)\",\n        \"step_description\": \"Monitor the total processing time in real time. If it exceeds timeout_limit, terminate the current module, return a timeout error prompt, and record the timeout log\"\n      },\n      {\n        \"step_number\": 8,\n        \"step_name\": \"Result Formatting\",\n        \"step_description\": \"Convert the processing result into the format specified by output_format (default 'text' if not specified). For file output (e.g., converted video), generate a file download link (valid for 24 hours)\"\n      },\n      {\n        \"step_number\": 9,\n        \"step_name\": \"Cache Result (if enable_cache is true)\",\n        \"step_description\": \"Store the formatted result, processing time, and used modules into the cache library, and set the cache validity period to 24 hours\"\n      },\n      {\n        \"step_number\": 10,\n        \"step_name\": \"Return Result\",\n        \"step_description\": \"Output the result in a unified JSON format, including success status, processing result, processing time, used modules, and error information (if any)\"\n      }\n    ]\n  },\n  \"output_result_format\": {\n    \"format_type\": \"JSON\",\n    \"fields_description\": [\n      {\n        \"field_name\": \"success\",\n        \"field_type\": \"Boolean\",\n        \"field_description\": \"Indicates whether the workflow processing is successful: true for success, false for failure\"\n      },\n      {\n        \"field_name\": \"result\",\n        \"field_type\": \"String/Object\",\n        \"field_description\": \"Processing result content: text content for text output; file download link (string) for file output; structured data (object) for special formats (e.g., mind map node data)\"\n      },\n      {\n        \"field_name\": \"processing_time\",\n        \"field_type\": \"Number\",\n        \"field_description\": \"Total workflow processing time (unit: seconds), with 1 decimal place precision\"\n      },\n      {\n        \"field_name\": \"used_modules\",\n        \"field_type\": \"Array\",\n        \"field_description\": \"List of modules used in this processing (e.g., [\\\"VideoProcessingEngine\\\", \\\"IntelligentAnalysisEngine\\\"])\"\n      },\n      {\n        \"field_name\": \"error_message\",\n        \"field_type\": \"String/Null\",\n        \"field_description\": \"Error information when processing fails: null for success, specific error description string for failure (e.g., 'Processing timeout (exceeded 30 seconds)')\"\n      }\n    ],\n    \"sample_output\": {\n      \"success_sample\": {\n        \"success\": true,\n        \"result\": \"https://example.com/download/converted_video.mp4\",\n        \"processing_time\": 12.3,\n        \"used_modules\": [\"VideoProcessing