ed: true },\n  description: { type: String },\n  projectType: { \n    type: String, \n    enum: ['classification', 'regression', 'clustering', 'deep_learning'],\n    required: true \n  },\n  dataType: {\n    type: String,\n    enum: ['tabular', 'image', 'text', 'audio'],\n    required: true\n  },\n  status: {\n    type: String,\n    enum: ['pending', 'running', 'completed', 'failed'],\n    default: 'pending'\n  },\n  parameters: { type: Object },\n  datasetUrl: { type: String },\n  targetColumn: { type: String },\n  progress: { type: Number, default: 0, min: 0, max: 100 },\n  results: { type: Object },\n  createdAt: { type: Date, default: Date.now },\n  updatedAt: { type: Date, default: Date.now }\n});\n\nconst WorkflowSchema = new mongoose.Schema({\n  workflowId: { type: String, default: uuidv4, unique: true },\n  userId: { type: String, required: true },\n  name: { type: String, required: true },\n  description: { type: String },\n  definition: { type: Object },\n  status: {\n    type: String,\n    enum: ['draft', 'active', 'paused', 'completed', 'failed'],\n    default: 'draft'\n  },\n  parameters: { type: Object },\n  executions: [{ type: Object }],\n  createdAt: { type: Date, default: Date.now },\n  updatedAt: { type: Date, default: Date.now }\n});\n\n// 创建模型\nconst User = mongoose.model('User', UserSchema);\nconst Project = mongoose.model('Project', ProjectSchema);\nconst Workflow = mongoose.model('Workflow', WorkflowSchema);\n\n// 密码加密中间件\nUserSchema.pre('save', async function(next) {\n  if (!this.isModified('password')) return next();\n  try {\n    const salt = await bcrypt.genSalt(10);\n    this.password = await bcrypt.hash(this.password, salt);\n    next();\n  } catch (error) {\n    next(error);\n  }\n});\n\n// JWT认证中间件\nconst authenticateToken = (req, res, next) => {\n  const authHeader = req.headers['authorization'];\n  const token = authHeader && authHeader.split(' ')[1];\n\n  if (!token) {\n    return res.status(401).json({\n      success: false,\n      error: 'ACCESS_TOKEN_REQUIRED',\n      message: '访问令牌缺失'\n    });\n  }\n\n  jwt.verify(token, process.env.JWT_SECRET || 'your-secret-key', (err, user) => {\n    if (err) {\n      return res.status(403).json({\n        success: false,\n        error: 'INVALID_TOKEN',\n        message: '令牌无效或已过期'\n      });\n    }\n    req.user = user;\n    next();\n  });\n};\n\n// 用户认证路由\napp.post('/api/auth/register', async (req, res) => {\n  try {\n    const { username, email, password } = req.body;\n\n    if (!username || !email || !password) {\n      return res.status(400).json({\n        success: false,\n        error: 'MISSING_FIELDS',\n        message: '用户名、邮箱和密码都是必填字段'\n      });\n    }\n\n    const existingUser = await User.findOne({\n      $or: [{ username }, { email }]\n    });\n\n    if (existingUser) {\n      return res.status(409).json({\n        success: false,\n        error: 'USER_EXISTS',\n        message: '用户名或邮箱已被注册'\n      });\n    }\n\n    const user = new User({ username, email, password });\n    await user.save();\n\n    const token = jwt.sign(\n      { userId: user.userId, username: user.username },\n      process.env.JWT_SECRET || 'your-secret-key',\n      { expiresIn: '24h' }\n    );\n\n    res.status(201).json({\n      success: true,\n      message: '用户注册成功',\n      data: {\n        user: {\n          userId: user.userId,\n          username: user.username,\n          email: user.email\n        },\n        token\n      }\n    });\n\n  } catch (error) {\n    console.error('注册错误:', error);\n    res.status(500).json({\n      success: false,\n      error: 'SERVER_ERROR',\n      message: '服务器内部错误'\n    });\n  }\n});\n\napp.post('/api/auth/login', async (req, res) => {\n  try {\n    const { username, password } = req.body;\n\n    if (!username || !password) {\n      return res.status(400).json({\n        success: false,\n        error: 'MISSING_CREDENTIALS',\n        message: '用户名和密码是必填的'\n      });\n    }\n\n    const user = await User.findOne({ username });\n    if (!user) {\n      return res.status(401).json({\n        success: false,\n        error: 'INVALID_CREDENTIALS',\n        message: '用户名或密码错误'\n      });\n    }\n\n    const isPasswordValid = await bcrypt.compare(password, user.password);\n    if (!isPasswordValid) {\n      return res.status(401).json({\n        success: false,\n        error: 'INVALID_CREDENTIALS',\n        message: '用户名或密码错误'\n      });\n    }\n\n    const token = jwt.sign(\n      { userId: user.userId, username: user.username },\n      process.env.JWT_SECRET || 'your-secret-key',\n      { expiresIn: '24h' }\n    );\n\n    res.json({\n      success: true,\n      message: '登录成功',\n      data: {\n        user: {\n          userId: user.userId,\n          username: user.username,\n          email: user.email\n        },\n        token\n      }\n    });\n\n  } catch (error) {\n    console.error('登录错误:', error);\n    res.status(500).json({\n      success: false,\n      error: 'SERVER_ERROR',\n      message: '服务器内部错误'\n    });\n  }\n});\n\n// 自动化机器学习项目路由\napp.post('/api/automl/projects', authenticateToken, async (req, res) => {\n  try {\n    const { name, description, projectType, dataType, datasetUrl, targetColumn, parameters } = req.body;\n\n    if (!name || !projectType || !dataType) {\n      return res.status(400).json({\n        success: false,\n        error: 'MISSING_REQUIRED_FIELDS',\n        message: '项目名称、类型和数据类型是必填字段'\n      });\n    }\n\n    const project = new Project({\n      userId: req.user.userId,\n      name,\n      description,\n      projectType,\n      dataType,\n      datasetUrl,\n      targetColumn,\n      parameters\n    });\n\n    await project.save();\n\n    res.status(201).json({\n      success: true,\n      data: {\n        projectId: project.projectId,\n        name: project.name,\n        status: project.status,\n        createdAt: project.createdAt\n      },\n      message: '项目创建成功'\n    });\n\n  } catch (error) {\n    console.error('创建项目错误:', error);\n    res.status(500).json({\n      success: false,\n      error: 'SERVER_ERROR',\n      message: '服务器内部错误'\n    });\n  }\n});\n\napp.get('/api/automl/projects', authenticateToken, async (req, res) => {\n  try {\n    const { page = 1, limit = 20, status } = req.query;\n    const skip = (page - 1) * limit;\n\n    const filter = { userId: req.user.userId };\n    if (status) filter.status = status;\n\n    const projects = await Project.find(filter)\n      .skip(skip)\n      .limit(parseInt(limit))\n      .sort({ createdAt: -1 });\n\n    const total = await Project.countDocuments(filter);\n\n    res.json({\n      success: true,\n      data: projects.map(project => ({\n        projectId: project.projectId,\n        name: project.name,\n        description: project.description,\n        projectType: project.projectType,\n        dataType: project.dataType,\n        status: project.status,\n        progress: project.progress,\n        createdAt: project.createdAt\n      })),\n      pagination: {\n        page: parseInt(page),\n        limit: parseInt(limit),\n        total\n      }\n    });\n\n  } catch (error) {\n    console.error('获取项目列表错误:', error);\n    res.status(500).json({\n      success: false,\n      error: 'SERVER_ERROR',\n      message: '服务器内部错误'\n    });\n  }\n});\n\napp.get('/api/automl/projects/:projectId', authenticateToken, async (req, res) => {\n  try {\n    const { projectId } = req.params;\n\n    const project = await Project.findOne({ \n      projectId, \n      userId: req.user.userId \n    });\n\n    if (!project) {\n      return res.status(404).json({\n        success: false,\n        error: 'PROJECT_NOT_FOUND',\n        message: '项目不存在'\n      });\n    }\n\n    res.json({\n      success: true,\n      data: {\n        projectId: project.projectId,\n        name: project.name,\n        description: project.description,\n        projectType: project.projectType,\n        dataType: project.dataType,\n        status: project.status,\n        progress: project.progress,\n        parameters: project.parameters,\n        datasetUrl: project.datasetUrl,\n        targetColumn: project.targetColumn,\n        results: project.results,\n        createdAt: project.createdAt,\n        updatedAt: project.updatedAt\n      }\n    });\n\n  } catch (error) {\n    console.error('获取项目详情错误:', error);\n    res.status(500).json({\n      success: false,\n      error: 'SERVER_ERROR',\n      message: '服务器内部错误'\n    });\n  }\n});\n\napp.post('/api/automl/projects/:projectId/execute', authenticateToken, async (req, res) => {\n  try {\n    const { projectId } = req.params;\n\n    const project = await Project.findOne({ \n      projectId, \n      userId: req.user.userId \n    });\n\n    if (!project) {\n      return res.status(404).json({\n        success: false,\n        error: 'PROJECT_NOT_FOUND',\n        message: '项目不存在'\n      });\n    }\n\n    if (project.status === 'running') {\n      return res.status(409).json({\n        success: false,\n        error: 'PROJECT_ALREADY_RUNNING',\n        message: '项目已在执行中'\n      });\n    }\n\n    // 更新项目状态为运行中\n    project.status = 'running';\n    project.progress = 10;\n    await project.save();\n\n    // 这里可以添加实际的AutoML执行逻辑\n    // 模拟异步执行\n    setTimeout(async () => {\n      project.progress = 100;\n      project.status = 'completed';\n      project.results = {\n        accuracy: 0.95,\n        trainingTime: '2h30m',\n        modelType: 'random_forest',\n        features: ['feature1', 'feature2', 'feature3']\n      };\n      await project.save();\n    }, 5000);\n\n    res.status(202).json({\n      success: true,\n      message: '项目已开始执行',\n      operationId: uuidv4()\n    });\n\n  } catch (error) {\n    console.error('执行项目错误:', error);\n    res.status(500).json({\n      success: false,\n      error: 'SERVER_ERROR',\n      message: '服务器内部错误'\n    });\n  }\n});\n\n// OpenAPI规范修复路由\napp.post('/api/repair', authenticateToken, async (req, res) => {\n  try {\n    const { openapi_spec, fix_strategy = 'smart' } = req.body;\n\n    if (!openapi_spec) {\n      return res.status(400).json({\n        success: false,\n        error: 'MISSING_OPENAPI_SPEC',\n        message: 'OpenAPI规范内容是必填字段'\n      });\n    }\n\n    // 这里实现OpenAPI规范修复逻辑\n    const fixesApplied = [];\n    let repairedSpec = openapi_spec;\n\n    // 修复URL前缀不一致问题\n    if (openapi_spec.includes('/v2/') || openapi_spec.includes('/v3/')) {\n      fixesApplied.push({\n        error_type: 'URL_PREFIX_INCONSISTENCY',\n        description: 'API URL 前缀不一致',\n        location: 'paths',\n        fix_applied: '统一所有路径使用 /api/v1 前缀'\n      });\n      repairedSpec = repairedSpec.replace(/\\/v[2-9]\\//g, '/v1/');\n    }\n\n    // 修复参数验证问题\n    if (openapi_spec.includes('parameters:')) {\n      fixesApplied.push({\n        error_type: 'INVALID_PARAMETER',\n        description: '参数缺少类型定义',\n        location: 'parameters',\n        fix_applied: '为所有参数添加完整的类型定义'\n      });\n    }\n\n    res.json({\n      success: true,\n      repaired_spec: repairedSpec,\n      fixes_applied: fixesApplied,\n      warnings: []\n    });\n\n  } catch (error) {\n    console.error('修复OpenAPI规范错误:', error);\n    res.status(500).json({\n      success: false,\n      error: 'SERVER_ERROR',\n      message: '服务器内部错误'\n    });\n  }\n});\n\n// 工作流执行路由\napp.post('/api/workflow/execute', authenticateToken, async (req, res) => {\n  try {\n    const { workflow_id, parameters } = req.body;\n\n    if (!workflow_id || !parameters) {\n      return res.status(400).json({\n        success: false,\n        error: 'MISSING_REQUIRED_FIELDS',\n        message: '工作流ID和参数是必填字段'\n      });\n    }\n\n    // 创建工作流执行记录\n    const workflow = new Workflow({\n      userId: req.user.userId,\n      name: `Execution_${workflow_id}_${Date.now()}`,\n      definition: { workflow_id, parameters },\n      status: 'active'\n    });\n\n    await workflow.save();\n\n    // 模拟工作流执行\n    setTimeout(async () => {\n      workflow.status = 'completed';\n      workflow.executions.push({\n        executionId: uuidv4(),\n        status: 'success',\n        result: { accuracy: 0.95, training_time: '2h30m' },\n        completedAt: new Date()\n      });\n      await workflow.save();\n    }, 3000);\n\n    res.json({\n      status: 'success',\n      result: {\n        workflowExecutionId: workflow.workflowId,\n        message: '工作流已开始执行'\n      }\n    });\n\n  } catch (error) {\n    console.error('执行工作流错误:', error);\n    res.status(500).json({\n      success: false,\n      error: 'SERVER_ERROR',\n      message: '服务器内部错误'\n    });\n  }\n});\n\n// 健康检查端点\napp.get('/api/health', (req, res) => {\n  res.json({\n    status: 'healthy',\n    timestamp: new Date().toISOString(),\n    version: '12.1.0',\n    services: {\n      database: 'connected',\n      authentication: 'active',\n      automl: 'running',\n      workflow: 'active'\n    }\n  });\n});\n\n// 错误处理中间件\napp.use((err, req, res, next) => {\n  console.error('未处理的错误:', err);\n  res.status(500).json({\n    success: false,\n    error: 'INTERNAL_SERVER_ERROR',\n    message: '服务器内部错误'\n  });\n});\n\n// 404处理\napp.use('*', (req, res) => {\n  res.status(404).json({\n    success: false,\n    error: 'ENDPOINT_NOT_FOUND',\n    message: '请求的端点不存在'\n  });\n});\n\n// 启动服务器\nconst PORT = process.env.PORT || 3000;\napp.listen(PORT, () => {\n  console.log(`全场景智能自动化超级中枢服务器运行在端口 ${PORT}`);\n  console.log(`API文档: http://localhost:${PORT}/api-docs`);\n  console.log(`健康检查: http://localhost:${PORT}/api/health`);\n});\n\nmodule.exports = app;\n```\n\n📁 完整项目结构\n\n```\nautomation-hub/\n├── server.js                 # 主服务器文件\n├── package.json              # 项目依赖配置\n├── .env                      # 环境变量配置\n├── config/                   # 配置文件目录\n│   ├── database.js           # 数据库配置\n│   ├── auth.js               # 认证配置\n│   └── constants.js          # 常量定义\n├── models/                   # 数据模型目录\n│   ├── User.js               # 用户模型\n│   ├── Project.js            # 项目模型\n│   ├── Workflow.js           # 工作流模型\n│   └── index.js              # 模型导出\n├── route