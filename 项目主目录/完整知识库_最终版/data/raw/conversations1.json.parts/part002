"string\"},\n                \"coze_registered\": {\"type\": \"boolean\"},\n                \"registration_id\": {\"type\": \"string\"},\n                \"full_config\": {\"type\": \"object\"},\n                \"ai_analysis\": {\"type\": \"string\"},\n                \"fallback_mode\": {\"type\": \"boolean\"},\n                \"error_message\": {\"type\": \"string\"}\n              }\n            }\n          }\n        },\n        {\n          \"id\": \"quantum_executor\",\n          \"type\": \"code\",\n          \"name\": \"量子工作流执行器\",\n          \"description\": \"执行生成的插件工作流，支持自动重试和降级处理\",\n          \"config\": {\n            \"runtime\": \"nodejs18.x\",\n            \"timeout\": 120000,\n            \"code\": \"async function executeWorkflow(pluginConfig, fixedInput, repairSummary) {\\n  const startTime = Date.now();\\n  let executionStatus = 'completed';\\n  let attemptCount = 1;\\n  let finalResult = null;\\n  \\n  try {\\n    // 尝试执行插件\\n    if (pluginConfig.coze_registered) {\\n      // 使用注册的Coze插件\\n      finalResult = await coze.plugins.run({\\n        plugin_id: pluginConfig.id,\\n        params: {\\n          input: fixedInput.user_demand,\\n          context: {\\n            trigger_node: fixedInput.trigger_node_id,\\n            repair_level: fixedInput.auto_repair_level,\\n            workflow_id: fixedInput.workflow_id\\n          }\\n        },\\n        timeout: 60000\\n      });\\n    } else {\\n      // 本地执行模式\\n      finalResult = {\\n        status: 'success',\\n        data: {\\n          message: '插件执行完成（本地模式）',\\n          input: fixedInput.user_demand,\\n          processed_at: new Date().toISOString(),\\n          workflow_context: {\\n            workflow_id: fixedInput.workflow_id,\\n            execution_mode: 'local_fallback'\\n          }\\n        }\\n      };\\n    }\\n    \\n  } catch (error) {\\n    console.error('首次执行失败:', error);\\n    \\n    // 根据修复级别决定重试策略\\n    if (fixedInput.auto_repair_level !== 'basic') {\\n      attemptCount++;\\n      \\n      try {\\n        // 降级重试：使用简化参数\\n        finalResult = await coze.plugins.run({\\n          plugin_id: pluginConfig.id,\\n          params: {\\n            input: fixedInput.user_demand.substring(0, 100), // 截断长输入\\n            simple_mode: true,\\n            auto_repaired: true,\\n            repair_attempt: attemptCount\\n          },\\n          timeout: 30000\\n        });\\n        \\n        executionStatus = 'completed_after_repair';\\n        \\n      } catch (retryError) {\\n        console.error('重试执行失败:', retryError);\\n        \\n        // 最终降级处理\\n        finalResult = {\\n          status: 'partial_success',\\n          error: retryError.message,\\n          data: {\\n            message: '执行完成但有错误',\\n            original_input: fixedInput.user_demand,\\n            fallback_result: '由于执行错误，返回降级结果',\\n            suggestion: '请检查插件配置或重试',\\n            repair_summary: repairSummary\\n          }\\n        };\\n        \\n        executionStatus = 'partial_success';\\n      }\\n    } else {\\n      // 基础模式不重试\\n      finalResult = {\\n        status: 'error',\\n        error: error.message,\\n        data: {\\n          message: '执行失败',\\n          suggestion: '请启用高级修复功能或检查输入'\\n        }\\n      };\\n      executionStatus = 'failed';\\n    }\\n  }\\n  \\n  const executionTime = Date.now() - startTime;\\n  \\n  return {\\n    status: executionStatus,\\n    result: finalResult,\\n    trigger_node_id: fixedInput.trigger_node_id,\\n    execution_time_ms: executionTime,\\n    attempt_count: attemptCount,\\n    plugin_id: pluginConfig.id,\\n    timestamp: new Date().toISOString()\\n  };\\n}\",\n            \"input_schema\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"plugin_config\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"id\": {\"type\": \"string\"},\n                    \"name\": {\"type\": \"string\"},\n           