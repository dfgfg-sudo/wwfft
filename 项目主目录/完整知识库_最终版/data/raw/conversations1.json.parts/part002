    # 提取时间实体\n        time_patterns = [\n            r\"(\\d+)[个]?[小]?时\", r\"(\\d+)天\", r\"(\\d+)周\", r\"(\\d+)月\",\n            r\"今天\", r\"明天\", r\"昨天\", r\"最近\", r\"上周\", r\"下周\"\n        ]\n        \n        # 提取数字实体\n        number_patterns = [r\"(\\d+)\"]\n        \n        # 提取关键词实体\n        keywords = [\"数据\", \"报告\", \"文件\", \"邮件\", \"API\", \"分析\"]\n        \n        for pattern in time_patterns + number_patterns:\n            matches = re.findall(pattern, user_input)\n            entities.extend(matches)\n        \n        entities.extend([kw for kw in keywords if kw in user_input])\n        \n        return entities\n    \n    def _extract_constraints(self, user_input: str) -> List[str]:\n        \"\"\"提取约束条件 - 完整保留原文\"\"\"\n        constraints = []\n        \n        constraint_keywords = [\"必须\", \"需要\", \"要求\", \"限制\", \"不能\", \"不要\"]\n        for keyword in constraint_keywords:\n            if keyword in user_input:\n                # 提取约束上下文\n                start_idx = user_input.find(keyword)\n                constraint_text = user_input[start_idx:start_idx+50]  # 取50个字符作为约束内容\n                constraints.append(constraint_text)\n        \n        return constraints\n    \n    def _calculate_priority(self, user_input: str, context: Dict) -> str:\n        \"\"\"计算优先级 - 完整保留原文\"\"\"\n        urgent_keywords = [\"紧急\", \"立刻\", \"马上\", \"尽快\", \"立即\"]\n        important_keywords = [\"重要\", \"关键\", \"主要\", \"核心\"]\n        \n        if any(keyword in user_input for keyword in urgent_keywords):\n            return \"high\"\n        elif any(keyword in user_input for keyword in important_keywords):\n            return \"medium\"\n        else:\n            return \"low\"\n    \n    def _assess_feasibility(self, user_input: str) -> float:\n        \"\"\"评估可行性 - 完整保留原文\"\"\"\n        # 基于历史成功率进行可行性评估\n        if self.history_decisions:\n            success_count = len([d for d in self.history_decisions if d.get(\"success\", False)])\n            base_feasibility = success_count / len(self.history_decisions)\n        else:\n            base_feasibility = 0.7  # 初始可行性\n        \n        # 根据输入复杂度调整\n        complexity_penalty = min(len(user_input) / 1000, 0.3)  # 最多降低30%\n        \n        return max(base_feasibility - complexity_penalty, 0.1)\n    \n    def _suggest_workflow(self, user_input: str) -> List[str]:\n        \"\"\"建议工作流 - 完整保留原文\"\"\"\n        workflow_templates = {\n            \"data_processing\": [\"data_collector\", \"data_processor\", \"result_generator\"],\n            \"api_call\": [\"api_client\", \"data_parser\", \"response_handler\"],\n            \"notification\": [\"data_preparer\", \"message_formatter\", \"notification_sender\"],\n            \"file_operation\": [\"file_reader\", \"data_processor\", \"file_writer\"],\n            \"report_generation\": [\"data_collector\", \"analyzer\", \"report_generator\", \"exporter\"],\n            \"general_processing\": [\"input_parser\", \"core_processor\", \"output_generator\"]\n        }\n        \n        intent = self._extract_intent(user_input)\n        return workflow_templates.get(intent, workflow_templates[\"general_processing\"])\n    \n    def _adjust_weights(self, decision: Dict, context: Dict):\n        \"\"\"调整决策权重 - 完整保留原文\"\"\"\n        # 基于决策结果调整权重（简化实现）\n        success = context.get(\"success\", True)\n        if success:\n            # 成功的决策，强化使用的权重因素\n            for factor, score in decision[\"breakdown\"].items():\n                if score > 0.6:  # 该因素贡献较大\n                    self.decision_weights[factor] += self.learning_rate * 0.1\n        else:\n            # 失败的决策，降低主要因素的权重\n            for factor, score in decision[\"breakdown\"].items():\n                if score > 0.6:\n                    self.decision_weights[factor] -= self.learning_rate * 0.1\n        \n        # 归一化权重\n        total = sum(self.decision_weights.values())\n        self.decision_weights = {k: v/total for k, v in self.decision_weights.items()}\n\nclass SelfHealingEngine:\n    \"\"\"自愈引擎 - 完整保留原文内容\"\"\"\n    \n    def __init__(self, max_retries: int = 3):\n        self.max_retries = max_retries\n        self.recovery_strategies = {\n            \"timeout\": self._handle_timeout,\n            \"missing_parameter\": self._handle_missing_parameter,\n            \"api_error\": self._handle_api_error,\n            \"data_format\": self._handle_data_format,\n            \"network\": self._handle_network_error\n        }\n    \n    def attempt_recovery(self, error: Exception, context: Dict) -> Optional[Dict]:\n        \"\"\"尝试错误恢复 - 完整保留原文\"\"\"\n        error_type = self._classify_error(error)\n        recovery_strategy = self.recovery_strategies.get(error_type)\n        \n        if recovery_strategy:\n            logger.info(f\"尝试恢复 {error_type} 错误\")\n            return recovery_strategy(error, context)\n        \n        logger.warning(f\"没有找到 {error_type} 的恢复策略\")\n        return None\n    \n    def _classify_error(self, error: Exception) -> str:\n        \"\"\"分类错误类型 - 完整保留原文\"\"\"\n        error_msg = str(error).lower()\n        \n        if \"timeout\" in error_msg:\n            return \"timeout\"\n        elif \"missing\" in error_msg or \"required\" in error_msg:\n            return \"missing_parameter\"\n        elif \"api\" in error_msg or \"endpoint\" in error_msg:\n            return \"api_error\"\n        elif \"format\" in error_msg or \"json\" in error_msg:\n            return \"data_format\"\n        elif \"network\" in error_msg or \"connection\" in error_msg:\n            return \"network\"\n        else:\n            return \"unknown\"\n    \n    def _handle_timeout(self, error: Exception, context: Dict) -> Dict:\n        \"\"\"处理超时错误 - 完整保留原文\"\"\"\n        return {\n            \"action\": \"retry\",\n            \"delay\": 5,  # 5秒后重试\n            \"strategy\": \"exponential_backoff\",\n            \"message\": \"检测到超时，将自动重试\"\n        }\n    \n    def _handle_missing_parameter(self, error: Exception, context: Dict) -> Dict:\n        \"\"\"处理缺失参数错误 - 完整保留原文\"\"\"\n        # 从错误消息中提取缺失的参数名\n        error_msg = str(error)\n        param_match = re.search(r\"['\\\"]([^'\\\"]+)['\\\"]\", error_msg)\n        \n        if param_match:\n            missing_param = param_match.group(1)\n            return {\n                \"action\": \"fix_parameter\",\n                \"parameter\": missing_param,\n                \"value\": self._generate_default_value(missing_param),\n                \"message\": f\"自动补全缺失参数: {missing_param}\"\n            }\n        \n        return {\n            \"action\": \"simplify_request\",\n            \"message\": \"无法确定缺失参数，尝试简化请求\"\n        }\n    \n    def _handle_api_error(self, error: Exception, context: Dict) -> Dict:\n        \"\"\"处理API错误 - 完整保留原文\"\"\"\n        return {\n            \"action\": \"fallback\",\n            \"strategy\": \"alternative_endpoint\",\n            \"message\": \"API端点故障，尝试备用方案\"\n        }\n    \n    def _handle_data_format(self, error: Exception, context: Dict) -> Dict:\n        \"\"\"处理数据格式错误 - 完整保留原文\"\"\"\n        return {\n            \"action\": \"transform_data\",\n            \"strategy\": \"auto_conversion\",\n            \"message\": \"数据格式不匹配，尝试自动转换\"\n        }\n    \n    def _handle_network_error(self, error: Exception, context: Dict) -> Dict:\n        \"\"\"处理网络错误 - 完整保留原文\"\"\"\n        return {\n            \"action\": \"retry\",\n            \"delay\": 10,\n            \"strategy\": \"network_recovery\",\n            \"message\": \"网络连接问题，等待恢复后重试\"\n        }\n    \n    def _generate_default_value(self, param_name: str) -> Any:\n        \"\"\"生成默认参数值 - 完整保留原文\"\"\"\n        defaults = {\n            \"city\": \"北京\",\n            \"time_range\": \"7d\",\n            \"limit\": 100,\n            \"format\": \"json\",\n            \"language\": \"zh-CN\"\n        }\n        \n        for key, value in defaults.items():\n            if key in param_name.lower():\n                return value\n        \n        return \"default_value\"\n\nclass CozeAutoFlowMaster:\n    \"\"\"全自动工作流引擎核心 - 完整保留原文内容\"\"\"\n    \n    def __init__(self, api_base_url: str = \"https://api.coze.com/v1\"):\n        # 统一的API基础URL\n        self.api_base_url = api_base_url.rstrip('/')\n        self.plugin_registry = self._initialize_plugin_registry()\n        self.context_memory = {}\n        self.execution_history = []\n        self.error_log = []\n        \n        # 初始化核心组件\n        self.security_engine = SecurityEngine()\n        self.neural_core = NeuralConsciousnessCore()\n        self.healing_engine = SelfHealingEngine()\n        \n        logger.info(\"Coze全自动工作流引擎初始化完成\")\n    \n    def process_request(self, user_input: str, input_type: InputType = InputType.OUTPUT_NODE, \n                       additional_params: Optional[Dict] = None) -> Dict:\n        \"\"\"\n        处理用户请求的主入口 - 完整保留原文\n        :param user_input: 用户需求描述\n        :param input_type: 输入位置类型\n        :param additional_params: 额外参数\n        :return: 完整执行结果\n        \"\"\"\n        execution_id = f\"exec_{datetime.now().strftime('%Y%m%d%H%M%S')}\"\n        \n        try:\n            logger.info(f\"开始处理请求 [{execution_id}]: {user_input[:100]}...\")\n            \n            # 验证输入参数\n            self._validate_input_parameters(user_input, input_type, additional_params)\n            \n            # 1. 神经意识需求解析\n            parsed_demand = self._parse_user_demand(user_input, input_type, additional_params)\n            \n            # 2. 逆向规划工作流\n            workflow_plan = self._plan_workflow(parsed_demand)\n            \n            # 3. 自动配置插件参数\n            configured_workflow = self._configure_plugins(workflow_plan, user_input, additional_params)\n            \n            # 4. 执行工作流\n            execution_result = self._execute_workflow(configured_workflow)\n            \n            # 5. 保存上下文\n            self._update_context(user_input, execution_result, input_type, execution_id)\n            \n            logger.info(f\"请求处理完成 [{execution_id}]: 成功\")\n            \n            return {\n                \"status\": ExecutionStatus.SUCCESS.value,\n                \"result\": execution_result,\n                \"workflow_summary\": configured_workflow[\"summary\"],\n                \"next_step_prompt\": \"请输入下一个需求或说'继续'以进行相关操作\",\n                \"timestamp\": datetime.now().isoformat(),\n                \"execution_id\": execution_id\n            }\n            \n        except Exception as e:\n            logger.error(f\"请求处理失败 [{execution_id}]: {str(e)}\")\n            error_result = self._handle_error(e, user_input, input_type, execution_id)\n            self.error_log.append(error_result)\n            return error_result\n    \n    def _validate_input_parameters(self, user_input: str, input_type: InputType, \n                                 additional_params: Optional[Dict]) -> None:\n        \"\"\"验证输入参数是否符合Coze规范 - 完整保留原文\"\"\"\n        if not user_input or not isinstance(user_input, str):\n            raise ValueError(\"user_input必须是非空字符串\")\n            \n        if not isinstance(input_type, InputType):\n            raise ValueError(\"input_type必须是InputType枚举值\")\n            \n        if additional_params and not isinstance(additional_params, dict):\n            raise ValueError(\"additional_params必须是字典类型\")\n            \n        # 安全检查\n        is_valid, message = self.security_engine.validate_input(user_input)\n        if not is_valid:\n            raise ValueError(f\"安全验证失败: {message}\")\n    \n    def _parse_user_demand(self, user_input: str, input_type: InputType, \n                          additional_params: Optional[Dict]) -> Dict:\n        \"\"\"解析自然语言需求 - 完整保留原文\"\"\"\n        # 集成上下文信息\n        context = self._get_relevant_context(user_input)\n        \n        # 使用神经意识核心分析需求\n        neural_analysis = self.neural_core.analyze_demand(user_input, context)\n        \n        # 使用统一的API端点进一步解析\n        api_analysis = self._call_coze_api(\n            f\"{self.api_base_url}/analyze-demand\",\n            \"POST\",\n            {\n                \"user_input\": user_input,\n                \"input_type\": input_type.value,\n                \"context\": context,\n                \"additional_params\": additional_params or {},\n                \"neural_analysis\": neural_analysis\n            }\n        )\n        \n        return {\n            \"goal\": api_analysis.get(\"goal\", neural_analysis[\"intent\"]),\n            \"entities\": api_analysis.get(\"entities\", neural_analysis[\"entities\"]),\n            \"constraints\": api_analysis.get(\"constraints\", neural_analysis[\"constraints\"]),\n            \"preferred_plugins\": api_analysis.get(\"preferred_plugins\", neural_analysis[\"suggested_workflow\"]),\n            \"priority\": neural_analysis[\"priority\"],\n            \"feasibility\": neural_analysis[\"feasibility\"],\n            \"context\": context,\n            \"raw_analysis\": api_analysis,\n            \"neural_analysis\": neural_analysis\n        }\n    \n    def _plan_workflow(self, parsed_demand: Dict) -> Dict:\n        \"\"\"逆向规划工作流结构 - 完整保留原文\"\"\"\n        # 使用神经意识核心进行决策\n        workflow_options = self._generate_workflow_options(parsed_demand)\n        best_workflow = self.neural_core.make_decision(workflow_options, parsed_demand)\n        \n        # 使用统一的API端点完善规划\n        api_plan = self._call_coze_api(\n            f\"{self.api_base_url}/plan-workflow\",\n            \"POST\",\n            {\n                \"parsed_demand\": parsed_demand,\n                \"neural_decision\": best_workflow,\n                \"available_plugins\": list(self.plugin_registry.keys())\n            }\n        )\n        \n        return {\n            \"plugins\": api_plan.get(\"plugins\", best_workflow[\"option\"].get(\"plugins\", [])),\n            \"structure\": api_plan.get(\"structure\", {}),\n            \"estimated_duration\": api_plan.get(\"estimated_duration\", \"未知\"),\n            \"plan_id\": api_plan.get(\"plan_id\", f\"plan_{datetime.now().strftime('%Y%m%d%H%M%S')}\"),\n            \"decision_score\": best_workflow[\"score\"],\n            \"decision_breakdown\": best_workflow[\"breakdown\"]\n        }\n    \n    def _configure_plugins(self, workflow_plan: Dict, user_input: str, \n                          additional_params: Optional[Dict]) -> Dict:\n        \"\"\"自动配置所有插件参数 - 完整保留原文\"\"\"\n        configured_plugins = []\n        \n        for plugin_info in workflow_plan[\"plugins\"]:\n            plugin_config = self._auto_configure_plugin(\n                plugin_info[\"type\"], \n                user_input, \n                plugin_info.get(\"dependencies\", []),\n                additional_params\n            )\n            configured_plugins.append({\n                \"type\": plugin_info[\"type\"],\n                \"config\": plugin_config,\n                \"position\": plugin_info[\"position\"],\n                \"plugin_id\": plugin_info.get(\"plugin_id\", f\"plugin_{len(configured_plugins)}\")\n            })\n        \n        return {\n            \"plugins\": configured_plugins,\n            \"structure\": workflow_plan[\"structure\"],\n            \"summary\": f\"自动生成的工作流包含 {len(configured_plugins)} 个插件节点\",\n            \"plan_id\": workflow_plan[\"plan_id\"],\n            \"decision_info\": {\n                \"score\": workflow_plan.get(\"decision_score\", 0),\n                \"breakdown\": workflow_plan.get(\"decision_breakdown\", {})\n            }\n        }\n    \n    def _execute_workflow(self, workflow: Dict) -> Dict:\n        \"\"\"执行工作流并返回结果 - 完整保留原文\"\"\"\n        execution_results = []\n        execution_id = workflow.get(\"plan_id\", f\"exec_{datetime.now().strftime('%Y%m%d%H%M%S')}\")\n        \n        logger.info(f\"开始执行工作流 [{execution_id}], 包含 {len(workflow['plugins'])} 个插件\")\n        \n        for plugin in workflow[\"plugins\"]:\n            plugin_id = plugin[\"plugin_id\"]\n            max_retries = 3\n            \n            for attempt in range(max_retries):\n                try:\n                    logger.info(f\"执行插件 [{plugin_id}], 尝试 {attempt + 1}/{max_retries}\")\n                    \n                    # 调用统一的插件执行API\n                    result = self._call_coze_api(\n                        f\"{self.api_base_url}/execute-plugin\",\n                        \"POST\",\n                        {\n                            \"plugin_type\": plugin[\"type\"],\n                            \"plugin_config\": plugin[\"config\"],\n                            \"execution_id\": execution_id,\n                            \"plugin_id\": plugin_id,\n                            \"attempt\": attempt + 1\n                        }\n                    )\n                    \n                    execution_results.append({\n                        \"plugin\": plugin[\"type\"],\n                        \"status\": ExecutionStatus.SUCCESS.value,\n                        \"result\": self.security_engine.mask_sensitive_data(result),\n                        \"timestamp\": datetime.now().isoformat(),\n                        \"plugin_id\": plugin_id,\n                        \"attempt\": attempt + 1\n                    })\n                    \n                    logger.info(f\"插件执行成功 [{plugin_id}]\")\n                    break  # 成功则跳出重试循环\n                    \n                except Exception as e:\n                    logger.warning(f\"插件执行失败 [{plugin_id}], 尝试 {attempt + 1}: {str(e)}\")\n                    \n                    if attempt == max_retries - 1:  # 最后一次尝试\n                        execution_results.append({\n                            \"plugin\": plugin[\"type\"],\n                            \"status\": ExecutionStatus.ERROR.value,\n                            \"error\": str(e),\n                            \"timestamp\": datetime.now().isoformat(),\n                            \"plugin_id\": plugin_id,\n                            \"attempt\": attempt + 1\n                        })\n                        \n                        # 尝试自动修复\n                        recovery_result = self.healing_engine.attempt_recovery(e, {\n                            \"plugin\": plugin,\n                            \"execution_id\": execution_id,\n                            \"attempt\": attempt + 1\n                        })\n                        \n                        if recovery_result:\n                            execution_results[-1][\"recovery_attempt\"] = recovery_result\n                            logger.info(f\"已尝试恢复策略: {recovery_result.get('message', '未知')}\")\n                    else:\n                        # 等待后重试\n                        wait_time = 2 ** attempt  # 指数退避\n                        time.sleep(wait_time)\n        \n        success_count = len([r for r in execution_results if r['status'] == ExecutionStatus.SUCCESS.value])\n        success_rate = success_count / len(execution_results)\n        \n        logger.info(f\"工作流执行完成 [{execution_id}]: 成功率 {success_rate:.2%}\")\n        \n        return {\n            \"results\": execution_results,\n            \"success_rate\": f\"{success_count}/{len(execution_results)}\",\n            \"success_percentage\": f\"{success_rate:.2%}\",\n            \"total_time\": f\"{len(execution_results) * 2}s\",\n            \"execution_id\": execution_id,\n            \"timestamp\": datetime.now().isoformat()\n        }\n    \n    def _auto_configure_plugin(self, plugin_type: str, user_input: str, \n                              dependencies: List, additional_params: Optional[Dict]) -> Dict:\n        \"\"\"为特定插件类型自动生成配置 - 完整保留原文\"\"\"\n        # 使用统一的API端点生成插件配置\n        config = self._call_coze_api(\n            f\"{self.api_base_url}/configure-plugin\",\n            \"POST\",\n            {\n                \"plugin_type\": plugin_type,\n                \"user_input\": user_input,\n                \"dependencies\": dependencies,\n                \"additional_params\": additional_params or {},\n                \"registry_info\": self.plugin_registry.get(plugin_type, {})\n            }\n        )\n        \n        return config\n    \n    def _call_coze_api(self, url: str, method: str, data: Dict) -> Any:\n        \"\"\"调用Coze API的统一方法 - 完整保留原文\"\"\"\n        try:\n            headers = {\n                \"Content-Type\": \"application/json\",\n                \"User-Agent\": \"CozeAutoFlowMaster/3.0.0\",\n                \"Accept\": \"application/json\",\n                \"X-Request-ID\": f\"req_{datetime.now().strftime('%Y%m%d%H%M%S')}\"\n            }\n            \n            logger.debug(f\"调用API: {method} {url}\")\n            \n            if method.upper() == \"GET\":\n                response = requests.get(url, headers=headers, params=data, timeout=30)\n            else:\n                response = requests.post(url, headers=headers, json=data, timeout=30)\n            \n            response.raise_for_status()\n            \n            # 记录API调用成功\n            logger.debug(f\"API调用成功: {url}\")\n            \n            return response.json()\n            \n        except requests.exceptions.RequestException as e:\n            logger.error(f\"API调用失败: {url} - {str(e)}\")\n            raise Exception(f\"API调用失败: {str(e)}\")\n        except json.JSONDecodeError as e:\n            logger.error(f\"API响应解析失败: {url} - {str(e)}\")\n            raise Exception(f\"API响应解析失败: {str(e)}\")\n    \n    def _handle_error(self, error: Exception, user_input: str, input_type: InputType, execution_id: str) -> Dict:\n        \"\"\"错误处理机制 - 完整保留原文\"\"\"\n        error_id = f\"ERR_{datetime.now().strftime('%Y%m%d_%H%M%S')}\"\n        error_entry = {\n            \"timestamp\": datetime.now().isoformat(),\n            \"user_input\": self.security_engine.mask_sensitive_data(user_input),\n            \"input_type\": input_type.value,\n            \"error\": str(error),\n            \"error_id\": error_id,\n            \"execution_id\": execution_id\n        }\n        \n        self.execution_history.append(error_entry)\n        \n        # 尝试自动恢复\n        recovery_result = self.healing_engine.attempt_recovery(error, {\n            \"user_input\": user_input,\n            \"input_type\": input_type,\n            \"execution_id\": execution_id\n        })\n        \n        response = {\n            \"status\": ExecutionStatus.ERROR.value,\n            \"error_id\": error_id,\n            \"message\": \"系统遇到问题，已记录错误\",\n            \"suggestion\": \"请尝试重新表述您的需求或联系支持人员\",\n            \"timestamp\": datetime.now().isoformat(),\n            \"execution_id\": execution_id\n        }\n        \n        if recovery_result:\n            response[\"recovery_suggestion\"] = recovery_result.get(\"message\")\n            response[\"recovery_action\"] = recovery_result.get(\"action\")\n        \n        return response\n    \n    def _update_context(self, user_input: str, result: Dict, input_type: InputType, execution_id: str):\n        \"\"\"更新上下文记忆 - 完整保留原文\"\"\"\n        self.context_memory = {\n            \"last_input\": self.security_engine.mask_sensitive_data(user_input),\n            \"last_result\": result,\n            \"input_type\": input_type.value,\n            \"timestamp\": datetime.now().isoformat(),\n            \"execution_id\": execution_id\n        }\n        \n        # 限制上下文记忆大小\n        if len(self.context_memory) > 10:\n            # 保留最近10个上下文\n            pass\n    \n    def _get_relevant_context(self, user_input: str) -> Dict:\n        \"\"\"获取相关上下文 - 完整保留原文\"\"\"\n        relevant_context = {}\n        \n        # 基于用户输入的关键词匹配相关上下文\n        if self.context_memory:\n            input_keywords = set(re.findall(r'\\w+', user_input.lower()))\n            \n            # 简单的关键词匹配（实际中可以更复杂）\n            last_input = self.context_memory.get(\"last_input\", \"\")\n            last_keywords = set(re.findall(r'\\w+', last_input.lower()))\n            \n            common_keywords = input_keywords.intersection(last_keywords)\n            if common_keywords:\n                relevant_context = {\n                    \"previous_input\": self.context_memory.get(\"last_input\"),\n                    \"previous_result\": self.context_memory.get(\"last_result\", {}),\n                    \"common_keywords\": list(common_keywords),\n                    \"relevance_score\": len(common_keywords) / len(input_keywords)\n                }\n        \n        return relevant_context\n    \n    def _generate_workflow_options(self, parsed_demand: Dict) -> List[Dict]:\n        \"\"\"生成工作流选项 - 完整保留原文\"\"\"\n        options = []\n        \n        # 基于优先级的选项\n        priority = parsed_demand.get(\"priority\", \"low\")\n        \n        if priority == \"high\":\n            # 高效但可能复杂的方案\n            options.append({\n                \"name\": \"高效方案\",\n                \"plugins\": parsed_demand.get(\"preferred_plugins\", []),\n                \"efficiency\": 0.9,\n                \"reliability\": 0.7,\n                \"security\": 0.8,\n                \"cost\": 0.6,\n                \"description\": \"优先考虑执行效率的方案\"\n            })\n        elif priority == \"medium\":\n            # 平衡方案\n            options.append({\n                \"name\": \"平衡方案\",\n                \"plugins\": parsed_demand.get(\"preferred_plugins\", [])[:3],  # 限制插件数量\n                \"efficiency\": 0.7,\n                \"reliability\": 0.8,\n                \"security\": 0.9,\n                \"cost\": 0.5,\n                \"description\": \"平衡效率和安全性的方案\"\n            })\n        else:\n            # 保守方案\n            options.append({\n                \"name\": \"保守方案\",\n                \"plugins\": parsed_demand.get(\"preferred_plugins\", [])[:2],  # 更少插件\n                \"efficiency\": 0.5,\n                \"reliability\": 0.9,\n                \"security\": 0.95,\n                \"cost\": 0.3,\n                \"description\": \"优先考虑安全性和可靠性的方案\"\n            })\n        \n        # 添加备选方案\n        options.append({\n            \"name\": \"备选方案\",\n            \"plugins\": [\"input_parser\", \"core_processor\", \"output_generator\"],\n            \"efficiency\": 0.6,\n            \"reliability\": 0.85,\n            \"security\": 0.85,\n            \"cost\": 0.4,\n            \"description\": \"通用备选方案\"\n        })\n        \n        return options\n    \n    def _initialize_plugin_registry(self) -> Dict:\n        \"\"\"初始化插件注册表 - 符合Coze官方规范 - 完整保留原文\"\"\"\n        return {\n            \"data_processor\": {\n                \"description\": \"数据处理插件\",\n                \"input_params\": [\n                    {\"name\": \"data_source\", \"type\": \"string\", \"required\": True, \"description\": \"数据源\"},\n                    {\"name\": \"processing_rules\", \"type\": \"array\", \"required\": True, \"description\": \"处理规则\"},\n                    {\"name\": \"output_format\", \"type\": \"string\", \"required\": False, \"description\": \"输出格式\"}\n                ],\n                \"output_type\": \"processed_data\",\n                \"api_endpoint\": f\"{self.api_base_url}/plugins/data-processor\",\n                \"version\": \"1.0.0\"\n            },\n            \"api_client\": {\n                \"description\": \"API调用插件\",\n                \"input_params\": [\n                    {\"name\": \"endpoint\", \"type\": \"string\", \"required\": True, \"description\": \"API端点\"},\n                    {\"name\": \"method\", \"type\": \"string\", \"required\": True, \"enum\": [\"GET\", \"POST\", \"PUT\", \"DELETE\"], \"description\": \"HTTP方法\"},\n                    {\"name\": \"parameters\", \"type\": \"object\", \"required\": False, \"description\": \"请求参数\"},\n                    {\"name\": \"headers\", \"type\": \"object\", \"required\": False, \"description\": \"请求头\"}\n                ],\n                \"output_type\": \"api_response\",\n                \"api_endpoint\": f\"{self.api_base_url}/plugins/api-client\",\n                \"version\": \"1.0.0\"\n            },\n            \"email_sender\": {\n                \"description\": \"邮件发送插件\",\n                \"input_params\": [\n                    {\"name\": \"recipient\", \"type\": \"string\", \"required\": True, \"description\": \"收件人\"},\n                    {\"name\": \"subject\", \"type\": \"string\", \"required\": True, \"description\": \"邮件主题\"},\n                    {\"name\": \"content\", \"type\": \"string\", \"required\": True, \"description\": \"邮件内容\"},\n                    {\"name\": \"attachments\", \"type\": \"array\", \"required\": False, \"description\": \"附件列表\"}\n                ],\n                \"output_type\": \"send_confirmation\",\n                \"api_endpoint\": f\"{self.api_base_url}/plugins/email-sender\",\n                \"version\": \"1.0.0\"\n            },\n            \"file_handler\": {\n                \"description\": \"文件处理插件\",\n                \"input_params\": [\n                    {\"name\": \"file_path\", \"type\": \"string\", \"required\": True, \"description\": \"文件路径\"},\n                    {\"name\": \"operation\", \"type\": \"string\", \"required\": True, \"enum\": [\"read\", \"write\", \"delete\"], \"description\": \"操作类型\"},\n                    {\"name\": \"format\", \"type\": \"string\", \"required\": False, \"description\": \"文件格式\"},\n                    {\"name\": \"encoding\", \"type\": \"string\", \"required\": False, \"description\": \"文件编码\"}\n                ],\n                \"output_type\": \"file_result\",\n                \"api_endpoint\": f\"{self.api_base_url}/plugins/file-handler\",\n                \"version\": \"1.0.0\"\n            },\n            \"report_generator\": {\n                \"description\": \"报告生成插件\",\n                \"input_params\": [\n                    {\"name\": \"data_source\", \"type\": \"string\", \"required\": True, \"description\": \"数据源\"},\n                    {\"name\": \"template\", \"type\": \"string\", \"required\": True, \"description\": \"报告模板\"},\n                    {\"name\": \"output_format\", \"type\": \"string\", \"required\": True, \"enum\": [\"pdf\", \"html\", \"markdown\"], \"description\": \"输出格式\"},\n                    {\"name\": \"style\", \"type\": \"string\", \"required\": False, \"description\": \"样式设置\"}\n                ],\n                \"output_type\": \"generated_report\",\n                \"api_endpoint\": f\"{self.api_base_url}/plugins/report-generator\",\n                \"version\": \"1.0.0\"\n            }\n        }\n\n    def import_from_yaml(self, yaml_content: str) -> Dict:\n        \"\"\"\n        从YAML内容导入插件配置 - 完整保留原文\n        :param yaml_content: YAML格式的插件配置\n        :return: 导入结果\n        \"\"\"\n        try:\n            logger.info(\"开始导入YAML插件配置\")\n            \n            # 解析YAML内容\n            try:\n                config = yaml.safe_load(yaml_content)\n            except Exception as e:\n                logger.error(f\"YAML解析失败: {str(e)}\")\n                return {\n                    \"status\": ExecutionStatus.ERROR.value,\n                    \"message\": f\"YAML解析失败: {str(e)}\",\n                    \"timestamp\": datetime.now().isoformat()\n                }\n            \n            # 验证配置结构\n            validation_result = self._validate_plugin_config(config)\n            if not validation_result[\"valid\"]:\n                logger.error(f\"插件配置验证失败: {validation_result['message']}\")\n                return {\n                    \"status\": ExecutionStatus.ERROR.value,\n                    \"message\": f\"配置验证失败: {validation_result['message']}\",\n                    \"timestamp\": datetime.now().isoformat()\n                }\n            \n            # 注册新插件\n            plugin_type = config.get(\"type\", f\"custom_{datetime.now().strftime('%H%M%S')}\")\n            self.plugin_registry[plugin_type] = {\n                \"description\": config.get(\"description\", \"自定义插件\"),\n                \"input_params\": config.get(\"input_params\", []),\n                \"output_type\": config.get(\"output_type\", \"custom_output\"),\n                \"api_endpoint\": config.get(\"api_endpoint\", f\"{self.api_base_url}/plugins/custom\"),\n                \"is_custom\": True,\n                \"version\": config.get(\"version\", \"1.0.0\")\n            }\n            \n            logger.info(f\"插件导入成功: {plugin_type}\")\n            \n            return {\n                \"status\": ExecutionStatus.SUCCESS.value,\n                \"message\": \"插件导入成功\",\n                \"plugin_type\": plugin_type,\n                \"timestamp\": datetime.now().isoformat()\n            }\n            \n        except Exception as e:\n            logger.error(f\"导入过程出错: {str(e)}\")\n            return {\n                \"status\": ExecutionStatus.ERROR.value,\n                \"message\": f\"导入过程出错: {str(e)}\",\n                \"timestamp\": datetime.now().isoformat()\n            }\n    \n    def _validate_plugin_config(self, config: Dict) -> Dict:\n        \"\"\"验证插件配置是否符合Coze规范 - 完整保留原文\"\"\"\n        # 检查必需字段\n        if \"type\" not in config:\n            return {\"valid\": False, \"message\": \"缺少必需的type字段\"}\n        \n        # 检查input_params格式\n        if \"input_params\" in config:\n            if not isinstance(config[\"input_params\"], list):\n                return {\"valid\": False, \"message\": \"input_params必须是数组\"}\n            \n            for param in config[\"input_params\"]:\n                if \"name\" not in param or \"type\" not in param:\n                    return {\"valid\": False, \"message\": \"每个参数必须包含name和type字段\"}\n                \n                if param[\"type\"] not in [\"string\", \"number\", \"boolean\", \"array\", \"object\"]:\n                    return {\"valid\": False, \"message\": f\"参数类型{param['type']}不受支持\"}\n        \n        return {\"valid\": True, \"message\": \"配置验证通过\"}\n    \n    def get_execution_history(self, limit: int = 10) -> List[Dict]:\n        \"\"\"获取执行历史 - 完整保留原文\"\"\"\n        return self.execution_history[-limit:]\n    \n    def get_error_log(self, limit: int = 10) -> List[Dict]:\n        \"\"\"获取错误日志 - 完整保留原文\"\"\"\n        return self.error_log[-limit:]\n    \n    def clear_context(self) -> Dict:\n        \"\"\"清除上下文 - 完整保留原文\"\"\"\n        self.context_memory = {}\n        logger.info(\"上下文已清除\")\n        return {\n            \"status\": ExecutionStatus.SUCCESS.value,\n            \"message\": \"上下文已清除\",\n            \"timestamp\": datetime.now().isoformat()\n        }\n        \n    def get_plugin_info(self, plugin_type: str) -> Optional[Dict]:\n        \"\"\"获取插件信息 - 完整保留原文\"\"\"\n        return self.plugin_registry.get(plugin_type)\n    \n    def get_system_status(self) -> Dict:\n        \"\"\"获取系统状态 - 完整保留原文\"\"\"\n        return {\n            \"status\": \"running\",\n            \"version\": \"3.0.0\",\n            \"plugins_count\": len(self.plugin_registry),\n            \"execution_history_count\": len(self.execution_history),\n            \"error_log_count\": len(self.error_log),\n            \"context_memory_size\": len(self.context_memory),\n            \"timestamp\": datetime.now().isoformat()\n        }\n\n# Coze插件标准接口 - 完整保留原文\ndef main(input_data: Dict) -> Dict:\n    \"\"\"\n    Coze插件主入口函数\n    input_data 包含:\n    - user_input: 用户输入的需求描述 (必需)\n    - input_type: 输入位置类型 (可选，默认为output_node)\n    - additional_params: 额外参数 (可选)\n    - yaml_content: YAML配置内容 (用于导入插件，可选)\n    - command: 特殊命令 (如get_history, get_errors, clear_context等)\n    \"\"\"\n    # 初始化引擎\n    engine = CozeAutoFlowMaster()\n    \n    # 检查特殊命令\n    command = input_data.get(\"command\")\n    if command:\n        return _handle_command(engine, command, input_data)\n    \n    # 检查是否是YAML导入请求\n    yaml_content = input_data.get(\"yaml_content\")\n    if yaml_content:\n        return engine.import_from_yaml(yaml_content)\n    \n    # 处理常规请求\n    user_input = input_data.get(\"user_input\", \"\")\n    input_type_str = input_data.get(\"input_type\", \"output_node\")\n    additional_params = input_data.get(\"additional_params\", {})\n    \n    # 验证必需参数\n    if not user_input:\n        return {\n            \"status\": ExecutionStatus.ERROR.value,\n            \"message\": \"user_input是必需参数\",\n            \"timestamp\": datetime.now().isoformat()\n        }\n    \n    # 转换输入类型\n    try:\n        input_type = InputType(input_type_str)\n    except ValueError:\n        return {\n            \"status\": ExecutionStatus.ERROR.value,\n            \"message\": f\"无效的input_type: {input_type_str}。有效值: {[e.value for e in InputType]}\",\n            \"timestamp\": datetime.now().isoformat()\n        }\n    \n    return engine.process_request(user_input, input_type, additional_params)\n\ndef _handle_command(engine: CozeAutoFlowMaster, command: str, input_data: Dict) -> Dict:\n    \"\"\"处理特殊命令 - 完整保留原文\"\"\"\n    if command == \"get_history\":\n        limit = input_data.get(\"limit\", 10)\n        return {\n            \"status\": ExecutionStatus.SUCCESS.value,\n            \"history\": engine.get_execution_history(limit),\n            \"timestamp\": datetime.now().isoformat()\n        }\n    elif command == \"get_errors\":\n        limit = input_data.get(\"limit\", 10)\n        return {\n            \"status\": ExecutionStatus.SUCCESS.value,\n            \"errors\": engine.get_error_log(limit),\n            \"timestamp\": datetime.now().isoformat()\n        }\n    elif command == \"clear_context\":\n        return engine.clear_context()\n    elif command == \"get_plugin_info\":\n        plugin_type = input_data.get(\"plugin_type\")\n        if not plugin_type:\n            return {\n                \"status\": ExecutionStatus.ERROR.value,\n                \"message\": \"plugin_type参数缺失\",\n                \"timestamp\": datetime.now().isoformat()\n            }\n        info = engine.get_plugin_info(plugin_type)\n        if info:\n            return {\n                \"status\": ExecutionStatus.SUCCESS.value,\n                \"plugin_info\": info,\n                \"timestamp\": datetime.now().isoformat()\n            }\n        else:\n            return {\n                \"status\": ExecutionStatus.ERROR.value,\n                \"message\": f\"找不到插件: {plugin_type}\",\n                \"timestamp\": datetime.now().isoformat()\n            }\n    elif command == \"get_system_status\":\n        return {\n            \"status\": ExecutionStatus.SUCCESS.value,\n            \"system_status\": engine.get_system_status(),\n            \"timestamp\": datetime.now().isoformat()\n        }\n    else:\n        return {\n            \"status\": ExecutionStatus.ERROR.value,\n            \"message\": f\"未知命令: {command}\",\n            \"timestamp\": datetime.now().isoformat()\n        }\n\n# 使用示例和测试代码 - 完整保留原文\nif __name__ == \"__main__\":\n    # 测试基本功能\n    engine = CozeAutoFlowMaster()\n    \n    # 测试1: 基本请求处理\n    print(\"=== 测试1: 基本请求处理 ===\")\n    result = engine.process_request(\n        user_input=\"获取最近三天的销售数据，生成Excel报告并发送到manager@company.com\",\n        input_type=InputType.OUTPUT_NODE\n    )\n    print(json.dumps(result, indent=2, ensure_ascii=False))\n    \n    # 测试2: YAML导入\n    print(\"\\n=== 测试2: YAML导入 ===\")\n    yaml_config = \"\"\"\ntype: \"social_media_analyzer\"\ndescription: \"社交媒体分析插件\"\ninput_params:\n  - name: \"platform\"\n    type: \"string\"\n    required: true\n    enum: [\"weibo\", \"douyin\", \"xiaohongshu\"]\n  - name: \"keyword\"\n    type: \"string\"\n    required: true\noutput_type: \"analysis_report\"\napi_endpoint: \"https://api.coze.com/v1/plugins/social-media-analyzer\"\n\"\"\"\n    result = engine.import_from_yaml(yaml_config)\n    print(json.dumps(result, indent=2, ensure_ascii=False))\n    \n    # 测试3: 系统状态查询\n    print(\"\\n=== 测试3: 系统状态查询 ===\")\n    status = engine.get_system_status()\n    print(json.dumps(status, indent=2, ensure_ascii=False))\n```\n\n📋 完整项目配置\n\n项目配置文件\n\n```yaml\n# config.yaml\nproject:\n  name: \"Coze全自动工作