 type: number\n          format: float\n          description: 学习率\n        batch_size:\n          type: integer\n          description: 批次大小\n        epochs:\n          type: integer\n          description: 训练轮次\n\n    WorkflowStatistics:\n      type: object\n      properties:\n        total_runs:\n          type: integer\n          description: 总运行次数\n        success_rate:\n          type: number\n          format: float\n          description: 成功率\n        avg_execution_time:\n          type: number\n          format: float\n          description: 平均执行时间(毫秒)\n\n  responses:\n    InvalidParameter:\n      description: 参数验证失败\n      content:\n        application/json:\n          schema:\n            type: object\n            properties:\n              error:\n                type: string\n                description: 错误信息\n              details:\n                type: array\n                items:\n                  type: object\n                  properties:\n                    field:\n                      type: string\n                      description: 字段名\n                    message:\n                      type: string\n                      description: 错误详情\n\n    NotFound:\n      description: 资源未找到\n      content:\n        application/json:\n          schema:\n            type: object\n            properties:\n              error:\n                type: string\n                example: \"Resource not found\"\n\n    ServerError:\n      description: 服务器内部错误\n      content:\n        application/json:\n          schema:\n            type: object\n            properties:\n              error:\n                type: string\n                example: \"Internal server error\"\n\n  parameters:\n    PageNumber:\n      name: page\n      in: query\n      description: 页码\n      required: false\n      schema:\n        type: integer\n        minimum: 1\n        default: 1\n\n    PageSize:\n      name: page_size\n      in: query\n      description: 每页数量\n      required: f