atch[2].trim();\n                    if (source && target) {\n                        connections.push({\n                            source: source,\n                            target: target,\n                            extractedFrom: match[0]\n                        });\n                    }\n                }\n            }\n\n            return connections;\n        } catch (error) {\n            throw new WorkflowParseError(`提取连接关系失败: ${error.message}`);\n        }\n    }\n\n    _extractParameters(text) {\n        try {\n            const parameters = {};\n            const paramPatterns = [\n                /参数\\s*([A-Za-z0-9_]+)\\s*[:：]\\s*([^，。\\s]+)/g,\n                /([A-Za-z0-9_]+)\\s*=\\s*([^，。\\s]+)/g,\n                /parameter\\s*([A-Za-z0-9_]+)\\s*[:=]\\s*([^，。\\s]+)/gi\n            ];\n\n            for (const pattern of paramPatterns) {\n                let match;\n                while ((match = pattern.exec(text)) !== null) {\n                    const paramName = match[1].trim();\n                    const paramValue = match[2].trim();\n                    if (paramName && paramValue) {\n                        parameters[paramName] = this._parseParameterValue(paramValue);\n                    }\n                }\n            }\n\n            return parameters;\n        } catch (error) {\n            throw new WorkflowParseError(`提取参数信息失败: ${error.message}`);\n        }\n    }\n\n    _parseParameterValue(value) {\n        try {\n            // 尝试解析数字\n            if (!isNaN(value)) {\n                return Number(value);\n            }\n            // 尝试解析布尔值\n            if (value.toLowerCase() === 'true') return true;\n            if (value.toLowerCase() === 'false') return false;\n            // 默认返回字符串\n            return value;\n        } catch (error) {\n            return value; // 解析失败时返回原始字符串\n        }\n    }\n\n    _detectErrorDescriptions(text) {\n        try {\n            const errors = [];\n            for (const keyword of this.errorKeywords) {\n                if (text.includes(keyword)) {\n                    errors.push({\n                        type: 'error_keyword_detected',\n                        keyword: keyword,\n                        message: `检测到错误关键词: ${keyword}`\n                    });\n                }\n            }\n\n            // 检测未连接描述\n            const unconnectedPatterns = [\n                /节点\\s*([A-Za-z0-9]+)\\s*没有连接/g,\n                /节点\\s*([A-Za-z0-9]+)\\s*未连接/g,\n                /([A-Za-z0-9]+)\\s*not\\s*connected/gi\n            ];\n\n            for (const pattern of unconnectedPatterns) {\n                let match;\n                while ((match = pattern.exec(text)) !== null) {\n                    errors.push({\n                        type: 'unconnected_node_reported',\n                        nodeId: match[1],\n                        message: `用户报告节点 ${match[1]} 未连接`\n                    });\n                }\n            }\n\n            return errors;\n        } catch (error) {\n            throw new WorkflowParseError(`检测错误描述失败: ${error.message}`);\n        }\n    }\n}\n\nclass WorkflowGenerator {\n    constructor() {\n        try {\n            this.defaultParameters = {\n                'data_processing_node': { batch_size: 100, timeout: 30, retry_count: 3 },\n                'api_call_node': { timeout: 60, retry_count: 3, method: 'GET' },\n                'start_node': { trigger: 'manual' },\n                'end_node': { output_format: 'json' },\n                'default_node': { enabled: true, timeout: 30 }\n            };\n\n            this.nodeTemplates = {\n                '开始': 'start_node',\n                'start': 'start_node',\n                '结束': 'end_node', \n                'end': 'end_node',\n                '处理': 'data_processing_node',\n                'process': 'data_processing_node',\n                'api': 'api_call_node',\n                '调用': 'api_call_node'\n            };\n        } catch (error) {\n            throw new CozePluginError(`WorkflowGenerator初始化失败: ${error.message}`);\n        }\n    }\n\n    createWorkflowFromDescription(parsedIntent) {\n        try {\n            const workflow = {\n                nodes: {},\n                connections: [],\n                metadata: {\n                    status: 'created',\n                    timestamp: new Date().toISOString(),\n                    version: '3.0',\n                    generated_by: 'coze_workflow_agent',\n                    parsed_intent: parsedIntent\n                }\n            };\n\n            // 创建所有节点\n            for (const [nodeId, nodeInfo] of Object.entries(parsedIntent.nodes)) {\n                workflow.nodes[nodeId] = this._createNode(nodeId, nodeInfo);\n            }\n\n            // 建立显式连接\n            for (const connection of parsedIntent.connections) {\n                if (this._validateConnection(connection, workflow.nodes)) {\n                    workflow.connections.push(connection);\n                }\n            }\n\n            // 自动补全逻辑连接\n            const completedWorkflow = this._autoCompleteConnections(workflow);\n            \n            // 设置工作流级别参数\n            completedWorkflow.parameters = parsedIntent.parameters;\n\n            return completedWorkflow;\n        } catch (error) {\n            throw new WorkflowParseError(`从描述生成工作流失败: ${error.message}`);\n        }\n    }\n\n    _createNode(nodeId, nodeInfo) {\n        try {\n            // 标准化节点类型\n            const normalizedType = this._normalizeNodeType(nodeInfo.type);\n            \n            const baseNode = {\n                id: nodeId,\n                type: normalizedType,\n                parameters: this._getDefaultParameters(normalizedType),\n                position: this._calculateNodePosition(nodeId, Object.keys(nodeInfo).length),\n                input_ports: this._getInputPorts(normalizedType),\n                output_ports: this._getOutputPorts(normalizedType),\n                status: 'active',\n                created_at: new Date().toISOString(),\n                original_type: nodeInfo.type\n            };\n\n            // 合并用户参数\n            if (nodeInfo.parameters && Object.keys(nodeInfo.parameters).length > 0) {\n                baseNode.parameters = { ...baseNode.parameters, ...nodeInfo.parameters };\n            }\n\n            // 保留提取信息\n            if (nodeInfo.extractedFrom) {\n                baseNode.extracted_from = nodeInfo.extractedFrom;\n            }\n\n            return baseNode;\n        } catch (error) {\n            throw new WorkflowParseError(`创建节点失败: ${error.message}`);\n        }\n    }\n\n    _normalizeNodeType(nodeType) {\n        try {\n            const lowerType = nodeType.toLowerCase();\n            for (const [key, template] of Object.entries(this.nodeTemplates)) {\n                if (lowerType.includes(key.toLowerCase())) {\n                    return template;\n                }\n            }\n            return 'default_node';\n        } catch (error) {\n            return 'default_node';\n        }\n    }\n\n    _autoCompleteConnections(workflow) {\n        try {\n            const nodes = workflow.nodes;\n            const existingConnections = new Set(\n                workflow.connections.map(conn => `${conn.source}-${conn.target}`)\n            );\n            \n            // 识别节点角色\n            const startNodes = Object.keys(nodes).filter(nodeId => \n                nodes[nodeId].type === 'start_node');\n            const endNodes = Object.keys(nodes).filter(nodeId => \n                nodes[nodeId].type === 'end_node');\n            const middleNodes = Object.keys(nodes).filter(nodeId => \n                nodes[nodeId].type !== 'start_node' && nodes[nodeId].type !== 'end_node');\n            \n            // 自动连接逻辑\n            if (startNodes.length > 0 && middleNodes.length > 0) {\n                for (const startNode of startNodes) {\n                    // 开始节点连接到第一个中间节点\n                    const firstMiddleNode = middleNodes[0];\n                    const connectionKey = `${startNode}-${firstMiddleNode}`;\n                    if (!existingConnections.has(connectionKey)) {\n                        workflow.connections.push({\n                            source: startNode,\n                            target: firstMiddleNode,\n                            auto_generated: true\n                        });\n                        existingConnections.add(connectionKey);\n                    }\n                }\n            }\n            \n            if (middleNodes.length > 0 && endNodes.length > 0) {\n                // 连接中间节点到结束节点\n                for (const middleNode of middleNodes) {\n                    for (const endNode of endNodes) {\n                        const connectionKey = `${middleNode}-${endNode}`;\n                        if (!existingConnections.has(connectionKey)) {\n                            // 检查该中间节点是否已经有输出连接\n                            const hasOutput = workflow.connections.some(conn => \n                                conn.source === middleNode);\n                            if (!hasOutput) {\n                                workflow.connections.push({\n                                    source: middleNode,\n                                    target: endNode,\n                                    auto_generated: true\n                                });\n                                existingConnections.add(connectionKey);\n                            }\n                        }\n                    }\n                }\n            }\n            \n            // 连接中间节点之间的线性关系\n            if (middleNodes.length > 1) {\n                for (let i = 0; i < middleNodes.length - 1; i++) {\n                    const current = middleNodes[i];\n                    const next = middleNodes[i + 1];\n                    const connectionKey = `${current}-${next}`;\n                    \n                    if (!existingConnections.has(connectionKey)) {\n                        // 检查当前节点是否已经有输出连接\n                        const hasOutput = workflow.connections.some(conn => \n                            conn.source === current);\n                        if (!hasOutput) {\n                            workflow.connections.push({\n                                source: current,\n                                target: next,\n                                auto_generated: true\n                            });\n                        }\n                    }\n                }\n            }\n            \n            return workflow;\n        } catch (error) {\n            throw new NodeConnectionError(`自动补全连接失败: ${error.message}`);\n        }\n    }\n\n    _getDefaultParameters(nodeType) {\n        try {\n            return { ...(this.defaultParameters[nodeType] || this.defaultParameters['default_node']) };\n        } catch (error) {\n            throw new ParameterValidationError(`获取默认参数失败: ${error.message}`);\n        }\n    }\n\n    _calculateNodePosition(nodeId, index) {\n        try {\n            const baseX = 100;\n            const baseY = 100;\n            const spacing = 150;\n            return { \n                x: baseX + (index % 5) * spacing, \n                y: baseY + Math.floor(index / 5) * spacing \n            };\n        } catch (error) {\n            throw new WorkflowParseError(`计算节点位置失败: ${error.message}`);\n        }\n    }\n\n    _getInputPorts(nodeType) {\n        try {\n            const portTemplates = {\n                'start_node': [{ id: 'trigger', type: 'event', name: '触发输入' }],\n                'data_processing_node': [{ id: 'input_data', type: 'data', name: '输入数据' }],\n                'api_call_node': [{ id: 'request', type: 'data', name: '请求数据' }],\n                'end_node': [{ id: 'final_output', type: 'data', name: '最终输出' }],\n                'default_node': [{ id: 'input', type: 'any', name: '输入' }]\n            };\n            return portTemplates[nodeType] || portTemplates['default_node'];\n        } catch (error) {\n            throw new WorkflowParseError(`获取输入端口失败: ${error.message}`);\n        }\n    }\n\n    _getOutputPorts(nodeType) {\n        try {\n            const portTemplates = {\n                'start_node': [{ id: 'output', type: 'data', name: '输出数据' }],\n                'data_processing_node': [{ id: 'processed_data', type: 'data', name: '处理结果' }],\n                'api_call_node': [{ id: 'response', type: 'data', name: 'API响应' }],\n                'end_node': [],\n                'default_node': [{ id: 'output', type: 'any', name: '输出' }]\n            };\n            return portTemplates[nodeType] || portTemplates['default_node'];\n        } catch (error) {\n            throw new WorkflowParseError(`获取输出端口失败: ${error.message}`);\n        }\n    }\n\n    _validateConnection(connection, nodes) {\n        try {\n            const sourceExists = nodes.hasOwnProperty(connection.source);\n            const targetExists = nodes.hasOwnProperty(connection.target);\n            \n            if (!sourceExists || !targetExists) {\n                console.warn(`连接验证失败: 节点不存在 - 源: ${connection.source}, 目标: ${connection.target}`);\n                return false;\n            }\n            \n            // 检查是否连接到自身\n            if (connection.source === connection.target) {\n                console.warn(`连接验证失败: 不能连接到自身 - 节点: ${connection.source}`);\n                return false;\n            }\n            \n            return true;\n        } catch (error) {\n            throw new NodeConnectionError(`验证连接失败: ${error.message}`);\n        }\n    }\n}\n\nclass ComprehensiveErrorDetector {\n    constructor() {\n        try {\n            this.requiredParameters = {\n                'api_call_node': ['url', 'method'],\n                'data_processing_node': ['input_source'],\n                'start_node': ['trigger'],\n                'end_node': ['output_format']\n            };\n            \n            this.parameterSpecs = {\n                'api_call_node': {\n                    'url': { type: 'string', required: true, pattern: '^https?://' },\n                    'method': { type: 'string', required: true, enum: ['GET', 'POST', 'PUT', 'DELETE'] },\n                    'timeout': { type: 'number', required: false, min: 1, max: 300 },\n                    'retry_count': { type: 'number', required: false, min: 0, max: 5 }\n                },\n                'data_processing_node': {\n                    'input_source': { type: 'string', required: true },\n                    'batch_size': { type: 'number', required: false, min: 1, max: 1000 },\n                    'timeout': { type: 'number', required: false, min: 1, max: 300 }\n                }\n            };\n        } catch (error) {\n            throw new CozePluginError(`ComprehensiveErrorDetector初始化失败: ${error.message}`);\n        }\n    }\n\n    fullWorkflowAudit(workflow) {\n        try {\n            const auditReport = {\n                nodeErrors: this._auditAllNodes(workflow),\n                connectionErrors: this._auditAllConnections(workflow),\n                parameterErrors: this._auditAllParameters(workflow),\n                structuralErrors: this._auditWorkflowStructure(workflow),\n                metadata: {\n                    audit_timestamp: new Date().toISOString(),\n                    total_nodes: Object.keys(workflow.nodes).length,\n                    total_connections: workflow.connections.length,\n                    workflow_version: workflow.metadata?.version || 'unknown'\n                }\n            };\n\n            // 计算总体错误统计\n            auditReport.summary = this._generateAuditSummary(auditReport);\n\n            return auditReport;\n        } catch (error) {\n            throw new CozePluginError(`工作流审计失败: ${error.message}`);\n        }\n    }\n\n    _auditAllNodes(workflow) {\n        try {\n            const nodeErrors = {};\n            \n            for (const [nodeId, node] of Object.entries(workflow.nodes)) {\n                const errors = [];\n                \n                // 基础验证\n                if (!node.id || node.id !== nodeId) {\n                    errors.push({ type: 'id_mismatch', message: '节点ID不匹配' });\n                }\n                \n                if (!node.type) {\n                    errors.push({ type: 'missing_type', message: '节点类型缺失' });\n                }\n                \n                if (!node.position || typeof node.position !== 'object') {\n                    errors.push({ type: 'invalid_position', message: '节点位置信息无效' });\n                }\n                \n                // 状态验证\n                if (!node.status) {\n                    errors.push({ type: 'missing_status', message: '节点状态缺失' });\n                } else if (!['active', 'inactive', 'error'].includes(node.status)) {\n                    errors.push({ type: 'invalid_status', message: `无效的节点状态: ${node.status}` });\n                }\n                \n                // 端口验证\n                if (!node.input_ports || !Array.isArray(node.input_ports)) {\n                    errors.push({ type: 'invalid_input_ports', message: '输入端口配置无效' });\n                }\n                \n                if (!node.output_ports || !Array.isArray(node.output_ports)) {\n                    errors.push({ type: 'invalid_output_ports', message: '输出端口配置无效' });\n                }\n                \n                if (errors.length > 0) {\n                    nodeErrors[nodeId] = errors;\n                }\n            }\n            \n            return nodeErrors;\n        } catch (error) {\n            throw new CozePluginError(`审计节点失败: ${error.message}`);\n        }\n    }\n\n    _auditAllParameters(workflow) {\n        try {\n            const parameterErrors = {\n                missingRequired: {},\n                invalidValues: {},\n                typeMismatches: {},\n                outOfRange: {}\n            };\n            \n            for (const [nodeId, node] of Object.entries(workflow.nodes)) {\n                const nodeType = node.type;\n                const parameters = node.parameters || {};\n                const requiredParams = this._getRequiredParameters(nodeType);\n                const paramSpec = this.parameterSpecs[nodeType];\n                \n                // 检查必需参数\n                for (const param of requiredParams) {\n                    if (!parameters.hasOwnProperty(param)) {\n                        if (!parameterErrors.missingRequired[nodeId]) {\n                            parameterErrors.missingRequired[nodeId] = [];\n                        }\n                        parameterErrors.missingRequired[nodeId].push({\n                            parameter: param,\n                            message: `必需参数缺失: ${param}`\n                        });\n                    }\n                }\n                \n                // 检查参数值有效性\n                if (paramSpec) {\n                    for (const [paramName, paramValue] of Object.entries(parameters)) {\n                        if (paramSpec[paramName]) {\n                            const spec = paramSpec[paramName];\n                            const validation = this._validateParameterValue(paramValue, spec);\n                            \n                            if (!validation.valid) {\n                                const errorType = validation.errorType;\n                                if (!parameterErrors[errorType][nodeId]) {\n                                    parameterErrors[errorType][nodeId] = [];\n                                }\n                                parameterErrors[errorType][nodeId].push({\n                                    parameter: paramName,\n                                    value: paramValue,\n                                    message: validation.message,\n                                    expected: spec\n                                });\n                            }\n                        }\n                    }\n                }\n            }\n            \n            return parameterErrors;\n        } catch (error) {\n            throw new ParameterValidationError(`审计参数失败: ${error.message}`);\n        }\n    }\n\n    _validateParameterValue(value, spec) {\n        try {\n            // 类型检查\n            if (spec.type && !this._checkTypeCompatibility(value, spec.type)) {\n                return {\n                    valid: false,\n                    errorType: 'typeMismatches',\n                    message: `参数类型不匹配，期望 ${spec.type}，实际 ${typeof value}`\n                };\n            }\n            \n            // 枚举值检查\n            if (spec.enum && !spec.enum.includes(value)) {\n                return {\n                    valid: false,\n                    errorType: 'invalidValues',\n                    message: `参数值无效，有效值: ${spec.enum.join(', ')}`\n                };\n            }\n            \n            // 范围检查\n            if (spec.min !== undefined && value < spec.min) {\n                return {\n                    valid: false,\n                    errorType: 'outOfRange',\n                    message: `参数值超出范围，最小值: ${spec.min}`\n                };\n            }\n            \n            if (spec.max !== undefined && value > spec.max) {\n                return {\n                    valid: false,\n                    errorType: 'outOfRange',\n                    message: `参数值超出范围，最大值: ${spec.max}`\n                };\n            }\n            \n            // 格式检查\n            if (spec.pattern && typeof value === 'string') {\n                const regex = new RegExp(spec.pattern);\n                if (!regex.test(value)) {\n                    return {\n                        valid: false,\n                        errorType: 'invalidValues',\n                        message: `参数格式不匹配，模式: ${spec.pattern}`\n                    };\n                }\n            }\n            \n            return { valid: true };\n        } catch (error) {\n            return {\n                valid: false,\n                errorType: 'invalidValues',\n                message: `参数验证失败: ${error.message}`\n            };\n        }\n    }\n\n    _checkTypeCompatibility(value, expectedType) {\n        try {\n            switch (expectedType) {\n                case 'string':\n                    return typeof value === 'string';\n                case 'number':\n                    return typeof value === 'number' && !isNaN(value);\n                case 'boolean':\n                    return typeof value === 'boolean';\n                case 'object':\n                    return typeof value === 'object' && value !== null;\n                case 'array':\n                    return Array.isArray(value);\n                default:\n                    return true; // 未知类型不进行严格检查\n            }\n        } catch (error) {\n            return false;\n        }\n    }\n\n    _auditAllConnections(workflow) {\n        try {\n            const connectionErrors = [];\n            const nodeIds = new Set(Object.keys(workflow.nodes));\n            \n            for (let i = 0; i < workflow.connections.length; i++) {\n                const connection = workflow.connections[i];\n                const errors = [];\n                \n                // 基础验证\n                if (!connection.source || !connection.target) {\n                    errors.push('连接缺少源节点或目标节点');\n                }\n                \n                if (!nodeIds.has(connection.source)) {\n                    errors.push(`源节点不存在: ${connection.source}`);\n                }\n                \n                if (!nodeIds.has(connection.target)) {\n                    errors.push(`目标节点不存在: ${connection.target}`);\n                }\n                \n                if (connection.source === connection.target) {\n                    errors.push('节点不能连接到自身');\n                }\n                \n                // 重复连接检查\n                const duplicateConnections = workflow.connections.filter((conn, idx) => \n                    idx !== i && \n                    conn.source === connection.source && \n                    conn.target === connection.target\n                );\n                \n                if (duplicateConnections.length > 0) {\n                    errors.push('存在重复连接');\n                }\n                \n                if (errors.length > 0) {\n                    connectionErrors.push({\n                        index: i,\n                        connection: connection,\n                        errors: errors\n                    });\n                }\n            }\n            \n            return connectionErrors;\n        } catch (error) {\n            throw new NodeConnectionError(`审计连接失败: ${error.message}`);\n        }\n    }\n\n    _auditWorkflowStructure(workflow) {\n        try {\n            const structuralErrors = [];\n            const nodes = workflow.nodes;\n            const connections = workflow.connections;\n            \n            // 检查是否有开始节点\n            const startNodes = Object.keys(nodes).filter(nodeId => \n                nodes[nodeId].type === 'start_node');\n            if (startNodes.length === 0) {\n                structuralErrors.push('工作流缺少开始节点');\n            }\n            \n            // 检查是否有结束节点\n            const endNodes = Object.keys(nodes).filter(nodeId => \n                nodes[nodeId].type === 'end_node');\n            if (endNodes.length === 0) {\n                structuralErrors.push('工作流缺少结束节点');\n            }\n            \n            // 检查孤立节点\n            const connectedNodes = new Set();\n            connections.forEach(conn => {\n                connectedNodes.add(conn.source);\n                connectedNodes.add(conn.target);\n            });\n            \n            const isolatedNodes = Object.keys(nodes).filter(nodeId => \n                !connectedNodes.has(nodeId) && \n                nodes[nodeId].type !== 'start_node' && // 开始节点允许没有输入\n                nodes[nodeId].type !== 'end_node'      // 结束节点允许没有输出\n            );\n            \n            if (isolatedNodes.length > 0) {\n                structuralErrors.push(`发现孤立节点: ${isolatedNodes.join(', ')}`);\n            }\n            \n            // 检查循环依赖\n            const cycles = this._detectCycles(workflow);\n            if (cycles.length > 0) {\n                structuralErrors.push(`发现循环依赖: ${cycles.map(cycle => cycle.join(' -> ')).join('; ')}`);\n            }\n            \n            return structuralErrors;\n        } catch (error) {\n            throw new CozePluginError(`审计工作流结构失败: ${error.message}`);\n        }\n    }\n\n    _detectCycles(workflow) {\n        try {\n            const graph = {};\n            Object.keys(workflow.nodes).forEach(nodeId => {\n                graph[nodeId] = [];\n            });\n            \n            workflow.connections.forEach(conn => {\n                if (graph[conn.source]) {\n                    graph[conn.source].push(conn.target);\n                }\n            });\n            \n            const cycles = [];\n            const visited = {};\n            const recursionStack = {};\n            \n            const dfs = (node, path) => {\n                if (!visited[node]) {\n                    visited[node] = true;\n                    recursionStack[node] = true;\n                    \n                    for (const neighbor of graph[node] || []) {\n                        if (!visited[neighbor]) {\n                            const newPath = [...path, neighbor];\n                            dfs(neighbor, newPath);\n                        } else if (recursionStack[neighbor]) {\n                            // 发现循环\n                            const cycleStart = path.indexOf(neighbor);\n                            if (cycleStart !== -1) {\n                                const cycle = path.slice(cycleStart);\n                                cycles.push(cycle);\n                            }\n                        }\n                    }\n                }\n                recursionStack[node] = false;\n            };\n            \n            for (const node of Object.keys(graph)) {\n                if (!visited[node]) {\n                    dfs(node, [node]);\n                }\n            }\n            \n            return cycles;\n        } catch (error) {\n            console.warn('循环检测失败:', error.message);\n            return [];\n        }\n    }\n\n    _getRequiredParameters(nodeType) {\n        try {\n            return this.requiredParameters[nodeType] || [];\n        } catch (error) {\n            throw new ParameterValidationError(`获取必需参数失败: ${error.message}`);\n        }\n    }\n\n    _generateAuditSummary(auditReport) {\n        try {\n            let totalErrors = 0;\n            const errorTypes = {};\n            \n            // 统计节点错误\n            errorTypes.nodeErrors = Object.values(auditReport.nodeErrors).reduce((sum, errors) => sum + errors.length, 0);\n            totalErrors += errorTypes.nodeErrors;\n            \n            // 统计连接错误\n            errorTypes.connectionErrors = auditReport.connectionErrors.length;\n            totalErrors += errorTypes.connectionErrors;\n            \n            // 统计参数错误\n            errorTypes.parameterErrors = Object.values(auditReport.parameterErrors).reduce((sum, errorsByNode) => \n                sum + Object.values(errorsByNode).reduce((innerSum, errors) => innerSum + errors.length, 0), 0);\n            totalErrors += errorTypes.parameterErrors;\n            \n            // 统计结构错误\n            errorTypes.structuralErrors = auditReport.structuralErrors.length;\n            totalErrors += errorTypes.structuralErrors;\n            \n            return {\n                totalErrors,\n                errorTypes,\n                severity: totalErrors === 0 ? 'none' : \n                         totalErrors <= 5 ? 'low' :\n                         totalErrors <= 15 ? 'medium' : 'high'\n            };\n        } catch (error) {\n            return {\n                totalErrors: 0,\n                errorTypes: {},\n                severity: 'unknown',\n                error: `生成审计摘要失败: ${error.message}`\n            };\n        }\n    }\n}\n\nclass ComprehensiveParameterFixer {\n    constructor() {\n        try {\n            this.parameterDefaults = {\n                'api_call_node': {\n                    'url': 'https://api.example.com/endpoint',\n                    'method': 'GET',\n                    'timeout': 60,\n                    'retry_count': 3,\n                    'headers': { 'Content-Type': 'application/json' }\n                },\n                'data_processing_node': {\n                    'input_source': 'default_input',\n                    'batch_size': 100,\n                    'timeout': 30,\n                    'processing_mode': 'standard'\n                },\n                'start_node': {\n                    'trigger': 'manual',\n                    'auto_start': false\n                },\n                'end_node': {\n                    'output_format': 'json',\n                    'save_result': true\n                },\n                'default_node': {\n                    'enabled': true,\n                    'timeout': 30,\n                    'description': '自动生成的节点'\n                }\n            };\n            \n            this.valueCorrections = {\n                'method': (value) => value.toUpperCase(),\n                'timeout': (value) => Math.max(1, Math.min(Number(value) || 30, 300)),\n                'retry_count': (value) => Math.max(0, Math.min(Number(value) || 3, 5)),\n                'batch_size': (value) => Math.max(1, Math.min(Number(value) || 100, 1000))\n            };\n        } catch (error) {\n            throw new CozePluginError(`ComprehensiveParameterFixer初始化失败: ${error.message}`);\n        }\n    }\n\n    fullParameterRepair(workflow, auditReport) {\n        try {\n            // 深拷贝工作流\n            const repairedWorkflow = JSON.parse(JSON.stringify(workflow));\n            \n            // 记录修复操作\n            const repairLog = {\n                timestamp: new Date().toISOString(),\n                operations: []\n            };\n\n            // 修复节点错误\n            const nodeRepairs = this._fixNodeErrors(repairedWorkflow, auditReport.nodeErrors);\n            repairLog.operations.push(...nodeRepairs);\n            \n            // 修复参数错误\n            const paramRepairs = this._fixParameterErrors(repairedWorkflow, auditReport.parameterErrors);\n            repairLog.operations.push(...paramRepairs);\n            \n            // 修复连接错误\n            const connRepairs = this._fixConnectionErrors(repairedWorkflow, auditReport.connectionErrors);\n            repairLog.operations.push(...connRepairs);\n            \n            // 修复结构错误\n            const structRepairs = this._fixStructuralErrors(repairedWorkflow, auditReport.structuralErrors);\n            repairLog.operations.push(...structRepairs);\n            \n            // 添加修复记录到工作流元数据\n            if (!repairedWorkflow.metadata.repair_history) {\n                repairedWorkflow.metadata.repair_history = [];\n            }\n            repairedWorkflow.metadata.repair_history.push(repairLog);\n            repairedWorkflow.metadata.last_repaired = new Date().toISOString();\n            repairedWorkflow.metadata.repair_count = (repairedWorkflow.metadata.repair_count || 0) + 1;\n\n            return repairedWorkflow;\n        } catch (error) {\n            throw new CozePluginError(`全面参数修复失败: ${error.message}`);\n        }\n    }\n\n    _fixNodeErrors(workflow, nodeErrors) {\n        try {\n            const repairs = [];\n            \n            for (const [nodeId, errors] of Object.entries(nodeErrors)) {\n                for (const error of errors) {\n                    let repairAction = null;\n                    \n                    switch (error.type) {\n                        case 'missing_type':\n                            workflow.nodes[nodeId].type = 'default_node';\n                            repairAction = `设置节点 ${nodeId} 的默认类型: default_node`;\n                            break;\n                            \n                        case 'invalid_position':\n                            workflow.nodes[nodeId].position = { x: 100, y: 100 };\n                            repairAction = `重置节点 ${nodeId} 的位置`;\n                            break;\n                            \n                        case 'missing_status':\n                            workflow.nodes[nodeId].status = 'active';\n                            repairAction = `设置节点 ${nodeId} 的状态为: active`;\n                            break;\n                            \n                        case 'invalid_status':\n                            workflow.nodes[nodeId].status = 'active';\n                            repairAction = `修正节点 ${nodeId} 的无效状态`;\n                            break;\n                            \n                        case 'invalid_input_ports':\n                            workflow.nodes[nodeId].input_ports = [{ id: 'input', type: 'any', name: '输入' }];\n                            repairAction = `重置节点 ${nodeId} 的输入端口`;\n                            break;\n                            \n                        case 'invalid_output_ports':\n                            workflow.nodes[nodeId].output_ports = [{ id: 'output', type: 'any', name: '输出' }];\n                            repairAction = `重置节点 ${nodeId} 的输出端口`;\n                            break;\n                    }\n                    \n                    if (repairAction) {\n                        repairs.push({\n                            type: 'node_repair',\n                            node: nodeId,\n                            action: repairAction,\n                            error: error.message\n                        });\n                    }\n                }\n            }\n            \n            return repairs;\n        } catch (error) {\n            throw new CozePluginError(`修复节点错误失败: ${error.message}`);\n        }\n    }\n\n    _fixParameterErrors(workflow, parameterErrors) {\n        try {\n            const repairs = [];\n            \n            // 修复缺失的必需参数\n            for (const [nodeId, missingParams] of Object.entries(parameterErrors.missingRequired)) {\n                for (const errorInfo of missingParams) {\n                    const repairAction = this._fixMissingParameter(workflow, nodeId, errorInfo.parameter);\n                    if (repairAction) {\n                        repairs.push({\n                            type: 'parameter_repair',\n                            node: nodeId,\n                            action: repairAction,\n                            error: errorInfo.message\n                        });\n                    }\n                }\n            }\n            \n            // 修复类型不匹配参数\n            for (const [nodeId, typeErrors] of Object.entries(parameterErrors.typeMismatches)) {\n                for (const errorInfo of typeErrors) {\n                    const repairAction = this._fixTypeMismatch(workflow, nodeId, errorInfo);\n                    if (repairAction) {\n                        repairs.push({\n                            type: 'parameter_repair',\n                            node: nodeId,\n                            action: repairAction,\n                            error: errorInfo.message\n                        });\n                    }\n                }\n            }\n            \n            // 修复无效值参数\n            for (const [nodeId, valueErrors] of Object.entries(parameterErrors.invalidValues)) {\n                for (const errorInfo of valueErrors) {\n                    const repairAction = this._fixInvalidValue(workflow, nodeId, errorInfo);\n                    if (repairAction) {\n                        repairs.push({\n                            type: 'parameter_repair',\n                            node: nodeId,\n                            action: repairAction,\n                            error: errorInfo.message\n                        });\n                    }\n                }\n            }\n            \n            // 修复超出范围参数\n            for (const [nodeId, rangeErrors] of Object.entries(parameterErrors.outOfRange)) {\n                for (const errorInfo of rangeErrors) {\n                    const repairAction = this._fixOutOfRange(workflow, nodeId, errorInfo);\n                    if (repairAction) {\n                        repairs.push({\n                            type: 'parameter_repair',\n                            node: nodeId,\n                            action: repairAction,\n                            error: errorInfo.message\n                        });\n                    }\n                }\n            }\n            \n            return repairs;\n        } catch (error) {\n            throw new ParameterValidationError(`修复参数错误失败: ${error.message}`);\n        }\n    }\n\n    _fixMissingParameter(workflow, nodeId, paramName) {\n        try {\n            const nodeType = workflow.nodes[nodeId].type;\n            const defaultValue = this._getParameterDefaultValue(nodeType, paramName);\n            \n            if (!workflow.nodes[nodeId].parameters) {\n                workflow.nodes[nodeId].parameters = {};\n            }\n            \n            workflow.nodes[nodeId].parameters[paramName] = defaultValue;\n            \n            return `设置节点 ${nodeId} 的参数 ${paramName} = ${JSON.stringify(defaultValue)}`;\n        } catch (error) {\n            throw new ParameterValidationError(`修复缺失参数失败: ${error.message}`);\n        }\n    }\n\n    _fixTypeMismatch(workflow, nodeId, errorInfo) {\n        try {\n            const paramName = errorInfo.parameter;\n            const currentValue = errorInfo.value;\n            const expectedType = errorInfo.expected.type;\n            \n            let correctedValue = currentValue;\n            \n            // 尝试类型转换\n            switch (expectedType) {\n                case 'string':\n                    correctedValue = String(currentValue);\n                    break;\n                case 'number':\n                    correctedValue = Number(currentValue);\n                    if (isNaN(correctedValue)) {\n                        correctedValue = this._getParameterDefaultValue(workflow.nodes[nodeId].type, paramName);\n                    }\n                    break;\n                case 'boolean':\n                    if (typeof currentValue === 'string') {\n                        correctedValue = currentValue.toLowerCase() === 'true';\n                    } else {\n                        correctedValue = Boolean(currentValue);\n                    }\n                    break;\n            }\n            \n            // 应用值修正\n            if (this.valueCorrections[paramName]) {\n                correctedValue = this.valueCorrections[paramName](correctedValue);\n            }\n            \n            workflow.nodes[nodeId].parameters[paramName] = correctedValue;\n            \n            return `修正节点 ${nodeId} 的参数 ${paramName} 类型: ${typeof currentValue} -> ${expectedType}, 值: ${correctedValue}`;\n        } catch (error) {\n            throw new ParameterValidationError(`修复类型不匹配失败: ${error.message}`);\n        }\n    }\n\n    _fixInvalidValue(workflow, nodeId, errorInfo) {\n        try {\n            const paramName = errorInfo.parameter;\n            const spec = errorInfo.expected;\n            \n            let correctedValue;\n            \n            if (spec.enum && spec.enum.length > 0) {\n                // 使用枚举中的第一个有效值\n                correctedValue = spec.enum[0];\n            } else if (spec.default !== undefined) {\n                // 使用默认值\n                correctedValue = spec.default;\n            } else {\n                // 智能推断\n                correctedValue = this._getParameterDefaultValue(workflow.nodes[nodeId].type, paramName);\n            }\n            \n            workflow.nodes[nodeId].parameters[paramName] = correctedValue;\n            \n            return `修正节点 ${nodeId} 的参数 ${paramName} 无效值: ${errorInfo.value} -> ${correctedValue}`;\n        } catch (error) {\n            throw new ParameterValidationError(`修复无效值失败: ${error.message}`);\n        }\n    }\n\n    _fixOutOfRange(workflow, nodeId, errorInfo) {\n        try {\n            const paramName = errorInfo.parameter;\n            const currentValue = errorInfo.value;\n            const spec = errorInfo.expected;\n            \n            let correctedValue = currentValue;\n            \n            if (spec.min !== undefined && currentValue < spec.min) {\n                correctedValue = spec.min;\n            } else if (spec.max !== undefined && currentValue > spec.max) {\n                correctedValue = spec.max;\n            }\n            \n            workflow.nodes[nodeId].parameters[paramName] = correctedValue;\n            \n            return `修正节点 ${nodeId} 的参数 ${paramName} 范围: ${currentValue} -> ${correctedValue}`;\n        } catch (error) {\n            throw new ParameterValidationError(`修复超出范围失败: ${error.message}`);\n        }\n    }\n\n    _getParameterDefaultValue(nodeType, paramName) {\n        try {\n            return this.parameterDefaults[nodeType]?.[paramName] ?? \n                   this.parameterDefaults['default_node']?.[paramName] ?? \n                   'default_value';\n        } catch (error) {\n            throw new ParameterValidationError(`获取参数默认值失败: ${error.message}`);\n        }\n    }\n\n    _fixConnectionErrors(workflow, connectionErrors) {\n        try {\n            const repairs = [];\n            \n            // 移除无效连接\n            const validConnections = workflow.connections.filter((connection, index) => {\n                const isInvalid = connectionErrors.some(error => error.index === index);\n                if (isInvalid) {\n                    repairs.push({\n                        type: 'connection_repair',\n                        action: `移除无效连接: ${connection.source} -> ${connection.target}`,\n                        error: connectionErrors.find(error => error.index === index).errors.join(', ')\n                    });\n                }\n                return !isInvalid;\n            });\n            \n            workflow.connections = validConnections;\n            \n            return repairs;\n        } catch (error) {\n            throw new NodeConnectionError(`修复连接错误失败: ${error.message}`);\n        }\n    }\n\n    _fixStructuralErrors(workflow, structuralErrors) {\n        try {\n            const repairs = [];\n            \n            for (const error of structuralErrors) {\n                let repairAction = null;\n                \n                if (error.includes('缺少开始节点')) {\n                    this._addStartNode(workflow);\n                    repairAction = '添加缺失的开始节点';\n                } else if (error.includes('缺少结束节点')) {\n                    this._addEndNode(workflow);\n                    repairAction = '添加缺失的结束节点';\n                } else if (error.includes('孤立节点')) {\n                    const nodeMatches = error.match(/节点: ([A-Za-z0-9, ]+)/);\n                    if (nodeMatches) {\n                        const nodeIds = nodeMatches[1].split(', ');\n                        this._fixIsolatedNodes(workflow, nodeIds);\n                        repairAction = `修复孤立节点: ${nodeIds.join(', ')}`;\n                    }\n                } else if (error.includes('循环依赖')) {\n                    const cycleMatches = error.match(/循环依赖: ([^]+)/);\n                    if (cycleMatches) {\n                        this._breakCycles(workflow);\n                        repairAction = '打破循环依赖';\n                    }\n                }\n                \n                if (repairAction) {\n                    repairs.push({\n                        type: 'structural_repair',\n                        action: repairAction,\n                        error: error\n                    });\n                }\n            }\n            \n            return repairs;\n        } catch (error) {\n            throw new CozePluginError(`修复结构错误失败: ${error.message}`);\n        }\n    }\n\n    _addStartNode(workflow) {\n        try {\n            const startNodeId = 'auto_start_node';\n            workflow.nodes[startNodeId] = {\n                id: startNodeId,\n                type: 'start_node',\n                parameters: this._getParameterDefaultValue('start_node'),\n                position: { x: 50, y: 100 },\n                input_ports: [{ id: 'trigger', type: 'event', name: '触发输入' }],\n                output_ports: [{ id: 'output', type: 'data', name: '输出数据' }],\n                status: 'active',\n                auto_generated: true\n            };\n        } catch (error) {\n            throw new CozePluginError(`添加开始节点失败: ${error.message}`);\n        }\n    }\n\n    _addEndNode(workflow) {\n        try {\n            const endNodeId = 'auto_end_node';\n            workflow.nodes[endNodeId] = {\n                id: endNodeId,\n                type: 'end_node',\n                parameters: this._getParameterDefaultValue('end_node'),\n                position: { x: 500, y: 100 },\n                input_ports: [{ id: 'final_output', type: 'data', name: '最终输出' }],\n                output_ports: [],\n                status: 'active',\n                auto_generated: true\n            };\n        } catch (error) {\n            throw new CozePluginError(`添加结束节点失败: ${error.message}`);\n        }\n    }\n\n    _fixIsolatedNodes(workflow, nodeIds) {\n        try {\n            // 简化实现：将孤立节点连接到开始或结束节点\n            const startNodes = Object.keys(workflow.nodes).filter(id => \n                workflow.nodes[id].type === 'start_node');\n            const endNodes = Object.keys(workflow.nodes).filter(id => \n                workflow.nodes[id].type === 'end_node');\n            \n            for (const nodeId of nodeIds) {\n                const node = workflow.nodes[nodeId];\n                if (node && !workflow.connections.some(conn => \n                    conn.source === nodeId || conn.target === nodeId)) {\n                    \n                    // 如果是处理节点，连接到开始节点\n                    if (node.type === 'data_processing_node' && startNodes.length > 0) {\n                        workflow.connections.push({\n                            source: startNodes[0],\n                            target: nodeId,\n                            auto_generated: true\n                        });\n                    }\n                    // 如果是结束节点之前的节点，连接到结束节点\n                    else if (endNodes.length > 0) {\n                        workflow.connections.push({\n                            source: nodeId,\n                            target: endNodes[0],\n                            auto_generated: true\n                        });\n                    }\n                }\n            }\n        } catch (error) {\n            console.warn('修复孤立节点失败:', error.message);\n        }\n    }\n\n    _breakCycles(workflow) {\n        try {\n            // 简化实现：移除造成循环的最后一条连接\n            if (workflow.connections.length > 0) {\n                const lastConnection = workflow.connections[workflow.connections.length - 1];\n                workflow.connections = workflow.connections.slice(0, -1);\n                console.log(`打破循环: 移除了连接 ${lastConnection.source} -> ${lastConnection.target}`);\n            }\n        } catch (error) {\n            console.warn('打破循环失败:', error.message);\n        }\n    }\n}\n\nclass LegacyWorkflowFixer {\n    constructor() {\n        try {\n            this.deprecatedMap = {\n                'old_batch_size': 'batch_size',\n                'old_timeout_ms': 'timeout',\n                'api_endpoint': 'url',\n                'api_method': 'method',\n                'processing_mode_old': 'processing_mode',\n                'input_source_old': 'input_source'\n            };\n            \n            this.versionMigrationRules = {\n                '1.0': this._migrateV1ToV2.bind(this),\n                '2.0': this._migrateV2ToV3.bind(this),\n                '3.0': this._migrateToCurrentFormat.bind(this)\n            };\n        } catch (error) {\n            throw new CozePluginError(`LegacyWorkflowFixer初始化失败: ${error.message}`);\n        }\n    }\n\n    repairLegacyWorkflow(legacyWorkflow) {\n        try {\n            const migrationLog = {\n                timestamp: new Date().toISOString(),\n                original_version: legacyWorkflow.version || '1.0',\n                migration_steps: []\n            };\n\n            // 迁移格式\n            const migrated = this._migrateLegacyFormat(legacyWorkflow, migrationLog);\n            \n            // 更新过时参数\n            const updated = this._updateDeprecatedParameters(migrated, migrationLog);\n            \n            // 应用兼容性修复\n            const compatible = this._applyCompatibilityFixes(updated, migrationLog);\n            \n            // 添加迁移记录\n            if (!compatible.metadata) {\n                compatible.metadata = {};\n            }\n            if (!compatible.metadata.migration_history) {\n                compatible.metadata.migration_history = [];\n            }\n            compatible.metadata.migration_history.push(migrationLog);\n            \n            return compatible;\n        } catch (error) {\n            throw new CozePluginError(`修复老旧工作流失败: ${error.message}`);\n        }\n    }\n\n    _migrateLegacyFormat(workflow, migrationLog) {\n        try {\n            const version = workflow.version || '1.0';\n            let migratedWorkflow = JSON.parse(JSON.stringify(workflow));\n            \n            // 应用版本迁移规则\n            if (this.versionMigrationRules[version]) {\n                migratedWorkflow = this.versionMigrationRules[version](migratedWorkflow, migrationLog);\n            } else {\n                // 默认迁移到最新格式\n                migratedWorkflow = this._migrateToCurrentFormat(migratedWorkflow, migrationLog);\n            }\n            \n            return migratedWorkflow;\n        } catch (error) {\n            throw new CozePluginError(`迁移旧格式失败: ${error.message}`);\n        }\n    }\n\n    _migrateV1ToV2(v1Workflow, migrationLog) {\n        try {\n            const v2Workflow = JSON.parse(JSON.stringify(v1Workflow));\n            migrationLog.migration_steps.push('开始 V1 到 V2 格式迁移');\n            \n            // 节点格式迁移\n            for (const [nodeId, node] of Object.entries(v2Workflow.nodes)) {\n                if (node.name) {\n                    node.id = node.name;\n                    delete node.name;\n                    migrationLog.migration_steps.push(`节点 ${nodeId}: 迁移 name -> id`);\n                }\n                if (node.config) {\n                    node.parameters = node.config;\n                    delete node.config;\n                    migrationLog.migration_steps.push(`节点 ${nodeId}: 迁移 config -> parameters`);\n                }\n                \n                // 添加缺失的字段\n                if (!node.status) {\n                    node.status = 'active';\n                }\n                if (!node.position) {\n                    node.position = { x: 100, y: 100 };\n                }\n            }\n            \n            // 连接格式迁移\n            if (v2Workflow.links) {\n                v2Workflow.connections = v2Workflow.links.map(link => ({\n                    source: link.from,\n                    target: link.to\n                }));\n                delete v2Workflow.links;\n                migrationLog.migration_steps.push('迁移 links -> connections');\n            }\n            \n            // 元数据更新\n            v2Workflow.version = '2.0';\n            if (!v2Workflow.metadata) {\n                v2Workflow.metadata = {};\n            }\n            v2Workflow.metadata.migrated_from = '1.0';\n            v2Workflow.metadata.migration_timestamp = new Date().toISOString();\n            \n            migrationLog.migration_steps.push('V1 到 V2 格式迁移完成');\n            return v2Workflow;\n        } catch (error) {\n            throw new CozePluginError(`V1到V2格式迁移失败: ${error.message}`);\n        }\n    }\n\n    _migrateV2ToV3(v2Workflow, migrationLog) {\n        try {\n            const v3Workflow = JSON.parse(JSON.stringify(v2Workflow));\n            migrationLog.migration_steps.push('开始 V2 到 V3 格式迁移');\n            \n            // 标准化节点类型\n            const typeMapping = {\n                'start': 'start_node',\n                'end': 'end_node',\n                'process': 'data_processing_node',\n                'api': 'api_call_node'\n            };\n            \n            for (const [nodeId, node] of Object.entries(v3Workflow.nodes)) {\n                if (typeMapping[node.type]) {\n                    const oldType = node.type;\n                    node.type = typeMapping[node.type];\n                    migrationLog.migration_steps.push(`节点 ${nodeId}: 标准化类型 ${oldType} -> ${node.type}`);\n                }\n                \n                // 确保端口配置存在\n                if (!node.input_ports) {\n                    node.input_ports = [{ id: 'input', type: 'any', name: '输入' }];\n                }\n                if (!node.output_ports) {\n                    node.output_ports = [{ id: 'output', type: 'any', name: '输出' }];\n                }\n            }\n            \n            // 更新元数据\n            v3Workflow.version = '3.0';\n            v3Workflow.metadata.migrated_from = '2.0';\n            v3Workflow.metadata.standardized_types = true;\n            \n            migrationLog.migration_steps.push('V2 到 V3 格式迁移完成');\n            return v3Workflow;\n        } catch (error) {\n            throw new CozePluginError(`V2到V3格式迁移失败: ${error.message}`);\n        }\n    }\n\n    _migrateToCurrentFormat(workflow, migrationLog) {\n        try {\n            const currentFormat = JSON.parse(JSON.stringify(workflow));\n            migrationLog.migration_steps.push('迁移到当前格式');\n            \n            // 确保工作流包含所有必需字段\n            if (!currentFormat.metadata) {\n                currentFormat.metadata = {};\n            }\n            \n            currentFormat.metadata.version = '3.0';\n            currentFormat.metadata.last_migrated = new Date().toISOString();\n            currentFormat.metadata.migration_agent = 'coze_workflow_agent';\n            \n            // 确保所有节点有完整配置\n            for (const [nodeId, node] of Object.entries(currentFormat.nodes)) {\n                if (!node.parameters) node.parameters = {};\n                if (!node.position) node.position = { x: 100, y: 100 };\n                if (!node.status) node.status = 'active';\n                if (!node.input_ports) node.input_ports = [{ id: 'input', type: 'any', name: '输入' }];\n                if (!node.output_ports) node.output_ports = [{ id: 'output', type: 'any', name: '输出' }];\n            }\n            \n            migrationLog.migration_steps.push('当前格式迁移完成');\n            return currentFormat;\n        } catch (error) {\n            throw new CozePluginError(`迁移到当前格式失败: ${error.message}`);\n        }\n    }\n\n    _updateDeprecatedParameters(workflow, migrationLog) {\n        try {\n            const updated = JSON.parse(JSON.stringify(workflow));\n            let updateCount = 0;\n            \n            for (const [nodeId, node] of Object.entries(updated.nodes)) {\n                if (node.parameters) {\n                    for (const [oldParam, newParam] of Object.entries(this.deprecatedMap)) {\n                        if (node.parameters.hasOwnProperty(oldParam)) {\n                            const oldValue = node.parameters[oldParam];\n                            node.parameters[newParam] = oldValue;\n                            delete node.parameters[oldParam];\n                            \n                            migrationLog.migration_steps.push(\n                                `节点 ${nodeId}: 更新参数 ${oldParam} -> ${newParam}`\n                            );\n                            updateCount++;\n                        }\n                    }\n                }\n            }\n            \n            if (updateCount > 0) {\n                migrationLog.migration_steps.push(`共更新 ${updateCount} 个过时参数`);\n            }\n            \n            return updated;\n        } catch (error) {\n            throw new ParameterValidationError(`更新过时参数失败: ${error.message}`);\n        }\n    }\n\n    _applyCompatibilityFixes(workflow, migrationLog) {\n        try {\n            const fixed = JSON.parse(JSON.stringify(workflow));\n            let fixCount = 0;\n            \n            // 确保所有节点都有必需的字段\n            for (const [nodeId, node] of Object.entries(fixed.nodes)) {\n                if (!node.status) {\n                    node.status = 'active';\n                    fixCount++;\n                }\n                if (!node.version) {\n                    node.version = '1.0';\n                    fixCount++;\n                }\n                if (!node.created_at) {\n                    node.created_at = new Date().toISOString();\n                    fixCount++;\n                }\n            }\n            \n            // 确保连接有唯一标识\n            fixed.connections.forEach((conn, index) => {\n                if (!conn.id) {\n                    conn.id = `conn_${index}_${Date.now()}`;\n                    fixCount++;\n                }\n            });\n            \n            if (fixCount > 0) {\n                migrationLog.migration_steps.push(`应用了 ${fixCount} 个兼容性修复`);\n            }\n            \n            return fixed;\n        } catch (error) {\n            throw new CozePluginError(`应用兼容性修复失败: ${error.message}`);\n        }\n    }\n}\n\nclass CozeWorkflowAutomationPlugin {\n    constructor() {\n        try {\n            this.nlpProcessor = new NLPProcessor();\n            this.workflowGenerator = new WorkflowGenerator();\n            this.errorDetector = new ComprehensiveErrorDetector();\n            this.parameterFixer = new ComprehensiveParameterFixer();\n            this.legacyFixer = new LegacyWorkflowFixer();\n            this.pluginVersion = '1.0.0';\n        } catch (error) {\n            throw new CozePluginError(`插件初始化失败: ${error.message}`);\n        }\n    }\n\n    main(params) {\n        try {\n            // 验证输入参数\n            this._validateInputParams(params);\n            \n            const userInput = params.user_input || '';\n            const existingWorkflow = params.existing_workflow;\n            const isLegacy = params.is_legacy || false;\n            const options = params.options || {};\n            \n            // 处理用户请求\n            const result = this.processUserRequest(userInput, existingWorkflow, isLegacy, options);\n            \n            return {\n                status: 'success',\n                data: result,\n                message: '工作流处理完成',\n                metadata: {\n                    plugin_version: this.pluginVersion,\n                    processing_time: new Date().toISOString(),\n                    input_length: userInput.length\n                }\n            };\n        } catch (error) {\n            if (error instanceof CozePluginError) {\n                return {\n                    status: 'error',\n                    error_type: 'plugin_error',\n                    message: `插件执行错误: ${error.message}`,\n                    metadata: {\n                        plugin_version: this.pluginVersion,\n                        error_timestamp: new Date().toISOString()\n                    }\n                };\n            } else {\n                return {\n                    status: 'error',\n                    error_type: 'unexpected_error',\n                    message: `未预期错误: ${error.message}`,\n                    metadata: {\n                        plugin_version: this.pluginVersion,\n                        error_timestamp: new Date().toISOString()\n                    }\n                };\n            }\n        }\n    }\n\n    _validateInputParams(params) {\n        try {\n            if (!params || typeof params !== 'object') {\n                throw new Error('输入参数不能为空');\n            }\n            \n            if (!params.hasOwnProperty('user_input')) {\n                throw new Error('缺少必要的 user_input 参数');\n            }\n            \n            if (typeof params.user_input !== 'string') {\n                throw new Error('user_input 必须是字符串类型');\n            }\n            \n            if (params.user_input.trim().length === 0) {\n                throw new Error('user_input 不能为空字符串');\n            }\n            \n            // 验证可选参数\n            if (params.existing_workflow && typeof params.existing_workflow !== 'object') {\n                throw new Error('existing_workflow 必须是对象类型');\n            }\n            \n            if (params.is_legacy && typeof params.is_legacy !== 'boolean') {\n                throw new Error('is_legacy 必须是布尔类型');\n            }\n        } catch (error) {\n            throw new CozePluginError(`参数验证失败: ${error.message}`);\n        }\n    }\n\n    processUserRequest(userInput, existingWorkflow, isLegacy, options) {\n        try {\n            // 解析用户意图\n            const parsedIntent = this.nlpProcessor.parseWorkflowIntent(userInput);\n            \n            // 判断操作类型\n            if (this._isCreationRequest(parsedIntent) || !existingWorkflow) {\n                return this._createNewWorkflow(parsedIntent, options);\n            } else {\n                return this._repairExistingWorkflow(parsedIntent, existingWorkflow, isLegacy, options);\n            }\n        } catch (error) {\n            throw new CozePluginError(`处理用户请求失败: ${error.message}`);\n        }\n    }\n\n    _isCreationRequest(parsedIntent) {\n        try {\n            const actionType = parsedIntent.actionType || 'auto_detect';\n            return actionType === 'create';\n        } catch (error) {\n            throw new CozePluginError(`判断请求类型失败: ${error.message}`);\n        }\n    }\n\n    _createNewWorkflow(parsedIntent, options) {\n        try {\n            // 生成基础工作流\n            const newWorkflow = this.workflowGenerator.createWorkflowFromDescription(parsedIntent);\n            \n            // 全面检查并修复\n            const auditReport = this.errorDetector.fullWorkflowAudit(newWorkflow);\n            const finalWorkflow = this.parameterFixer.fullParameterRepair(newWorkflow, auditReport);\n            \n            // 最终验证\n            const finalAudit = this.errorDetector.fullWorkflowAudit(finalWorkflow);\n            \n            return {\n                action: 'created',\n                workflow: finalWorkflow,\n                audit_report: auditReport,\n                final_audit: finalAudit,\n                fixes_applied: auditReport.summary.totalErrors > 0,\n                success_metrics: {\n                    original_errors: auditReport.summary.totalErrors,\n                    remaining_errors: finalAudit.summary.totalErrors,\n                    repair_success_rate: this._calculateSuccessRate(auditReport.summary, finalAudit.summary)\n                }\n            };\n        } catch (error) {\n            throw new CozePluginError(`创建新工作流失败: ${error.message}`);\n        }\n    }\n\n    _repairExistingWorkflow(parsedIntent, existingWorkflow, isLegacy, options) {\n        try {\n            if (!existingWorkflow) {\n                throw new Error('修复操作需要提供现有工作流');\n            }\n            \n            // 记录原始状态\n            const originalAudit = this.errorDetector.fullWorkflowAudit(existingWorkflow);\n            \n            // 如果是老旧工作流，先进行专门修复\n            let workflowToRepair = existingWorkflow;\n            if (isLegacy) {\n                workflowToRepair = this.legacyFixer.repairLegacyWorkflow(existingWorkflow);\n            }\n            \n            // 全面检查\n            const auditReport = this.errorDetector.fullWorkflowAudit(workflowToRepair);\n            \n            // 自动化修复\n            const repairedWorkflow = this.parameterFixer.fullParameterRepair(workflowToRepair, auditReport);\n            \n            // 最终验证\n            const finalAudit = this.errorDetector.fullWorkflowAudit(repairedWorkflow);\n            \n            // 统计修复结果\n            const errorSummary = this._summarizeErrors(auditReport);\n            const remainingErrors = this._countRemainingErrors(finalAudit);\n            \n            return {\n                action: 'repaired',\n                original_workflow: existingWorkflow,\n                repaired_workflow: repairedWorkflow,\n                original_errors: errorSummary,\n                audit_report: auditReport,\n                final_audit: finalAudit,\n                remaining_errors: remainingErrors,\n                repair_success_rate: this._calculateSuccessRate(errorSummary, remainingErrors),\n                migration_applied: isLegacy\n            };\n        } catch (error) {\n            throw new CozePluginError(`修复工作流失败: ${error.message}`);\n        }\n    }\n\n    _summarizeErrors(auditReport) {\n        try {\n            return auditReport.summary;\n        } catch (error) {\n            return {\n                total_errors: 0,\n                error_types: {},\n                severity: 'unknown',\n                error: `汇总错误统计失败: ${error.message}`\n            };\n        }\n    }\n\n    _countRemainingErrors(auditReport) {\n        try {\n            return auditReport.summary.totalErrors;\n        } catch (error) {\n            return 0;\n        }\n    }\n\n    _calculateSuccessRate(originalSummary, finalSummary) {\n        try {\n            const totalErrors = originalSummary.total_errors || 0;\n            const remainingErrors = typeof finalSummary === 'number' ? finalSummary : (finalSummary.total_errors || 0);\n            \n            if (totalErrors === 0) {\n                return 100.0;\n            }\n            \n            const successRate = ((totalErrors - remainingErrors) / totalErrors) * 100;\n            return Math.round(successRate * 100) / 100; // 保留两位小数\n        } catch (error) {\n            return 0;\n        }\n    }\n}\n\n// Coze IDE 插件标准入口点\nfunction main(params) {\n    try {\n        const plugin = new CozeWorkflowAutomationPlugin();\n        return plugin.main(params);\n    } catch (error) {\n        return {\n            status: 'error',\n            error_type: 'plugin_initialization_failed',\n            message: `插件初始化失败: ${error.message}`,\n            metadata: {\n                error_timestamp: new Date().toISOString(),\n                stack_trace: error.stack\n            }\n        };\n    }\n}\n\n// 导出主函数供 Coze IDE 调用\nif (typeof module !== 'undefined' && module.exports) {\n    module.exports = main;\n}\n\n// 测试代码（在 Coze IDE 中不会执行）\nif (typeof require !== 'undefined' && require.main === module) {\n    try {\n        // 测试用例\n        const testCases = [\n            {\n                name: '创建新工作流测试',\n                params: {\n                    user_input: '创建一个工作流，包含节点A（开始）、节点B（数据处理）、节点C（结束）。连接A到B，B到C。',\n                    existing_workflow: null,\n                    is_legacy: false\n                }\n            },\n            {\n                name: '修复工作流测试',\n                params: {\n                    user_input: '修复这个工作流，节点B没有连接，参数缺失',\n                    existing_workflow: {\n                        nodes: {\n                            A: { type: 'start_node', parameters: {} },\n                            B: { type: 'data_processing_node', parameters: {} },\n                            C: { type: 'end_node', parameters: {} }\n                        },\n                        connections: [\n                            { source: 'A', targe